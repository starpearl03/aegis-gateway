{% extends 'base.jinja2' %}

{% set person = criminal if criminal else {} %}
{% set person_images = images if images else [] %}
{% set person_crimes = crimes if crimes else [] %}

{% block title %}{{ person.first_name }} {{ person.last_name }} | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   PAGE LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    height: 100%;
    overflow-y: auto;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   PROFILE HEADER - TRANSPARENT
   =========================== */
.profile-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    position: relative;
    overflow: hidden;
}

.profile-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.profile-content {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    position: relative;
    z-index: 1;
}

.profile-avatar-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
}

.profile-avatar {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.15));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 64px;
    color: var(--warning);
    font-weight: 700;
    border: 2px solid var(--border);
    box-shadow: var(--shadow-lg);
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
}

.profile-actions {
    display: flex;
    gap: 8px;
}

.profile-info {
    flex: 1;
    min-width: 0;
}

.profile-name {
    font-size: 36px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: -0.5px;
}

.profile-alias {
    font-size: 18px;
    color: var(--primary-gold);
    font-style: italic;
    margin-bottom: 16px;
}

.profile-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
}

.badge {
    padding: 8px 16px;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.badge.wanted {
    background: var(--error-bg);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.badge.not-wanted {
    background: var(--success-bg);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge.priority {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.badge.threat {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.badge.gang {
    background: rgba(139, 92, 246, 0.15);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.3);
}

.profile-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
}

.meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.meta-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.meta-value {
    font-size: 15px;
    color: var(--text-primary);
    font-weight: 500;
}

/* ===========================
   CONTENT GRID
   =========================== */
.content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}

.content-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.content-section.full-width {
    grid-column: 1 / -1;
}

.section-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
}

.section-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-title i {
    color: var(--warning);
    font-size: 20px;
}

.section-body {
    padding: 24px;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.info-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1.5;
}

.description-text {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    padding: 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
}

/* ===========================
   IMAGE GALLERY
   =========================== */
.image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 16px;
}

.gallery-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: var(--transition);
}

.gallery-item:hover {
    transform: translateY(-4px);
    border-color: var(--warning);
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.primary-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    background: rgba(245, 158, 11, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.no-images {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-muted);
    font-size: 14px;
}

.no-images i {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
}

/* ===========================
   CRIMES LIST
   =========================== */
.crimes-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.crime-card {
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
}

.crime-card:hover {
    border-color: var(--warning);
    transform: translateX(4px);
}

.crime-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.crime-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.crime-case {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: monospace;
}

.crime-status {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.crime-status.open {
    background: var(--error-bg);
    color: var(--error);
}

.crime-status.under-investigation {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
}

.crime-status.closed {
    background: var(--success-bg);
    color: var(--success);
}

.crime-body {
    padding: 20px;
}

.crime-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.crime-description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
}

.crime-sections {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.crime-section {
    padding: 12px;
    background: rgba(10, 14, 39, 0.3);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
}

.crime-section-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

.crime-section-content {
    font-size: 13px;
    color: var(--text-primary);
}

.crime-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.crime-list-item {
    font-size: 13px;
    color: var(--text-secondary);
    padding-left: 16px;
    position: relative;
}

.crime-list-item::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--warning);
    font-weight: 700;
}

.no-crimes {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}

.no-crimes i {
    font-size: 56px;
    margin-bottom: 16px;
    opacity: 0.5;
}

.no-crimes h3 {
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 8px;
    font-weight: 600;
}

.no-crimes p {
    font-size: 14px;
    margin-bottom: 20px;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 10px 20px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--warning), #d97706);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--warning);
}

.btn-sm {
    padding: 8px 16px;
    font-size: 13px;
}

.btn-sm i {
    font-size: 14px;
}

.btn-danger {
    background: var(--error-bg);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.btn-danger:hover {
    background: var(--error);
    color: white;
    border-color: var(--error);
}

/* ===========================
   ACTION BUTTONS
   =========================== */
.action-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 1200px) {
    .content-grid {
        grid-template-columns: 1fr;
    }

    .content-section {
        grid-column: 1;
    }
}

@media (max-width: 768px) {
    .profile-content {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-avatar-section {
        width: 100%;
    }

    .profile-avatar {
        width: 150px;
        height: 150px;
        font-size: 56px;
    }

    .profile-name {
        font-size: 28px;
    }

    .profile-badges {
        justify-content: center;
    }

    .profile-meta {
        grid-template-columns: 1fr;
    }

    .profile-actions {
        width: 100%;
        flex-direction: column;
    }

    .action-buttons {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    .crime-info {
        grid-template-columns: 1fr;
    }

    .image-gallery {
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <a href="{{ url_for('criminal.list_criminals') }}" class="breadcrumb-item">
            <span>Criminals</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>{{ person.first_name }} {{ person.last_name }}</span>
        </span>
    </div>

    <!-- Profile Header -->
    <div class="profile-header">
        <div class="profile-content">
            <div class="profile-avatar-section">
                <div class="profile-avatar">
                    {% if person_images and person_images|length > 0 %}
                        {% set primary_image = person_images|selectattr('is_primary', 'equalto', true)|first %}
                        {% if primary_image %}
                            <img src="{{ url_for('uploads', filename=primary_image.image_path|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                        {% else %}
                            <img src="{{ url_for('uploads', filename=person_images[0].image_path|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                        {% endif %}
                    {% else %}
                        {{ person.first_name[0] }}{{ person.last_name[0] }}
                    {% endif %}
                </div>
                <div class="profile-actions">
                    <a href="{{ url_for('criminal.criminal_form', criminal_id=person.id) }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit"></i>
                        Edit Profile
                    </a>
                </div>
            </div>

            <div class="profile-info">
                <h1 class="profile-name">{{ person.first_name }} {{ person.last_name }}</h1>
                {% if person.alias %}
                <div class="profile-alias">"{{ person.alias }}"</div>
                {% endif %}

                <div class="profile-badges">
                    <span class="badge {{ 'wanted' if person.is_wanted else 'not-wanted' }}">
                        <i class="fas fa-{{ 'exclamation-triangle' if person.is_wanted else 'check-circle' }}"></i>
                        {{ 'WANTED' if person.is_wanted else 'NOT WANTED' }}
                    </span>
                    {% if person.priority_level %}
                    <span class="badge priority">
                        <i class="fas fa-star"></i>
                        Priority {{ person.priority_level }}
                    </span>
                    {% endif %}
                    {% if person.threat_level %}
                    <span class="badge threat">
                        <i class="fas fa-shield-alt"></i>
                        {{ person.threat_level }} Threat
                    </span>
                    {% endif %}
                    {% if person.gang_affiliation %}
                    <span class="badge gang">
                        <i class="fas fa-users"></i>
                        {{ person.gang_affiliation }}
                    </span>
                    {% endif %}
                </div>

                <div class="profile-meta">
                    {% if person.national_id %}
                    <div class="meta-item">
                        <div class="meta-label">National ID</div>
                        <div class="meta-value">{{ person.national_id }}</div>
                    </div>
                    {% endif %}
                    {% if person.date_of_birth %}
                    <div class="meta-item">
                        <div class="meta-label">Date of Birth</div>
                        <div class="meta-value">{{ person.date_of_birth }}</div>
                    </div>
                    {% endif %}
                    {% if person.gender %}
                    <div class="meta-item">
                        <div class="meta-label">Gender</div>
                        <div class="meta-value">{{ person.gender }}</div>
                    </div>
                    {% endif %}
                    {% if person.phone_number %}
                    <div class="meta-item">
                        <div class="meta-label">Phone</div>
                        <div class="meta-value">{{ person.phone_number }}</div>
                    </div>
                    {% endif %}
                    {% if person.email %}
                    <div class="meta-item">
                        <div class="meta-label">Email</div>
                        <div class="meta-value">{{ person.email }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
        <!-- Personal Information -->
        <div class="content-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-user"></i>
                    Personal Information
                </h2>
            </div>
            <div class="section-body">
                <div class="info-grid">
                    {% if person.height %}
                    <div class="info-item">
                        <div class="info-label">Height</div>
                        <div class="info-value">{{ person.height }} cm</div>
                    </div>
                    {% endif %}
                    {% if person.weight %}
                    <div class="info-item">
                        <div class="info-label">Weight</div>
                        <div class="info-value">{{ person.weight }} kg</div>
                    </div>
                    {% endif %}
                    {% if person.hair_color %}
                    <div class="info-item">
                        <div class="info-label">Hair Color</div>
                        <div class="info-value">{{ person.hair_color }}</div>
                    </div>
                    {% endif %}
                    {% if person.eye_color %}
                    <div class="info-item">
                        <div class="info-label">Eye Color</div>
                        <div class="info-value">{{ person.eye_color }}</div>
                    </div>
                    {% endif %}
                    {% if person.skin_tone %}
                    <div class="info-item">
                        <div class="info-label">Skin Tone</div>
                        <div class="info-value">{{ person.skin_tone }}</div>
                    </div>
                    {% endif %}
                </div>

                {% if person.distinctive_features %}
                <div style="margin-top: 20px;">
                    <div class="info-label" style="margin-bottom: 8px;">Distinctive Features</div>
                    <div class="description-text">{{ person.distinctive_features }}</div>
                </div>
                {% endif %}

                {% if person.description %}
                <div style="margin-top: 20px;">
                    <div class="info-label" style="margin-bottom: 8px;">Description</div>
                    <div class="description-text">{{ person.description }}</div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Photos -->
        <div class="content-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-images"></i>
                    Photos ({{ person_images|length }})
                </h2>
            </div>
            <div class="section-body">
                {% if person_images and person_images|length > 0 %}
                <div class="image-gallery">
                    {% for image in person_images %}
                    <div class="gallery-item">
                         <img src="{{ url_for('uploads', filename=image.image_path|image_url) }}" alt="Photo {{ loop.index }}">
                        {% if image.is_primary %}
                        <div class="primary-badge">Primary</div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="no-images">
                    <i class="fas fa-image"></i>
                    <p>No photos available</p>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Criminal Record -->
        <div class="content-section full-width">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-gavel"></i>
                    Criminal Record ({{ person_crimes|length }} Crime{{ 's' if person_crimes|length != 1 else '' }})
                </h2>
                <a href="{{ url_for('criminal.add_crime_to_criminal_form', criminal_id=person.id) }}" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i>
                    Add Crime
                </a>
            </div>
            <div class="section-body">
                {% if person_crimes and person_crimes|length > 0 %}
                <div class="crimes-list">
                    {% for crime in person_crimes %}
                    <div class="crime-card" data-crime-id="{{ crime.id }}" style="cursor: pointer;">
                        <div class="crime-header">
                            <div>
                                <div class="crime-title">
                                    <i class="fas fa-file-alt"></i>
                                    {{ crime.crime_type }}
                                </div>
                                <div class="crime-case">Case #{{ crime.case_number }}</div>
                            </div>
                            <span class="crime-status {{ crime.status|lower|replace('_', '-') }}">
                                {{ crime.status|replace('_', ' ') }}
                            </span>
                        </div>
                        <div class="crime-body">
                            <div class="crime-info">
                                <div class="info-item">
                                    <div class="info-label">Date Committed</div>
                                    <div class="info-value">{{ crime.date_committed[:10] if crime.date_committed else 'Unknown' }}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Date Reported</div>
                                    <div class="info-value">{{ crime.date_reported[:10] if crime.date_reported else 'Unknown' }}</div>
                                </div>
                                {% if crime.location and crime.location.city %}
                                <div class="info-item">
                                    <div class="info-label">Location</div>
                                    <div class="info-value">{{ crime.location.city }}, {{ crime.location.state if crime.location.state else '' }}</div>
                                </div>
                                {% endif %}
                            </div>

                            {% if crime.description %}
                            <div class="crime-description">{{ crime.description }}</div>
                            {% endif %}

                            <div class="crime-sections">
                                {% if crime.victims and crime.victims|length > 0 %}
                                <div class="crime-section">
                                    <div class="crime-section-title">
                                        <i class="fas fa-user-injured"></i>
                                        Victims ({{ crime.victims|length }})
                                    </div>
                                    <div class="crime-section-content">
                                        <div class="crime-list">
                                            {% for victim in crime.victims %}
                                            <div class="crime-list-item">
                                                Person ID: {{ victim.person_id }}
                                                {% if victim.injury_description %}- {{ victim.injury_description }}{% endif %}
                                            </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                                {% endif %}

                                {% if crime.punishments and crime.punishments|length > 0 %}
                                <div class="crime-section">
                                    <div class="crime-section-title">
                                        <i class="fas fa-balance-scale"></i>
                                        Punishments ({{ crime.punishments|length }})
                                    </div>
                                    <div class="crime-section-content">
                                        <div class="crime-list">
                                            {% for punishment in crime.punishments %}
                                            <div class="crime-list-item">
                                                {{ punishment.type|replace('_', ' ')|title }} - {{ punishment.status|replace('_', ' ')|title }}
                                                {% if punishment.amount %} - ${{ punishment.amount }}{% endif %}
                                                {% if punishment.duration %} - {{ punishment.duration }} days{% endif %}
                                            </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                                {% endif %}

                                {% if crime.evidence and crime.evidence|length > 0 %}
                                <div class="crime-section">
                                    <div class="crime-section-title">
                                        <i class="fas fa-folder-open"></i>
                                        Evidence ({{ crime.evidence|length }})
                                    </div>
                                    <div class="crime-section-content">
                                        <div class="crime-list">
                                            {% for evidence in crime.evidence %}
                                            <div class="crime-list-item">
                                                {{ evidence.type|replace('_', ' ')|title }} - {{ evidence.description[:50] }}{% if evidence.description|length > 50 %}...{% endif %}
                                            </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="no-crimes">
                    <i class="fas fa-gavel"></i>
                    <h3>No Criminal Record</h3>
                    <p>No crimes have been recorded for this individual yet.</p>
                    <a href="{{ url_for('criminal.add_crime_to_criminal_form', criminal_id=person.id) }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Add First Crime
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
        <a href="{{ url_for('criminal.criminal_form', criminal_id=person.id) }}" class="btn btn-secondary">
            <i class="fas fa-edit"></i>
            Edit Criminal Profile
        </a>
        <a href="{{ url_for('criminal.add_crime_to_criminal_form', criminal_id=person.id) }}" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Add New Crime
        </a>
        <a href="{{ url_for('criminal.list_criminals') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to List
        </a>
        <button onclick="deleteCriminal('{{ person.id }}', '{{ person.first_name }} {{ person.last_name }}')" class="btn btn-danger">
            <i class="fas fa-trash-alt"></i>
            Delete Record
        </button>
    </div>
</div>

<script>
    // Delete Criminal
    async function deleteCriminal(criminalId, criminalName) {
        if (!confirm(`Are you sure you want to delete the record for "${criminalName}"? This action cannot be undone and will also affect all associated crimes, punishments, and evidence.`)) {
            return;
        }

        try {
            const response = await fetch(`/criminals/${criminalId}/delete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.error) {
                if (window.toast) {
                    window.toast.error('Error', data.message || 'Failed to delete criminal record');
                }
            } else {
                if (window.toast) {
                    window.toast.success('Success', data.message || 'Criminal record deleted successfully');
                }
                setTimeout(() => {
                    window.location.href = '{{ url_for("criminal.list_criminals") }}';
                }, 1000);
            }
        } catch (error) {
            console.error('Error:', error);
            if (window.toast) {
                window.toast.error('Error', 'Failed to delete criminal record');
            }
        }
    }

    // Image gallery lightbox effect
    document.querySelectorAll('.gallery-item').forEach(item => {
        item.addEventListener('click', function() {
            const img = this.querySelector('img');
            if (img) {
                const overlay = document.createElement('div');
                overlay.style.cssText = `
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.9);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 10000;
                    cursor: pointer;
                `;

                const imgClone = document.createElement('img');
                imgClone.src = img.src;
                imgClone.style.cssText = `
                    max-width: 90%;
                    max-height: 90%;
                    border-radius: 12px;
                    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
                `;

                overlay.appendChild(imgClone);
                document.body.appendChild(overlay);

                overlay.addEventListener('click', function() {
                    document.body.removeChild(overlay);
                });
            }
        });
    });

    // Crime card click navigation
    document.querySelectorAll('.crime-card').forEach(card => {
        const crimeId = card.getAttribute('data-crime-id');
        if (crimeId) {
            card.addEventListener('click', function(e) {
                if (e.target.closest('button') || e.target.closest('a')) {
                    return;
                }
                window.location.href = `/criminals/crimes/${crimeId}`;
            });
        }
    });
</script>
{% endblock %}