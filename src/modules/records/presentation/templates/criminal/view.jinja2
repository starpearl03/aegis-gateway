{% extends 'base.jinja2' %}

{% set person = criminal if criminal else {} %}
{% set person_images = images if images else [] %}
{% set person_crimes = crimes if crimes else [] %}

{% block title %}{{ person.first_name }} {{ person.last_name }} | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   PAGE CONTAINER
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
    overflow-y: auto;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   HERO HEADER
   =========================== */
.hero-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    position: relative;
    overflow: hidden;
}

.hero-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.hero-content {
    display: flex;
    gap: 32px;
    align-items: center;
    position: relative;
    z-index: 1;
}

/* ===========================
   HERO AVATAR - UNIQUE NAMING
   =========================== */
.hero-avatar-section {
    flex-shrink: 0;
}

.hero-avatar-wrapper {
    width: 220px;
    height: 220px;
    position: relative;
}

.hero-avatar-box {
    width: 220px;
    height: 220px;
    border-radius: var(--radius-lg);
    border: 3px solid var(--border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.15));
    transition: var(--transition);
}

.hero-avatar-box:hover {
    border-color: var(--warning);
    transform: scale(1.02);
}

.hero-avatar-image {
    width: 220px;
    height: 220px;
    display: block;
    object-fit: cover;
    object-position: center;
}

.hero-avatar-initials {
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72px;
    font-weight: 700;
    color: var(--warning);
}

.hero-status-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
    z-index: 2;
}

.hero-status-badge.wanted {
    background: rgba(239, 68, 68, 0.9);
    color: white;
}

.hero-status-badge.not-wanted {
    background: rgba(16, 185, 129, 0.9);
    color: white;
}

/* ===========================
   HERO INFO SECTION
   =========================== */
.hero-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
}

.person-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.person-name {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.5px;
    line-height: 1.1;
}

.person-alias {
    font-size: 16px;
    color: var(--primary-gold);
    font-style: italic;
    margin: 0;
}

.title-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.info-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    background: rgba(10, 14, 39, 0.4);
    color: var(--text-secondary);
    border: 1px solid var(--border);
}

.info-badge i {
    font-size: 10px;
    color: var(--warning);
}

/* ===========================
   STATS GRID
   =========================== */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
}

.stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    background: rgba(10, 14, 39, 0.3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    transition: var(--transition);
}

.stat-item:hover {
    border-color: var(--warning);
    transform: translateY(-2px);
}

.stat-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
}

/* ===========================
   ACTION BUTTONS
   =========================== */
.action-group {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.btn {
    padding: 10px 18px;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    justify-content: center;
}

.btn i {
    font-size: 13px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--warning), #d97706);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--warning);
}

.btn-success {
    background: linear-gradient(135deg, var(--success), #059669);
    color: white;
}

.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-danger {
    background: transparent;
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.btn-danger:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: var(--error);
}

/* ===========================
   CONTENT GRID
   =========================== */
.content-grid {
    display: flex;
    gap: 24px;
}

.content-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
    min-width: 0;
}

.content-column-wide {
    flex: 2;
    min-width: 0;
}

.content-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
}

.content-section:hover {
    border-color: var(--warning);
}

.section-header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    flex-shrink: 0;
}

.section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}

.section-title i {
    color: var(--warning);
    font-size: 18px;
}

.section-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
}

/* ===========================
   INFO GRIDS
   =========================== */
.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.info-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1.5;
}

.description-text {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    padding: 14px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
}

/* ===========================
   IMAGE GALLERY
   =========================== */
.gallery-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
}

.image-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.gallery-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: var(--transition);
}

.gallery-item:hover {
    transform: translateY(-4px);
    border-color: var(--warning);
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.primary-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    background: rgba(245, 158, 11, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 6px;
    font-size: 9px;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.gallery-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    margin-top: auto;
}

.pagination-btn {
    padding: 8px 12px;
    background: rgba(10, 14, 39, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    cursor: pointer;
    transition: var(--transition);
    font-size: 12px;
    font-weight: 600;
}

.pagination-btn:hover:not(:disabled) {
    background: rgba(245, 158, 11, 0.1);
    border-color: var(--warning);
    color: var(--warning);
}

.pagination-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.pagination-info {
    font-size: 12px;
    color: var(--text-secondary);
    font-weight: 500;
}

.no-images {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-muted);
    font-size: 14px;
}

.no-images i {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
}

/* ===========================
   CRIMES LIST
   =========================== */
.crimes-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.crime-card {
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
}

.crime-card:hover {
    border-color: var(--warning);
    transform: translateX(4px);
}

.crime-header {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.crime-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.crime-case {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: monospace;
}

.crime-status {
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.crime-status.open {
    background: var(--error-bg);
    color: var(--error);
}

.crime-status.under-investigation {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
}

.crime-status.closed {
    background: var(--success-bg);
    color: var(--success);
}

.crime-body {
    padding: 18px;
}

.crime-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    margin-bottom: 14px;
}

.crime-description {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 14px;
}

.crime-sections {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.crime-section {
    padding: 10px;
    background: rgba(10, 14, 39, 0.3);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
}

.crime-section-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

.crime-section-content {
    font-size: 12px;
    color: var(--text-primary);
}

.crime-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.crime-list-item {
    font-size: 12px;
    color: var(--text-secondary);
    padding-left: 16px;
    position: relative;
}

.crime-list-item::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--warning);
    font-weight: 700;
}

.no-crimes {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}

.no-crimes i {
    font-size: 56px;
    margin-bottom: 16px;
    opacity: 0.5;
}

.no-crimes h3 {
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 8px;
    font-weight: 600;
}

.no-crimes p {
    font-size: 14px;
    margin-bottom: 20px;
}

/* ===========================
   BOTTOM ACTIONS
   =========================== */
.action-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 12px;
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 1200px) {
    .content-grid {
        flex-direction: column;
    }

    .content-column,
    .content-column-wide {
        flex: 1;
    }
}

@media (max-width: 768px) {
    .hero-content {
        flex-direction: column;
        text-align: center;
    }

    .hero-avatar-wrapper,
    .hero-avatar-box,
    .hero-avatar-image,
    .hero-avatar-initials {
        width: 180px;
        height: 180px;
    }

    .hero-avatar-initials {
        font-size: 60px;
    }

    .person-name {
        font-size: 26px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .image-gallery {
        grid-template-columns: repeat(2, 1fr);
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    .crime-info {
        grid-template-columns: 1fr;
    }

    .action-buttons {
        flex-direction: column;
    }

    .action-buttons .btn {
        width: 100%;
    }
}

@media (max-width: 480px) {
    .hero-avatar-wrapper,
    .hero-avatar-box,
    .hero-avatar-image,
    .hero-avatar-initials {
        width: 160px;
        height: 160px;
    }

    .hero-avatar-initials {
        font-size: 52px;
    }

    .person-name {
        font-size: 22px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <a href="{{ url_for('criminal.list_criminals') }}" class="breadcrumb-item">
            <span>Criminals</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>{{ person.first_name }} {{ person.last_name }}</span>
        </span>
    </div>

    <!-- Hero Header -->
    <div class="hero-header">
        <div class="hero-content">
            <!-- Hero Avatar -->
            <div class="hero-avatar-section">
                <div class="hero-avatar-wrapper">
                    <div class="hero-avatar-box">
                        {% if person_images and person_images|length > 0 %}
                            {% set primary_image = person_images|selectattr('is_primary', 'equalto', true)|first %}
                            {% if primary_image %}
                                <img class="hero-avatar-image" src="{{ url_for('uploads', filename=primary_image.image_path|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                            {% else %}
                                <img class="hero-avatar-image" src="{{ url_for('uploads', filename=person_images[0].image_path|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                            {% endif %}
                        {% else %}
                            <div class="hero-avatar-initials">{{ person.first_name[0] }}{{ person.last_name[0] }}</div>
                        {% endif %}
                    </div>
                    <span class="hero-status-badge {{ 'wanted' if person.is_wanted else 'not-wanted' }}">
                        {{ 'WANTED' if person.is_wanted else 'NOT WANTED' }}
                    </span>
                </div>
            </div>

            <!-- Hero Info -->
            <div class="hero-info">
                <div class="person-header">
                    <h1 class="person-name">{{ person.first_name }} {{ person.last_name }}</h1>
                    {% if person.alias %}
                    <div class="person-alias">"{{ person.alias }}"</div>
                    {% endif %}

                    <div class="title-badges">
                        {% if person.priority_level %}
                        <span class="info-badge">
                            <i class="fas fa-star"></i>
                            Priority {{ person.priority_level }}
                        </span>
                        {% endif %}
                        {% if person.threat_level %}
                        <span class="info-badge">
                            <i class="fas fa-shield-alt"></i>
                            {{ person.threat_level }} Threat
                        </span>
                        {% endif %}
                        {% if person.gang_affiliation %}
                        <span class="info-badge">
                            <i class="fas fa-users"></i>
                            {{ person.gang_affiliation }}
                        </span>
                        {% endif %}
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid">
                    {% if person.national_id %}
                    <div class="stat-item">
                        <div class="stat-label">National ID</div>
                        <div class="stat-value">{{ person.national_id }}</div>
                    </div>
                    {% endif %}

                    {% if person.date_of_birth %}
                    <div class="stat-item">
                        <div class="stat-label">Date of Birth</div>
                        <div class="stat-value">{{ person.date_of_birth }}</div>
                    </div>
                    {% endif %}

                    {% if person.gender %}
                    <div class="stat-item">
                        <div class="stat-label">Gender</div>
                        <div class="stat-value">{{ person.gender }}</div>
                    </div>
                    {% endif %}

                    {% if person.phone_number %}
                    <div class="stat-item">
                        <div class="stat-label">Phone</div>
                        <div class="stat-value">{{ person.phone_number }}</div>
                    </div>
                    {% endif %}

                    {% if person.height %}
                    <div class="stat-item">
                        <div class="stat-label">Height</div>
                        <div class="stat-value">{{ person.height }} cm</div>
                    </div>
                    {% endif %}

                    {% if person.weight %}
                    <div class="stat-item">
                        <div class="stat-label">Weight</div>
                        <div class="stat-value">{{ person.weight }} kg</div>
                    </div>
                    {% endif %}
                </div>

                <!-- Action Buttons -->
                <div class="action-group">
                    <a href="{{ url_for('criminal.criminal_form', criminal_id=person.id) }}" class="btn btn-secondary">
                        <i class="fas fa-edit"></i>
                        Edit
                    </a>
                    <button class="btn btn-primary" onclick="window.print()">
                        <i class="fas fa-print"></i>
                        Print
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
        <!-- Left Column -->
        <div class="content-column">
            <!-- Personal Information -->
            <div class="content-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-user"></i>
                        Personal Information
                    </h2>
                </div>
                <div class="section-body">
                    <div class="info-grid">
                        {% if person.height %}
                        <div class="info-item">
                            <div class="info-label">Height</div>
                            <div class="info-value">{{ person.height }} cm</div>
                        </div>
                        {% endif %}
                        {% if person.weight %}
                        <div class="info-item">
                            <div class="info-label">Weight</div>
                            <div class="info-value">{{ person.weight }} kg</div>
                        </div>
                        {% endif %}
                        {% if person.hair_color %}
                        <div class="info-item">
                            <div class="info-label">Hair Color</div>
                            <div class="info-value">{{ person.hair_color }}</div>
                        </div>
                        {% endif %}
                        {% if person.eye_color %}
                        <div class="info-item">
                            <div class="info-label">Eye Color</div>
                            <div class="info-value">{{ person.eye_color }}</div>
                        </div>
                        {% endif %}
                        {% if person.skin_tone %}
                        <div class="info-item">
                            <div class="info-label">Skin Tone</div>
                            <div class="info-value">{{ person.skin_tone }}</div>
                        </div>
                        {% endif %}
                    </div>

                    {% if person.distinctive_features %}
                    <div style="margin-top: 16px;">
                        <div class="info-label" style="margin-bottom: 8px;">Distinctive Features</div>
                        <div class="description-text">{{ person.distinctive_features }}</div>
                    </div>
                    {% endif %}

                    {% if person.description %}
                    <div style="margin-top: 16px;">
                        <div class="info-label" style="margin-bottom: 8px;">Description</div>
                        <div class="description-text">{{ person.description }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Photos -->
            <div class="content-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-images"></i>
                        Photos (<span id="totalImages">{{ person_images|length }}</span>)
                    </h2>
                </div>
                <div class="section-body">
                    {% if person_images and person_images|length > 0 %}
                    <div class="gallery-container">
                        <div class="image-gallery" id="imageGallery">
                            <!-- Populated by JavaScript -->
                        </div>
                        <div class="gallery-pagination" id="galleryPagination">
                            <button class="pagination-btn" id="prevBtn" onclick="changePage(-1)">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <span class="pagination-info" id="pageInfo">Page 1 of 1</span>
                            <button class="pagination-btn" id="nextBtn" onclick="changePage(1)">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    {% else %}
                    <div class="no-images">
                        <i class="fas fa-image"></i>
                        <p>No photos available</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="content-column-wide">
            <div class="content-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-gavel"></i>
                        Criminal Record ({{ person_crimes|length }} Crime{{ 's' if person_crimes|length != 1 else '' }})
                    </h2>
                    <a href="{{ url_for('criminal.add_crime_to_criminal_form', criminal_id=person.id) }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i>
                        Add Crime
                    </a>
                </div>
                <div class="section-body">
                    {% if person_crimes and person_crimes|length > 0 %}
                    <div class="crimes-list">
                        {% for crime in person_crimes %}
                        <div class="crime-card" data-crime-id="{{ crime.id }}" style="cursor: pointer;">
                            <div class="crime-header">
                                <div>
                                    <div class="crime-title">
                                        <i class="fas fa-file-alt"></i>
                                        {{ crime.crime_type }}
                                    </div>
                                    <div class="crime-case">Case #{{ crime.case_number }}</div>
                                </div>
                                <span class="crime-status {{ crime.status|lower|replace('_', '-') }}">
                                    {{ crime.status|replace('_', ' ') }}
                                </span>
                            </div>
                            <div class="crime-body">
                                <div class="crime-info">
                                    <div class="info-item">
                                        <div class="info-label">Date Committed</div>
                                        <div class="info-value">{{ crime.date_committed[:10] if crime.date_committed else 'Unknown' }}</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Date Reported</div>
                                        <div class="info-value">{{ crime.date_reported[:10] if crime.date_reported else 'Unknown' }}</div>
                                    </div>
                                    {% if crime.location and crime.location.city %}
                                    <div class="info-item">
                                        <div class="info-label">Location</div>
                                        <div class="info-value">{{ crime.location.city }}, {{ crime.location.state if crime.location.state else '' }}</div>
                                    </div>
                                    {% endif %}
                                </div>

                                {% if crime.description %}
                                <div class="crime-description">{{ crime.description }}</div>
                                {% endif %}

                                <div class="crime-sections">
                                    {% if crime.victims and crime.victims|length > 0 %}
                                    <div class="crime-section">
                                        <div class="crime-section-title">
                                            <i class="fas fa-user-injured"></i>
                                            Victims ({{ crime.victims|length }})
                                        </div>
                                        <div class="crime-section-content">
                                            <div class="crime-list">
                                                {% for victim in crime.victims %}
                                                <div class="crime-list-item">
                                                    Person ID: {{ victim.person_id }}
                                                    {% if victim.injury_description %}- {{ victim.injury_description }}{% endif %}
                                                </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}

                                    {% if crime.punishments and crime.punishments|length > 0 %}
                                    <div class="crime-section">
                                        <div class="crime-section-title">
                                            <i class="fas fa-balance-scale"></i>
                                            Punishments ({{ crime.punishments|length }})
                                        </div>
                                        <div class="crime-section-content">
                                            <div class="crime-list">
                                                {% for punishment in crime.punishments %}
                                                <div class="crime-list-item">
                                                    {{ punishment.type|replace('_', ' ')|title }} - {{ punishment.status|replace('_', ' ')|title }}
                                                    {% if punishment.amount %} - ${{ punishment.amount }}{% endif %}
                                                    {% if punishment.duration %} - {{ punishment.duration }} days{% endif %}
                                                </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}

                                    {% if crime.evidence and crime.evidence|length > 0 %}
                                    <div class="crime-section">
                                        <div class="crime-section-title">
                                            <i class="fas fa-folder-open"></i>
                                            Evidence ({{ crime.evidence|length }})
                                        </div>
                                        <div class="crime-section-content">
                                            <div class="crime-list">
                                                {% for evidence in crime.evidence %}
                                                <div class="crime-list-item">
                                                    {{ evidence.type|replace('_', ' ')|title }} - {{ evidence.description[:50] }}{% if evidence.description|length > 50 %}...{% endif %}
                                                </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="no-crimes">
                        <i class="fas fa-gavel"></i>
                        <h3>No Criminal Record</h3>
                        <p>No crimes have been recorded for this individual yet.</p>
                        <a href="{{ url_for('criminal.add_crime_to_criminal_form', criminal_id=person.id) }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i>
                            Add First Crime
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Action Buttons -->
    <div class="action-buttons">
        <a href="{{ url_for('criminal.criminal_form', criminal_id=person.id) }}" class="btn btn-secondary">
            <i class="fas fa-edit"></i>
            Edit Criminal Profile
        </a>
        <a href="{{ url_for('criminal.add_crime_to_criminal_form', criminal_id=person.id) }}" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Add New Crime
        </a>
        <a href="{{ url_for('criminal.list_criminals') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to List
        </a>
        <button onclick="deleteCriminal('{{ person.id }}', '{{ person.first_name }} {{ person.last_name }}')" class="btn btn-danger">
            <i class="fas fa-trash-alt"></i>
            Delete Record
        </button>
    </div>
</div>

<script>
    // Image Gallery Pagination
    const allImages = [
        {% for image in person_images %}
        {
            src: "{{ url_for('uploads', filename=image.image_path|image_url) }}",
            isPrimary: {{ 'true' if image.is_primary else 'false' }},
            index: {{ loop.index }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const imagesPerPage = 6;
    let currentPage = 1;
    const totalPages = Math.ceil(allImages.length / imagesPerPage);

    function renderGallery() {
        const gallery = document.getElementById('imageGallery');
        if (!gallery) return;

        const startIndex = (currentPage - 1) * imagesPerPage;
        const endIndex = startIndex + imagesPerPage;
        const currentImages = allImages.slice(startIndex, endIndex);

        gallery.innerHTML = currentImages.map(img => `
            <div class="gallery-item">
                <img src="${img.src}" alt="Photo ${img.index}">
                ${img.isPrimary ? '<div class="primary-badge">Primary</div>' : ''}
            </div>
        `).join('');

        // Update pagination info
        document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;

        // Update button states
        document.getElementById('prevBtn').disabled = currentPage === 1;
        document.getElementById('nextBtn').disabled = currentPage === totalPages;

        // Add click listeners for lightbox
        document.querySelectorAll('.gallery-item').forEach(item => {
            item.addEventListener('click', function() {
                const img = this.querySelector('img');
                if (img) {
                    showLightbox(img.src);
                }
            });
        });
    }

    function changePage(direction) {
        const newPage = currentPage + direction;
        if (newPage >= 1 && newPage <= totalPages) {
            currentPage = newPage;
            renderGallery();
        }
    }

    function showLightbox(src) {
        const overlay = document.createElement('div');
        overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            cursor: pointer;
        `;

        const imgClone = document.createElement('img');
        imgClone.src = src;
        imgClone.style.cssText = `
            max-width: 90%;
            max-height: 90%;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        `;

        overlay.appendChild(imgClone);
        document.body.appendChild(overlay);

        overlay.addEventListener('click', function() {
            document.body.removeChild(overlay);
        });
    }

    // Delete Criminal
    async function deleteCriminal(criminalId, criminalName) {
        if (!confirm(`Are you sure you want to delete the record for "${criminalName}"? This action cannot be undone and will also affect all associated crimes, punishments, and evidence.`)) {
            return;
        }

        try {
            const response = await fetch(`/criminals/${criminalId}/delete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.error) {
                if (window.toast) {
                    window.toast.error('Error', data.message || 'Failed to delete criminal record');
                }
            } else {
                if (window.toast) {
                    window.toast.success('Success', data.message || 'Criminal record deleted successfully');
                }
                setTimeout(() => {
                    window.location.href = '{{ url_for("criminal.list_criminals") }}';
                }, 1000);
            }
        } catch (error) {
            console.error('Error:', error);
            if (window.toast) {
                window.toast.error('Error', 'Failed to delete criminal record');
            }
        }
    }

    // Crime card click navigation
    document.querySelectorAll('.crime-card').forEach(card => {
        const crimeId = card.getAttribute('data-crime-id');
        if (crimeId) {
            card.addEventListener('click', function(e) {
                if (e.target.closest('button') || e.target.closest('a')) {
                    return;
                }
                window.location.href = `/criminals/crimes/${crimeId}`;
            });
        }
    });

    // Initialize gallery on page load
    document.addEventListener('DOMContentLoaded', function() {
        if (allImages.length > 0) {
            renderGallery();
        }

        // Animate sections on load
        const sections = document.querySelectorAll('.content-section');
        sections.forEach((section, index) => {
            section.style.opacity = '0';
            section.style.transform = 'translateY(20px)';

            setTimeout(() => {
                section.style.transition = 'all 0.4s ease';
                section.style.opacity = '1';
                section.style.transform = 'translateY(0)';
            }, 100 * index);
        });
    });
</script>
{% endblock %}