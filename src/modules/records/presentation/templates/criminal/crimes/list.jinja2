{% extends 'base.jinja2' %}

{% set crime_list = crimes if crimes else [] %}
{% set total = pagination.total if pagination and pagination.total else 0 %}
{% set page = pagination.page if pagination and pagination.page else 1 %}
{% set per_page = pagination.per_page if pagination and pagination.per_page else 20 %}
{% set total_pages = pagination.total_pages if pagination and pagination.total_pages else 1 %}
{% set current_status = filters.status if filters and filters.status else '' %}
{% set current_type = filters.crime_type if filters and filters.crime_type else '' %}
{% set current_criminal = filters.criminal_id if filters and filters.criminal_id else '' %}
{% set current_officer = filters.assigned_officer_id if filters and filters.assigned_officer_id else '' %}
{% set include_deleted = filters.include_deleted if filters and filters.include_deleted else false %}

{% block title %}Crime Cases | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   PAGE LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    height: 100%;
}

/* ===========================
   BREADCRUMB & HEADER - MATCHING STYLE
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 8px;
}

.header-content {
    flex: 1;
    min-width: 280px;
}

.header-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
}

.header-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(37, 99, 235, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.header-icon i {
    font-size: 26px;
    color: var(--info);
}

.header-text h1 {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
}

.header-text p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 6px 0 0 0;
    line-height: 1.5;
}

.header-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
}

/* ===========================
   STATS CARDS - TRANSPARENT
   =========================== */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--info), #2563eb);
    opacity: 0;
    transition: var(--transition);
}

.stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--info);
}

.stat-card:hover::before {
    opacity: 1;
}

.stat-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.stat-label {
    font-size: 12px;
    color: var(--text-secondary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
}

/* ===========================
   CONTENT CARD - TRANSPARENT
   =========================== */
.content-card {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.card-header {
    padding: 24px 28px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    background: transparent;
}

.card-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.filters {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.filter-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.filter-select {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    color: var(--text-primary);
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: var(--transition-fast);
    min-width: 140px;
}

.filter-select:focus {
    outline: none;
    border-color: var(--info);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.filter-select:hover {
    border-color: var(--info);
}

/* ===========================
   CRIMES LIST - TRANSPARENT CARDS
   =========================== */
.crimes-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    overflow-y: auto;
    flex: 1;
}

.crime-card {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    cursor: pointer;
}

.crime-card:hover {
    transform: translateY(-2px);
    border-color: var(--info);
}

.crime-header {
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
}

.crime-title-section {
    flex: 1;
    min-width: 200px;
}

.crime-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.crime-title i {
    color: var(--info);
}

.crime-case {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: monospace;
}

.crime-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.crime-status {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.crime-status.open {
    background: var(--error-bg);
    color: var(--error);
}

.crime-status.under-investigation,
.crime-status.under_investigation {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
}

.crime-status.closed {
    background: var(--success-bg);
    color: var(--success);
}

.crime-status.solved {
    background: var(--success-bg);
    color: var(--success);
}

.crime-body {
    padding: 20px 24px;
}

.crime-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 16px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.info-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1.5;
}

.crime-description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    padding: 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin-top: 12px;
}

.crime-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.action-btn {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
    background: transparent;
    color: var(--text-secondary);
}

.action-btn:hover {
    transform: translateY(-2px);
}

.action-btn.view:hover {
    background: rgba(59, 130, 246, 0.15);
    color: var(--info);
    border-color: var(--info);
}

.action-btn.edit:hover {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border-color: var(--warning);
}

.action-btn.delete:hover {
    background: var(--error-bg);
    color: var(--error);
    border-color: var(--error);
}

.action-btn i {
    font-size: 14px;
}

/* ===========================
   EMPTY STATE
   =========================== */
.empty-state {
    text-align: center;
    padding: 80px 40px;
}

.empty-state i {
    font-size: 64px;
    color: var(--text-muted);
    margin-bottom: 20px;
    opacity: 0.5;
}

.empty-state h3 {
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 8px;
    font-weight: 600;
}

.empty-state p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 24px;
}

/* ===========================
   PAGINATION - TRANSPARENT
   =========================== */
.pagination {
    padding: 20px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    background: transparent;
}

.pagination-info {
    font-size: 14px;
    color: var(--text-secondary);
}

.pagination-controls {
    display: flex;
    gap: 8px;
}

.pagination-btn {
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-fast);
    min-width: 36px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.pagination-btn:hover:not(:disabled):not(.disabled) {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--info);
    color: var(--info);
}

.pagination-btn:disabled,
.pagination-btn.disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.pagination-btn.active {
    background: linear-gradient(135deg, var(--info), #2563eb);
    color: white;
    border-color: var(--info);
    font-weight: 600;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--info), #2563eb);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--info);
    color: var(--text-primary);
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 768px) {
    .page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .filters {
        width: 100%;
    }

    .filter-group {
        flex: 1;
        min-width: 120px;
    }

    .crimes-list {
        padding: 20px;
    }

    .crime-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .crime-info-grid {
        grid-template-columns: 1fr;
    }

    .pagination {
        flex-direction: column;
        gap: 15px;
    }

    .pagination-controls {
        flex-wrap: wrap;
        justify-content: center;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Crime Cases</span>
        </span>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="header-content">
            <div class="header-title">
                <div class="header-icon">
                    <i class="fas fa-gavel"></i>
                </div>
                <div class="header-text">
                    <h1>Crime Cases</h1>
                    <p>Track and manage all criminal cases</p>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="{{ url_for('criminal.crime_form') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                Add Crime Case
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-body">
                <div class="stat-label">Total Cases</div>
                <div class="stat-value">{{ total }}</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-body">
                <div class="stat-label">Open Cases</div>
                <div class="stat-value">{{ crime_list|selectattr('status', 'equalto', 'OPEN')|list|length }}</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-body">
                <div class="stat-label">Under Investigation</div>
                <div class="stat-value">{{ crime_list|selectattr('status', 'equalto', 'UNDER_INVESTIGATION')|list|length }}</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-body">
                <div class="stat-label">Solved</div>
                <div class="stat-value">{{ crime_list|selectattr('status', 'equalto', 'SOLVED')|list|length }}</div>
            </div>
        </div>
    </div>

    <!-- Content Card -->
    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-list"></i>
                All Cases ({{ total }})
            </h2>
            <div class="filters">
                <div class="filter-group">
                    <label class="filter-label">Status</label>
                    <select class="filter-select" id="statusFilter" onchange="applyFilters()">
                        <option value="">All Status</option>
                        <option value="OPEN" {% if current_status == 'OPEN' %}selected{% endif %}>Open</option>
                        <option value="UNDER_INVESTIGATION" {% if current_status == 'UNDER_INVESTIGATION' %}selected{% endif %}>Under Investigation</option>
                        <option value="CLOSED" {% if current_status == 'CLOSED' %}selected{% endif %}>Closed</option>
                        <option value="SOLVED" {% if current_status == 'SOLVED' %}selected{% endif %}>Solved</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">View</label>
                    <select class="filter-select" id="deletedFilter" onchange="applyFilters()">
                        <option value="false" {% if not include_deleted %}selected{% endif %}>Active Only</option>
                        <option value="true" {% if include_deleted %}selected{% endif %}>Include Deleted</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="crimes-list">
            {% if crime_list and crime_list|length > 0 %}
                {% for crime in crime_list %}
                <div class="crime-card" onclick="window.location.href='{{ url_for('criminal.view_crime', crime_id=crime.id) }}'">
                    <div class="crime-header">
                        <div class="crime-title-section">
                            <h3 class="crime-title">
                                <i class="fas fa-file-alt"></i>
                                {{ crime.crime_type }}
                            </h3>
                            <div class="crime-case">Case #{{ crime.case_number }}</div>
                        </div>
                        <div class="crime-badges">
                            <span class="crime-status {{ crime.status|lower|replace('_', '-') if crime.status else 'open' }}">
                                {{ crime.status|replace('_', ' ') if crime.status else 'OPEN' }}
                            </span>
                        </div>
                    </div>

                    <div class="crime-body">
                        <div class="crime-info-grid">
                            <div class="info-item">
                                <div class="info-label">Date Committed</div>
                                <div class="info-value">{{ crime.date_committed[:10] if crime.date_committed else 'Unknown' }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Date Reported</div>
                                <div class="info-value">{{ crime.date_reported[:10] if crime.date_reported else 'Unknown' }}</div>
                            </div>
                            {% if crime.location and crime.location.city %}
                            <div class="info-item">
                                <div class="info-label">Location</div>
                                <div class="info-value">
                                    {{ crime.location.city }}{% if crime.location.state %}, {{ crime.location.state }}{% endif %}
                                </div>
                            </div>
                            {% endif %}
                            {% if crime.assigned_officer_id %}
                            <div class="info-item">
                                <div class="info-label">Assigned Officer</div>
                                <div class="info-value">{{ crime.assigned_officer_id[:8] }}...</div>
                            </div>
                            {% endif %}
                        </div>

                        {% if crime.description %}
                        <div class="crime-description">
                            {{ crime.description[:200] }}{% if crime.description|length > 200 %}...{% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <div class="crime-footer">
                        <button class="action-btn view" onclick="event.stopPropagation(); window.location.href='{{ url_for('criminal.view_crime', crime_id=crime.id) }}'" title="View Details">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="action-btn edit" onclick="event.stopPropagation(); window.location.href='{{ url_for('criminal.crime_form', crime_id=crime.id) }}'" title="Edit">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="action-btn delete" onclick="event.stopPropagation(); deleteCrime('{{ crime.id }}', '{{ crime.case_number }}')" title="Delete">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-gavel"></i>
                    <h3>No Crime Cases Found</h3>
                    <p>There are no crime cases matching your criteria.</p>
                    <a href="{{ url_for('criminal.crime_form') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Add First Case
                    </a>
                </div>
            {% endif %}
        </div>

        {% if crime_list and crime_list|length > 0 and pagination %}
        <div class="pagination">
            <div class="pagination-info">
                {% set start = ((page - 1) * per_page) + 1 %}
                {% set calculated_end = page * per_page %}
                {% set end = calculated_end if calculated_end < total else total %}
                Showing {{ start }} to {{ end }} of {{ total }} cases
            </div>
            <div class="pagination-controls">
                <a href="{{ url_for('criminal.list_crimes', page=1, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                   class="pagination-btn {% if page <= 1 %}disabled{% endif %}"
                   {% if page <= 1 %}onclick="return false;"{% endif %}>
                    First
                </a>
                <a href="{{ url_for('criminal.list_crimes', page=page-1, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                   class="pagination-btn {% if page <= 1 %}disabled{% endif %}"
                   {% if page <= 1 %}onclick="return false;"{% endif %}>
                    Previous
                </a>

                {% set start_page = page - 2 if page - 2 > 1 else 1 %}
                {% set end_page = page + 2 if page + 2 < total_pages else total_pages %}
                {% set current_page = page %}
                {% set next_page = current_page + 1 %}

                {% for page_num in range(start_page, end_page + 1) %}
                <a href="{{ url_for('criminal.list_crimes', page=page_num, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                   class="pagination-btn {% if page_num == current_page %}active{% endif %}">
                    {{ page_num }}
                </a>
                {% endfor %}

                <a href="{{ url_for('criminal.list_crimes', page=next_page, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                   class="pagination-btn {% if current_page >= total_pages %}disabled{% endif %}"
                   {% if current_page >= total_pages %}onclick="return false;"{% endif %}>
                    Next
                </a>
                <a href="{{ url_for('criminal.list_crimes', page=total_pages, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                   class="pagination-btn {% if current_page >= total_pages %}disabled{% endif %}"
                   {% if current_page >= total_pages %}onclick="return false;"{% endif %}>
                    Last
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<script>
    // Filter Functions
    function applyFilters() {
        const status = document.getElementById('statusFilter').value;
        const deleted = document.getElementById('deletedFilter').value;

        const params = new URLSearchParams(window.location.search);

        if (status) {
            params.set('status', status);
        } else {
            params.delete('status');
        }

        params.set('include_deleted', deleted);
        params.set('page', '1'); // Reset to first page

        window.location.search = params.toString();
    }

    // Delete Crime
    async function deleteCrime(crimeId, caseNumber) {
        if (!confirm(`Are you sure you want to delete case "${caseNumber}"? This action cannot be undone.`)) {
            return;
        }

        try {
            const response = await fetch(`/criminals/crimes/${crimeId}/delete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.error) {
                if (window.toast) {
                    window.toast.error('Error', data.message || 'Failed to delete crime case');
                }
            } else {
                if (window.toast) {
                    window.toast.success('Success', data.message || 'Crime case deleted successfully');
                }
                setTimeout(() => window.location.reload(), 1000);
            }
        } catch (error) {
            console.error('Error:', error);
            if (window.toast) {
                window.toast.error('Error', 'Failed to delete crime case');
            }
        }
    }
</script>
{% endblock %}