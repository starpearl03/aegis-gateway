// Form submission
document.getElementById('crimeForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    {% if not is_editing %}
    // Validate that location is selected
    const latitude = document.getElementById('latitude').value;
    const longitude = document.getElementById('longitude').value;

    if (!latitude || !longitude) {
        if (window.toast) {
            window.toast.warning('Location Required', 'Please select a location on the map');
        } else {
            alert('Please select a location on the map');
        }
        return;
    }
    {% endif %}

    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.classList.add('loading');

    const formData = new FormData(this);

    {% if from_criminal and not is_editing %}
    // Add criminal_id if adding crime to specific criminal
    formData.set('criminal_id', '{{ criminal_data.id }}');
    {% endif %}

    try {
        const response = await fetch(this.action, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.error) {
            if (window.toast) {
                window.toast.error('Error', data.message || 'Failed to submit form');
            } else {
                alert('Error: ' + (data.message || 'Failed to submit form'));
            }
            submitBtn.disabled = false;
            submitBtn.classList.remove('loading');
        } else {
            if (window.toast) {
                window.toast.success('Success', data.message || 'Crime {{ "updated" if is_editing else "added" }} successfully');
            } else {
                alert('Success: ' + (data.message || 'Crime {{ "updated" if is_editing else "added" }} successfully'));
            }

            // Redirect after short delay
            setTimeout(() => {
                {% if from_criminal %}
                window.location.href = '{{ url_for("criminal.view_criminal", criminal_id=criminal_data.id) }}';
                {% else %}
                window.location.href = '{{ url_for("criminal.list_crimes") }}';
                {% endif %}
            }, 1500);
        }
    } catch (error) {
        console.error('Error:', error);
        if (window.toast) {
            window.toast.error('Error', 'Failed to submit form');
        } else {
            alert('Error: Failed to submit form');
        }
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
    }
});
</script>
