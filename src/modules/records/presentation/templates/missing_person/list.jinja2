{% extends 'base.jinja2' %}

{% set persons = missing_persons if missing_persons else [] %}
{% set total = pagination.total if pagination and pagination.total else 0 %}
{% set page = pagination.page if pagination and pagination.page else 1 %}
{% set per_page = pagination.per_page if pagination and pagination.per_page else 20 %}
{% set total_pages = pagination.total_pages if pagination and pagination.total_pages else 1 %}
{% set current_status = filters.status if filters and filters.status else '' %}
{% set current_officer = filters.assigned_officer_id if filters and filters.assigned_officer_id else '' %}
{% set include_deleted = filters.include_deleted if filters and filters.include_deleted else false %}

{% block title %}Missing Persons | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   MODERN COMPACT LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.layout-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: start;
}

.layout-full {
    grid-column: 1 / -1;
}

.layout-sidebar {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.layout-main {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--error);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   COMPACT HEADER
   =========================== */
.page-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(239, 68, 68, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    z-index: 1;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 16px;
}

.header-icon {
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--border);
}

.header-icon i {
    font-size: 24px;
    color: var(--error);
}

.header-text h1 {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
}

/* ===========================
   COMPACT FILTERS SIDEBAR
   =========================== */
.filters-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.filters-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
}

.filters-title i {
    color: var(--error);
    font-size: 16px;
}

.clear-filters-btn {
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 4px;
}

.clear-filters-btn:hover {
    color: var(--error);
}

.filters-body {
    padding: 16px;
}

.filters-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.filter-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-control {
    padding: 10px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px;
    color: #ffffff;
    transition: var(--transition-fast);
    font-family: inherit;
    width: 100%;
    cursor: pointer;
}

.filter-control:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--error);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
}

.filter-control option {
    background: var(--bg-tertiary);
    color: #ffffff;
}

.filter-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
}

/* ===========================
   QUICK STATS SIDEBAR
   =========================== */
.quick-stats-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stats-title-compact {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.stats-title-compact i {
    color: var(--error);
    font-size: 16px;
}

.stats-grid-compact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.stat-item-compact {
    padding: 10px;
    background: rgba(10, 14, 39, 0.3);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: center;
    transition: var(--transition);
}

.stat-item-compact:hover {
    border-color: var(--error);
    transform: translateY(-1px);
}

.stat-value-compact {
    font-size: 18px;
    font-weight: 700;
    color: var(--error);
    margin-bottom: 2px;
    line-height: 1;
}

.stat-label-compact {
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

/* ===========================
   PERSONS SECTION
   =========================== */
.persons-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.section-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
}

.section-title i {
    color: var(--error);
    font-size: 18px;
}

.section-count {
    font-size: 12px;
    color: var(--text-muted);
    padding: 4px 10px;
    background: rgba(10, 14, 39, 0.4);
    border-radius: var(--radius-md);
}

.section-body {
    padding: 20px;
}

/* ===========================
   COMPACT PERSON CARDS - IMPROVED
   =========================== */
.persons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
}

.person-card {
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.person-card:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--error);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

/* Compact Header */
.person-header {
    padding: 14px 16px;
    display: flex;
    gap: 12px;
    align-items: center;
    border-bottom: 1px solid var(--border);
}

.person-avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.15));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: var(--error);
    font-weight: 700;
    flex-shrink: 0;
    border: 1px solid var(--border);
    overflow: hidden;
}

.person-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.person-info {
    flex: 1;
    min-width: 0;
}

.person-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.person-meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.meta-item {
    font-size: 11px;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 4px;
}

.meta-item i {
    font-size: 10px;
    color: var(--error);
}

/* Compact Body */
.person-body {
    padding: 14px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.last-seen {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
}

.last-seen i {
    font-size: 14px;
    color: var(--error);
    margin-top: 2px;
    flex-shrink: 0;
}

.last-seen-info {
    flex: 1;
    min-width: 0;
}

.last-seen-label {
    font-size: 10px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.last-seen-value {
    font-size: 12px;
    color: var(--text-primary);
    line-height: 1.3;
}

.info-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.info-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 12px;
    color: var(--text-primary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Compact Footer */
.person-footer {
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: auto;
}

.status-badge {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    flex-shrink: 0;
}

.status-badge.missing {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.status-badge.found {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.status-badge.deceased {
    background: rgba(100, 116, 139, 0.15);
    color: #64748b;
    border: 1px solid rgba(100, 116, 139, 0.3);
}

.action-buttons {
    display: flex;
    gap: 6px;
}

.action-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
    background: transparent;
    color: var(--text-secondary);
}

.action-btn:hover {
    transform: translateY(-1px);
}

.action-btn.view:hover {
    background: rgba(59, 130, 246, 0.15);
    color: var(--info);
    border-color: var(--info);
}

.action-btn.edit:hover {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border-color: var(--warning);
}

.action-btn.delete:hover {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border-color: var(--error);
}

.action-btn i {
    font-size: 12px;
}

/* ===========================
   EMPTY STATE
   =========================== */
.empty-state {
    text-align: center;
    padding: 60px 40px;
    color: var(--text-muted);
    grid-column: 1 / -1;
}

.empty-state i {
    font-size: 48px;
    margin-bottom: 16px;
    opacity: 0.5;
    color: var(--error);
}

.empty-state h3 {
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 8px;
    font-weight: 600;
}

.empty-state p {
    font-size: 14px;
    margin-bottom: 20px;
    line-height: 1.5;
}

/* ===========================
   PAGINATION
   =========================== */
.pagination-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    gap: 12px;
    border-top: 1px solid var(--border);
}

.pagination {
    display: flex;
    gap: 6px;
    align-items: center;
}

.page-link {
    padding: 8px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 4px;
}

.page-link:hover:not(.disabled):not(.active) {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--error);
    color: var(--error);
}

.page-link.active {
    background: linear-gradient(135deg, var(--error), #dc2626);
    border-color: var(--error);
    color: white;
}

.page-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.page-info {
    font-size: 12px;
    color: var(--text-muted);
    padding: 0 8px;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 10px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.btn i {
    font-size: 14px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--error), #dc2626);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--error);
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 1200px) {
    .layout-grid {
        grid-template-columns: 260px 1fr;
    }

    .persons-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
}

@media (max-width: 968px) {
    .layout-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .layout-sidebar {
        position: static;
        order: 2;
    }

    .layout-main {
        order: 1;
    }

    .persons-grid {
        grid-template-columns: 1fr;
    }

    .header-content {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }
}

@media (max-width: 768px) {
    .page-header {
        padding: 16px 20px;
    }

    .header-left {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .header-text h1 {
        font-size: 20px;
    }

    .section-body {
        padding: 16px;
    }

    .persons-grid {
        gap: 12px;
    }

    .person-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .person-avatar {
        align-self: center;
    }

    .person-footer {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .action-buttons {
        justify-content: space-between;
    }

    .action-btn {
        flex: 1;
    }
}

@media (max-width: 480px) {
    .stats-grid-compact {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb layout-full">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Missing Persons</span>
        </span>
    </div>

    <!-- Compact Header -->
    <div class="page-header layout-full">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fas fa-user-slash"></i>
                </div>
                <div class="header-text">
                    <h1>Missing Persons</h1>
                    <p>Track and manage missing person cases</p>
                </div>
            </div>
            <a href="{{ url_for('missing_person.missing_person_form') }}" class="btn btn-primary">
                <i class="fas fa-user-plus"></i>
                Report Missing Person
            </a>
        </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="layout-grid">
        <!-- LEFT SIDEBAR: Filters & Stats -->
        <div class="layout-sidebar">
            <!-- Compact Filters -->
            <div class="filters-sidebar">
                <div class="filters-header">
                    <h2 class="filters-title">
                        <i class="fas fa-filter"></i>
                        Filters
                    </h2>
                    <a href="{{ url_for('missing_person.list_missing_persons') }}" class="clear-filters-btn">
                        <i class="fas fa-times-circle"></i>
                        Clear
                    </a>
                </div>
                <div class="filters-body">
                    <form method="GET" action="{{ url_for('missing_person.list_missing_persons') }}">
                        <div class="filters-grid">
                            <!-- Status Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-tag"></i>
                                    Status
                                </label>
                                <select name="status" class="filter-control" id="statusFilter">
                                    <option value="">All Status</option>
                                    <option value="MISSING" {% if current_status == 'MISSING' %}selected{% endif %}>Missing</option>
                                    <option value="FOUND" {% if current_status == 'FOUND' %}selected{% endif %}>Found</option>
                                    <option value="DECEASED" {% if current_status == 'DECEASED' %}selected{% endif %}>Deceased</option>
                                </select>
                            </div>

                            <!-- View Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-eye"></i>
                                    View
                                </label>
                                <select name="include_deleted" class="filter-control" id="deletedFilter">
                                    <option value="false" {% if not include_deleted %}selected{% endif %}>Active Only</option>
                                    <option value="true" {% if include_deleted %}selected{% endif %}>Include Deleted</option>
                                </select>
                            </div>

                            <!-- Per Page Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-list"></i>
                                    Per Page
                                </label>
                                <select name="per_page" class="filter-control">
                                    <option value="12" {% if per_page == 12 %}selected{% endif %}>12</option>
                                    <option value="20" {% if per_page == 20 %}selected{% endif %}>20</option>
                                    <option value="40" {% if per_page == 40 %}selected{% endif %}>40</option>
                                    <option value="60" {% if per_page == 60 %}selected{% endif %}>60</option>
                                </select>
                            </div>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i>
                                Apply Filters
                            </button>
                            <a href="{{ url_for('missing_person.list_missing_persons') }}" class="btn btn-secondary">
                                <i class="fas fa-redo"></i>
                                Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Quick Stats Sidebar -->
            <div class="quick-stats-sidebar">
                <h3 class="stats-title-compact">
                    <i class="fas fa-chart-pie"></i>
                    Quick Stats
                </h3>
                <div class="stats-grid-compact">
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ total }}</div>
                        <div class="stat-label-compact">Total Cases</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ persons|selectattr('status', 'equalto', 'MISSING')|list|length }}</div>
                        <div class="stat-label-compact">Active</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ persons|selectattr('status', 'equalto', 'FOUND')|list|length }}</div>
                        <div class="stat-label-compact">Found</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ persons|selectattr('status', 'equalto', 'DECEASED')|list|length }}</div>
                        <div class="stat-label-compact">Deceased</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT MAIN: Persons List -->
        <div class="layout-main">
            <!-- Persons Section -->
            <div class="persons-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-users"></i>
                        All Cases
                    </h2>
                    <span class="section-count">
                        {{ total }} case{{ 's' if total != 1 else '' }}
                    </span>
                </div>
                <div class="section-body">
                    {% if persons and persons|length > 0 %}
                        <div class="persons-grid">
                            {% for person in persons %}
                            <div class="person-card" onclick="window.location.href='{{ url_for('missing_person.view_missing_person', missing_person_id=person.id) }}'">
                                <div class="person-header">
                                    <div class="person-avatar">
                                        {% if person.primary_image %}
                                            <img src="{{ url_for('uploads', filename=person.primary_image|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                                        {% else %}
                                            {{ person.first_name[0] if person.first_name else 'M' }}{{ person.last_name[0] if person.last_name else 'P' }}
                                        {% endif %}
                                    </div>
                                    <div class="person-info">
                                        <h3 class="person-name">{{ person.first_name }} {{ person.last_name }}</h3>
                                        <div class="person-meta">
                                            {% if person.age %}
                                            <div class="meta-item">
                                                <i class="fas fa-birthday-cake"></i>
                                                <span>{{ person.age }} years</span>
                                                </div>
                                            {% endif %}
                                            {% if person.gender %}
                                            <div class="meta-item">
                                                <i class="fas fa-venus-mars"></i>
                                                <span>{{ person.gender }}</span>
                                            </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                <div class="person-body">
                                    {% if person.last_seen_date and person.last_seen_location %}
                                    <div class="last-seen">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <div class="last-seen-info">
                                            <div class="last-seen-label">Last Seen</div>
                                            <div class="last-seen-value">
                                                {{ person.last_seen_date[:10] if person.last_seen_date else 'Unknown' }}
                                                {% if person.last_seen_location and person.last_seen_location.city %}
                                                    - {{ person.last_seen_location.city }}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}

                                    {% if person.circumstances %}
                                    <div class="info-section">
                                        <div class="info-label">Circumstances</div>
                                        <div class="info-value">
                                            {{ person.circumstances }}
                                        </div>
                                    </div>
                                    {% endif %}

                                    {% if person.distinctive_features %}
                                    <div class="info-section">
                                        <div class="info-label">Distinctive Features</div>
                                        <div class="info-value">{{ person.distinctive_features }}</div>
                                    </div>
                                    {% endif %}
                                </div>

                                <div class="person-footer">
                                    <span class="status-badge {{ person.status|lower if person.status else 'missing' }}">
                                        {{ person.status if person.status else 'MISSING' }}
                                    </span>
                                    <div class="action-buttons">
                                        <button class="action-btn view" onclick="event.stopPropagation(); window.location.href='{{ url_for('missing_person.view_missing_person', missing_person_id=person.id) }}'" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="action-btn edit" onclick="event.stopPropagation(); window.location.href='{{ url_for('missing_person.missing_person_form', missing_person_id=person.id) }}'" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn delete" onclick="event.stopPropagation(); deletePerson('{{ person.id }}', '{{ person.first_name }} {{ person.last_name }}')" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-user-slash"></i>
                            <h3>No Missing Persons Found</h3>
                            <p>There are no missing person cases matching your criteria.</p>
                            <a href="{{ url_for('missing_person.missing_person_form') }}" class="btn btn-primary">
                                <i class="fas fa-user-plus"></i>
                                Report First Case
                            </a>
                        </div>
                    {% endif %}
                </div>

                {% if persons and persons|length > 0 and pagination %}
                <div class="pagination-section">
                    <div class="pagination">
                        <!-- First & Previous -->
                        <a href="{{ url_for('missing_person.list_missing_persons', page=1, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                           class="page-link {% if page <= 1 %}disabled{% endif %}">
                            <i class="fas fa-angle-double-left"></i>
                        </a>
                        <a href="{{ url_for('missing_person.list_missing_persons', page=page-1, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                           class="page-link {% if page <= 1 %}disabled{% endif %}">
                            <i class="fas fa-chevron-left"></i>
                        </a>

                        <!-- Page Info -->
                        <span class="page-info">
                            Page {{ page }} of {{ total_pages }}
                        </span>

                        <!-- Page Numbers (show 5 pages max) -->
                        {% set start_page = [1, page - 2]|max %}
                        {% set end_page = [total_pages, page + 2]|min %}

                        {% for page_num in range(start_page, end_page + 1) %}
                            <a href="{{ url_for('missing_person.list_missing_persons', page=page_num, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                               class="page-link {{ 'active' if page_num == page else '' }}">
                                {{ page_num }}
                            </a>
                        {% endfor %}

                        <!-- Next & Last -->
                        <a href="{{ url_for('missing_person.list_missing_persons', page=page+1, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                           class="page-link {% if page >= total_pages %}disabled{% endif %}">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        <a href="{{ url_for('missing_person.list_missing_persons', page=total_pages, per_page=per_page, status=current_status, include_deleted=include_deleted) }}"
                           class="page-link {% if page >= total_pages %}disabled{% endif %}">
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
// Delete Person
async function deletePerson(personId, personName) {
    if (!confirm(`Are you sure you want to delete the case for "${personName}"?\n\nThis action cannot be undone.`)) {
        return;
    }

    try {
        const response = await fetch(`{{ url_for('missing_person.list_missing_persons') }}/${personId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            const errorMessage = data.message ||
                               (data.error && data.error.details && data.error.details[0]) ||
                               'Failed to delete case';
            throw new Error(errorMessage);
        }

        // Success
        if (window.toast) {
            window.toast.success('Success', data.message || 'Case deleted successfully');
        } else {
            alert('Success: Case deleted successfully');
        }

        // Reload page after short delay
        setTimeout(() => {
            window.location.reload();
        }, 1000);

    } catch (error) {
        console.error('Delete error:', error);

        if (window.toast) {
            window.toast.error('Error', error.message || 'Failed to delete case');
        } else {
            alert('Error: ' + (error.message || 'Failed to delete case'));
        }
    }
}

// Animate cards on page load
document.addEventListener('DOMContentLoaded', function() {
    const personCards = document.querySelectorAll('.person-card');

    personCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';

        setTimeout(() => {
            card.style.transition = 'all 0.4s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, 50 * index);
    });

    // Animate stats
    const statValues = document.querySelectorAll('.stat-value-compact');
    statValues.forEach(stat => {
        const target = parseInt(stat.textContent) || 0;
        let current = 0;
        const increment = target / 30;
        const duration = 1000;
        const stepTime = duration / 30;

        stat.textContent = '0';

        const timer = setInterval(() => {
            current += increment;
            if (current >= target) {
                stat.textContent = target;
                clearInterval(timer);
            } else {
                stat.textContent = Math.floor(current);
            }
        }, stepTime);
    });
});

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    // N key for new missing person report
    if (e.key === 'n' || e.key === 'N') {
        if (!e.target.matches('input, textarea, select')) {
            window.location.href = '{{ url_for("missing_person.missing_person_form") }}';
        }
    }

    // ESC to clear filters
    if (e.key === 'Escape') {
        window.location.href = '{{ url_for("missing_person.list_missing_persons") }}';
    }
});
</script>

<!-- Scroll to Top Button -->
<button id="scrollToTop" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" style="
    display: none;
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 48px;
    height: 48px;
    background: var(--error);
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 20px;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    transition: var(--transition);
    align-items: center;
    justify-content: center;
">
    <i class="fas fa-arrow-up"></i>
</button>

<script>
// Show/hide scroll to top button
window.addEventListener('scroll', function() {
    const scrollBtn = document.getElementById('scrollToTop');
    if (scrollBtn) {
        if (window.pageYOffset > 300) {
            scrollBtn.style.display = 'flex';
        } else {
            scrollBtn.style.display = 'none';
        }
    }
});

// Enhance scroll to top button
const scrollBtn = document.getElementById('scrollToTop');
if (scrollBtn) {
    scrollBtn.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-4px) scale(1.05)';
    });

    scrollBtn.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
    });
}
</script>
{% endblock %}