{% extends 'base.jinja2' %}

{% set person = missing_person if missing_person else {} %}
{% set person_images = images if images else [] %}
{% set is_editing = is_edit if is_edit else false %}
{% set form_title = 'Edit Missing Person' if is_editing else 'Report Missing Person' %}

{% block title %}{{ form_title }} | Sentinel{% endblock %}

{% block extra_css %}
<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
/* ===========================
   PAGE LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
    overflow-y: auto;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   FORM HEADER - TRANSPARENT
   =========================== */
.form-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    position: relative;
    overflow: hidden;
}

.header-content {
    display: flex;
    align-items: center;
    gap: 20px;
}

.header-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--border);
}

.header-icon i {
    font-size: 28px;
    color: var(--error);
}

.header-text h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
}

/* ===========================
   FORM CONTAINER - TRANSPARENT
   =========================== */
.form-container {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

/* ===========================
   MODERN STEPPER - CENTERED & IMPROVED
   =========================== */
.form-progress {
    padding: 32px 40px;
    background: transparent;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: center;
}

.progress-steps {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    max-width: 800px;
    width: 100%;
    gap: 0;
}

.progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 2;
    flex: 1;
}

.step-circle-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.step-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 3px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-muted);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 3;
}

.progress-step.active .step-circle {
    background: linear-gradient(135deg, var(--error), #dc2626);
    border-color: var(--error);
    color: white;
    transform: scale(1.15);
    box-shadow: 0 0 0 6px rgba(239, 68, 68, 0.15);
}

.progress-step.completed .step-circle {
    background: var(--success);
    border-color: var(--success);
    color: white;
    transform: scale(1);
}

.progress-step.completed .step-circle::after {
    content: '\f00c';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    position: absolute;
    font-size: 14px;
}

.progress-step.completed .step-circle span {
    display: none;
}

/* Connection Line */
.step-connector {
    position: absolute;
    top: 24px;
    left: 50%;
    right: -50%;
    height: 3px;
    background: var(--border);
    z-index: 1;
    transform: translateY(-50%);
}

.progress-step:last-child .step-connector {
    display: none;
}

.progress-step.completed .step-connector {
    background: linear-gradient(90deg, var(--success), var(--success));
}

.progress-step.active .step-connector {
    background: linear-gradient(90deg, var(--error) 0%, var(--border) 100%);
}

.step-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
    transition: var(--transition);
    white-space: nowrap;
}

.progress-step.active .step-label {
    color: var(--error);
    font-weight: 700;
}

.progress-step.completed .step-label {
    color: var(--success);
}

/* ===========================
   FORM BODY - TRANSPARENT
   =========================== */
.form-body {
    padding: 32px;
}

.form-step {
    display: none;
}

.form-step.active {
    display: block;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.step-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.step-description {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    line-height: 1.6;
}

/* ===========================
   FORM SECTIONS
   =========================== */
.form-section {
    margin-bottom: 32px;
}

.form-section:last-child {
    margin-bottom: 0;
}

.section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-title i {
    color: var(--error);
    font-size: 18px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.form-grid.single {
    grid-template-columns: 1fr;
}

.form-grid.triple {
    grid-template-columns: repeat(3, 1fr);
}

/* ===========================
   FORM GROUPS - TRANSPARENT
   =========================== */
.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.required {
    color: var(--error);
    font-size: 16px;
}

.optional {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
    margin-left: 6px;
}

.form-control {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: #ffffff !important;
    transition: var(--transition-fast);
    font-family: inherit;
}

.form-control:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--error);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
    color: #ffffff !important;
}

/* Fix for autocomplete white background - FORCE WHITE TEXT */
.form-control:-webkit-autofill,
.form-control:-webkit-autofill:hover,
.form-control:-webkit-autofill:focus,
.form-control:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px rgba(10, 14, 39, 0.4) inset !important;
    -webkit-text-fill-color: #ffffff !important;
    background-color: rgba(10, 14, 39, 0.4) !important;
    color: #ffffff !important;
    transition: background-color 5000s ease-in-out 0s;
}

.form-control::placeholder {
    color: var(--text-muted) !important;
}

/* Force white text for all input states */
input.form-control,
textarea.form-control,
select.form-control {
    color: #ffffff !important;
}

input.form-control:focus,
textarea.form-control:focus,
select.form-control:focus {
    color: #ffffff !important;
}

textarea.form-control {
    min-height: 100px;
    resize: vertical;
}

select.form-control {
    cursor: pointer;
}

select.form-control option {
    background: var(--bg-tertiary);
    color: #ffffff;
}

.form-helper {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
}

.form-helper i {
    font-size: 11px;
    margin-right: 4px;
}

/* ===========================
   PHONE INPUT WITH PREFIX
   =========================== */
.phone-input-wrapper {
    display: flex;
    gap: 8px;
    align-items: stretch;
}

.phone-prefix {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: #ffffff;
    font-weight: 600;
    display: flex;
    align-items: center;
    white-space: nowrap;
    user-select: none;
}

.phone-input-wrapper .form-control {
    flex: 1;
}

.phone-format-hint {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
}

.phone-format-hint.error {
    color: var(--error);
}

/* ===========================
   MAP CONTAINER - TRANSPARENT
   =========================== */
.map-container {
    height: 400px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    margin-top: 16px;
}

.map-controls {
    display: flex;
    gap: 12px;
    margin-top: 12px;
}

.map-controls input {
    flex: 1;
}

.btn-map {
    padding: 12px 20px;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: var(--transition-fast);
    white-space: nowrap;
}

.btn-map:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--error);
}

.btn-map i {
    margin-right: 6px;
}

/* ===========================
   IMAGE UPLOAD - TRANSPARENT
   =========================== */
.image-upload-section {
    padding: 24px;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
}

.image-upload-section:hover {
    border-color: var(--error);
    background: rgba(10, 14, 39, 0.2);
}

.upload-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    background: rgba(239, 68, 68, 0.1);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
}

.upload-icon i {
    font-size: 28px;
    color: var(--error);
}

.upload-text {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 4px;
}

.upload-hint {
    font-size: 12px;
    color: var(--text-muted);
}

.image-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
    margin-top: 20px;
}

.preview-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
}

.preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.preview-remove {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background: rgba(239, 68, 68, 0.9);
    backdrop-filter: blur(10px);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
}

.preview-remove:hover {
    background: var(--error);
    transform: scale(1.1);
}

.preview-remove i {
    font-size: 12px;
}

/* ===========================
   FORM FOOTER - TRANSPARENT
   =========================== */
.form-footer {
    padding: 24px 32px;
    background: transparent;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.footer-left {
    display: flex;
    gap: 12px;
}

.footer-right {
    display: flex;
    gap: 12px;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--error), #dc2626);
    color: white;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
}

.btn-secondary {
    background: transparent;
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--error);
}

.btn-outline {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-outline:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--error);
    color: var(--error);
}

/* ===========================
   LOADING STATE
   =========================== */
.btn.loading {
    position: relative;
    pointer-events: none;
}

.btn.loading::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 968px) {
    .form-grid.triple {
        grid-template-columns: repeat(2, 1fr);
    }

    .progress-steps {
        gap: 0;
    }

    .step-label {
        font-size: 11px;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        font-size: 14px;
    }
}

@media (max-width: 768px) {
    .form-header {
        padding: 24px;
    }

    .header-content {
        flex-direction: column;
        text-align: center;
    }

    .form-body {
        padding: 24px;
    }

    .form-grid,
    .form-grid.triple {
        grid-template-columns: 1fr;
    }

    .form-progress {
        padding: 24px 20px;
    }

    .progress-steps {
        flex-wrap: nowrap;
        overflow-x: auto;
        justify-content: flex-start;
        padding-bottom: 10px;
    }

    .progress-step {
        min-width: 80px;
    }

    .step-label {
        font-size: 10px;
    }

    .step-circle {
        width: 36px;
        height: 36px;
        font-size: 13px;
    }

    .form-footer {
        flex-direction: column;
        align-items: stretch;
    }

    .footer-left,
    .footer-right {
        width: 100%;
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .map-controls {
        flex-direction: column;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <a href="{{ url_for('missing_person.list_missing_persons') }}" class="breadcrumb-item">
            <span>Missing Persons</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>{{ form_title }}</span>
        </span>
    </div>

    <!-- Form Header -->
    <div class="form-header">
        <div class="header-content">
            <div class="header-icon">
                <i class="fas fa-{{ 'edit' if is_editing else 'user-plus' }}"></i>
            </div>
            <div class="header-text">
                <h1>{{ form_title }}</h1>
                <p>{{ 'Update information about this missing person case' if is_editing else 'Fill out the form below to report a missing person. Fields marked with * are required.' }}</p>
            </div>
        </div>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <!-- Progress Steps -->
        <div class="form-progress">
            <div class="progress-steps">
                <div class="progress-step active" data-step="1">
                    <div class="step-circle-wrapper">
                        <div class="step-circle">
                            <span>1</span>
                        </div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-label">Personal Info</div>
                </div>

                <div class="progress-step" data-step="2">
                    <div class="step-circle-wrapper">
                        <div class="step-circle">
                            <span>2</span>
                        </div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-label">Physical Details</div>
                </div>

                <div class="progress-step" data-step="3">
                    <div class="step-circle-wrapper">
                        <div class="step-circle">
                            <span>3</span>
                        </div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-label">Last Seen</div>
                </div>

                <div class="progress-step" data-step="4">
                    <div class="step-circle-wrapper">
                        <div class="step-circle">
                            <span>4</span>
                        </div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-label">Reporter Info</div>
                </div>

                <div class="progress-step" data-step="5">
                    <div class="step-circle-wrapper">
                        <div class="step-circle">
                            <span>5</span>
                        </div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-label">Photos</div>
                </div>
            </div>
        </div>

        <!-- Form -->
        <form id="missingPersonForm" method="POST" enctype="multipart/form-data"
              action="{{ url_for('missing_person.update_missing_person', missing_person_id=person.id) if is_editing else url_for('missing_person.create_missing_person') }}">

            <div class="form-body">
                <!-- Step 1: Personal Information -->
                <div class="form-step active" data-step="1">
                    <h2 class="step-title">Personal Information</h2>
                    <p class="step-description">Enter the basic personal details of the missing person.</p>

                    <div class="form-section">
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">
                                    First Name <span class="required">*</span>
                                </label>
                                <input type="text" name="first_name" class="form-control"
                                       placeholder="Enter first name" required
                                       value="{{ person.first_name if person.first_name else '' }}">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Last Name <span class="required">*</span>
                                </label>
                                <input type="text" name="last_name" class="form-control"
                                       placeholder="Enter last name" required
                                       value="{{ person.last_name if person.last_name else '' }}">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Date of Birth <span class="optional">(Optional)</span>
                                </label>
                                <input type="date" name="date_of_birth" class="form-control"
                                       value="{{ person.date_of_birth if person.date_of_birth else '' }}">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Gender <span class="optional">(Optional)</span>
                                </label>
                                <select name="gender" class="form-control">
                                    <option value="">Select gender</option>
                                    <option value="MALE" {% if person.gender == 'MALE' %}selected{% endif %}>Male</option>
                                    <option value="FEMALE" {% if person.gender == 'FEMALE' %}selected{% endif %}>Female</option>
                                    <option value="OTHER" {% if person.gender == 'OTHER' %}selected{% endif %}>Other</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Phone Number <span class="optional">(Optional)</span>
                                </label>
                                <div class="phone-input-wrapper">
                                    <div class="phone-prefix">+263</div>
                                    <input type="text" name="phone_number" id="phone_number" class="form-control"
                                           placeholder="77 123 4567"
                                           maxlength="12"
                                           value="{{ person.phone_number.replace('+263', '').strip() if person.phone_number else '' }}">
                                </div>
                                <span class="form-helper phone-format-hint" id="phoneHint">
                                    <i class="fas fa-info-circle"></i>
                                    Format: 77 123 4567
                                </span>
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Email <span class="optional">(Optional)</span>
                                </label>
                                <input type="email" name="email" class="form-control"
                                       placeholder="email@example.com"
                                       value="{{ person.email if person.email else '' }}">
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    National ID <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="national_id" class="form-control"
                                       placeholder="63-1234567A12"
                                       value="{{ person.national_id if person.national_id else '' }}">
                                <span class="form-helper">
                                    <i class="fas fa-info-circle"></i>
                                    Enter the national ID or passport number if known
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Physical Description -->
                <div class="form-step" data-step="2">
                    <h2 class="step-title">Physical Description</h2>
                    <p class="step-description">Provide physical characteristics to help identify the person.</p>

                    <div class="form-section">
                        <div class="form-grid triple">
                            <div class="form-group">
                                <label class="form-label">
                                    Height (cm) <span class="optional">(Optional)</span>
                                </label>
                                <input type="number" name="height" class="form-control"
                                       placeholder="170" step="0.1" min="0"
                                       value="{{ person.height if person.height else '' }}">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Weight (kg) <span class="optional">(Optional)</span>
                                </label>
