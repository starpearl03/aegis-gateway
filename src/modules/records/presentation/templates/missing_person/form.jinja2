                    </div>
                </div>

                <!-- Step 4: Reporter Information -->
                <div class="form-step" data-step="4">
                    <h2 class="step-title">Reporter Information</h2>
                    <p class="step-description">Who is reporting this missing person?</p>

                    <div class="form-section">
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">
                                    Reporter First Name <span class="required">*</span>
                                </label>
                                <input type="text" name="reporter_first_name" class="form-control"
                                       placeholder="Enter first name" required
                                       value="{{ person.reporter.first_name if person.reporter and person.reporter.first_name else '' }}">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Reporter Last Name <span class="required">*</span>
                                </label>
                                <input type="text" name="reporter_last_name" class="form-control"
