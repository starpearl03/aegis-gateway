                                       placeholder="e.g., Brown, Blue"
                                       value="{{ person.eye_color if person.eye_color else '' }}">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Skin Tone <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="skin_tone" class="form-control"
                                       placeholder="e.g., Fair, Medium"
                                       value="{{ person.skin_tone if person.skin_tone else '' }}">
                            </div>
