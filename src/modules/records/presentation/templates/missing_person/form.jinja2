// Get current location for last seen
function getCurrentLocation() {
    if (!navigator.geolocation) {
        if (window.toast) {
            window.toast.error('Not Supported', 'Geolocation is not supported by your browser');
        } else {
            alert('Geolocation is not supported by your browser');
        }
        return;
    }

    navigator.geolocation.getCurrentPosition(
        function(position) {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            lastSeenMap.setView([lat, lng], 15);

            if (lastSeenMarker) {
                lastSeenMap.removeLayer(lastSeenMarker);
            }

            lastSeenMarker = L.marker([lat, lng], {
                draggable: true
            }).addTo(lastSeenMap);

            updateLastSeenLocationFields(lat, lng);
            reverseGeocodeLastSeen(lat, lng);

            lastSeenMarker.on('dragend', function(e) {
                const position = lastSeenMarker.getLatLng();
                updateLastSeenLocationFields(position.lat, position.lng);
                reverseGeocodeLastSeen(position.lat, position.lng);
            });

            if (window.toast) {
                window.toast.success('Location Found', 'Your current location has been set');
            }
        },
        function(error) {
            console.error('Geolocation error:', error);
            if (window.toast) {
                window.toast.error('Location Error', 'Unable to retrieve your location. Please check your browser settings.');
            } else {
                alert('Unable to retrieve your location. Please check your browser settings.');
            }
        }
    );
}

