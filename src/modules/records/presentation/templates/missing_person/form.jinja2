                        </div>
                    </div>
                </div>

                <!-- Step 5: Photos -->
                <div class="form-step" data-step="5">
                    <h2 class="step-title">Upload Photos</h2>
                    <p class="step-description">Add photos of the missing person to help with identification.</p>

                    <div class="form-section">
                        <label class="form-label" style="margin-bottom: 16px;">
                            Photos <span class="optional">(Optional)</span>
                        </label>

                        <div class="image-upload-section" onclick="document.getElementById('imageInput').click()">
                            <div class="upload-icon">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>
                            <div class="upload-text">Click to upload photos</div>
                            <div class="upload-hint">PNG, JPG, JPEG or GIF (Max 5MB per file)</div>
                        </div>

                        <input type="file" id="imageInput" name="images" accept="image/*" multiple style="display: none;" onchange="previewImages(event)">

                        <div class="image-preview-grid" id="imagePreviewGrid"></div>

                        {% if is_editing and person_images and person_images|length > 0 %}
                        <div style="margin-top: 24px;">
                            <h4 style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 16px;">
                                Existing Photos
                            </h4>
                            <div class="image-preview-grid">
                                {% for image in person_images %}
                                <div class="preview-item">
                                    <img src="{{ image.image_path }}" alt="Photo {{ loop.index }}">
                                    {% if image.is_primary %}
                                    <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 6px; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); color: white; font-size: 10px; font-weight: 600; text-align: center;">
                                        Primary
                                    </div>
                                    {% endif %}
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Form Footer -->
            <div class="form-footer">
                <div class="footer-left">
                    <button type="button" class="btn btn-outline" id="prevBtn" onclick="changeStep(-1)" style="display: none;">
                        <i class="fas fa-arrow-left"></i>
                        Previous
                    </button>
                </div>
                <div class="footer-right">
                    <a href="{{ url_for('missing_person.list_missing_persons') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                        Cancel
                    </a>
                    <button type="button" class="btn btn-primary" id="nextBtn" onclick="changeStep(1)">
                        Next
                        <i class="fas fa-arrow-right"></i>
                    </button>
                    <button type="submit" class="btn btn-primary" id="submitBtn" style="display: none;">
                        <i class="fas fa-save"></i>
                        {{ 'Update Case' if is_editing else 'Report Missing Person' }}
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
let currentStep = 1;
const totalSteps = 5;
let uploadedImages = [];
let lastSeenMap;
let lastSeenMarker;
let reporterMap;
let reporterMarker;
let isSubmitting = false; // ← CRITICAL: Prevents duplicate form submissions

// Initialize form
document.addEventListener('DOMContentLoaded', function() {
    updateStepDisplay();
    initializeLastSeenMap();
    initializeReporterMap();
    initializePhoneFormatting();
});

// Phone number formatting function
function initializePhoneFormatting() {
    const phoneInputs = ['phone_number', 'reporter_phone'];

    phoneInputs.forEach(inputId => {
        const input = document.getElementById(inputId);
        const hint = document.getElementById(inputId === 'phone_number' ? 'phoneHint' : 'reporterPhoneHint');

        if (input) {
            input.addEventListener('input', function(e) {
                let value = e.target.value;

                // Remove all non-digit characters
                let cleaned = value.replace(/\D/g, '');

                // Format: 77 123 4567
                let formatted = '';

                if (cleaned.length > 0) {
                    formatted += cleaned.substring(0, 2);
                }
                if (cleaned.length > 2) {
                    formatted += ' ' + cleaned.substring(2, 5);
                }
                if (cleaned.length > 5) {
                    formatted += ' ' + cleaned.substring(5, 9);
                }

                e.target.value = formatted;

                // Validate format
                const isValid = /^\d{2}\s\d{3}\s\d{4}$/.test(formatted);

                if (hint) {
                    if (cleaned.length > 0 && !isValid && cleaned.length >= 9) {
                        hint.classList.add('error');
                        hint.innerHTML = '<i class="fas fa-exclamation-circle"></i> Invalid format. Use: 77 123 4567';
                    } else {
                        hint.classList.remove('error');
                        hint.innerHTML = '<i class="fas fa-info-circle"></i> Format: 77 123 4567';
                    }
                }
            });
        }
    });
}

// Initialize Last Seen Map
function initializeLastSeenMap() {
    // Default center (Harare, Zimbabwe)
    const defaultLat = {{ person.last_seen_location.latitude if person.last_seen_location and person.last_seen_location.latitude else '-17.8292' }};
    const defaultLng = {{ person.last_seen_location.longitude if person.last_seen_location and person.last_seen_location.longitude else '31.0522' }};

    // Initialize map
    lastSeenMap = L.map('lastSeenMap').setView([defaultLat, defaultLng], 13);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19
    }).addTo(lastSeenMap);

    // Add marker if editing with existing location
    {% if person.last_seen_location and person.last_seen_location.latitude %}
    lastSeenMarker = L.marker([defaultLat, defaultLng], {
        draggable: true
    }).addTo(lastSeenMap);

    lastSeenMarker.on('dragend', function(e) {
        const position = lastSeenMarker.getLatLng();
        updateLastSeenLocationFields(position.lat, position.lng);
        reverseGeocodeLastSeen(position.lat, position.lng);
    });
    {% endif %}

    // Add click event to map
    lastSeenMap.on('click', function(e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        // Remove existing marker if any
        if (lastSeenMarker) {
            lastSeenMap.removeLayer(lastSeenMarker);
        }

        // Add new marker
        lastSeenMarker = L.marker([lat, lng], {
            draggable: true
        }).addTo(lastSeenMap);

        // Update form fields
        updateLastSeenLocationFields(lat, lng);

        // Reverse geocode to get address
        reverseGeocodeLastSeen(lat, lng);

        // Add drag event
        lastSeenMarker.on('dragend', function(e) {
            const position = lastSeenMarker.getLatLng();
            updateLastSeenLocationFields(position.lat, position.lng);
            reverseGeocodeLastSeen(position.lat, position.lng);
        });
    });
}

// Initialize Reporter Map
function initializeReporterMap() {
    // Default center (Harare, Zimbabwe)
    const defaultLat = -17.8292;
    const defaultLng = 31.0522;

    // Initialize map
    reporterMap = L.map('reporterMap').setView([defaultLat, defaultLng], 13);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19
    }).addTo(reporterMap);

    // Add click event to map
    reporterMap.on('click', function(e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        // Remove existing marker if any
        if (reporterMarker) {
            reporterMap.removeLayer(reporterMarker);
        }

        // Add new marker
        reporterMarker = L.marker([lat, lng], {
            draggable: true
        }).addTo(reporterMap);

        // Update form fields
        updateReporterLocationFields(lat, lng);

        // Reverse geocode to get address
        reverseGeocodeReporter(lat, lng);

        // Add drag event
        reporterMarker.on('dragend', function(e) {
            const position = reporterMarker.getLatLng();
            updateReporterLocationFields(position.lat, position.lng);
            reverseGeocodeReporter(position.lat, position.lng);
        });
    });
}

// Update last seen location input fields
function updateLastSeenLocationFields(lat, lng) {
    document.getElementById('last_seen_latitude').value = lat.toFixed(6);
    document.getElementById('last_seen_longitude').value = lng.toFixed(6);
}

// Update reporter location input fields
function updateReporterLocationFields(lat, lng) {
    document.getElementById('reporter_latitude').value = lat.toFixed(6);
    document.getElementById('reporter_longitude').value = lng.toFixed(6);
}

// Reverse geocode last seen location
function reverseGeocodeLastSeen(lat, lng) {
    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
        .then(response => response.json())
        .then(data => {
            if (data.address) {
                document.getElementById('last_seen_address').value = data.display_name || '';
                document.getElementById('last_seen_city').value = data.address.city || data.address.town || data.address.village || '';
                document.getElementById('last_seen_state').value = data.address.state || data.address.province || '';
                document.getElementById('last_seen_country').value = data.address.country || '';
            }
        })
        .catch(error => {
            console.error('Reverse geocoding failed:', error);
        });
}

// Reverse geocode reporter location
function reverseGeocodeReporter(lat, lng) {
    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
        .then(response => response.json())
        .then(data => {
            if (data.address) {
                document.getElementById('reporter_address').value = data.display_name || '';
                document.getElementById('reporter_city').value = data.address.city || data.address.town || data.address.village || '';
                document.getElementById('reporter_state').value = data.address.state || data.address.province || '';
                document.getElementById('reporter_country').value = data.address.country || '';
            }
        })
        .catch(error => {
            console.error('Reverse geocoding failed:', error);
        });
}

// Search location on last seen map
function searchLocationOnMap() {
    const searchQuery = document.getElementById('searchLocation').value;

    if (!searchQuery.trim()) {
        if (window.toast) {
            window.toast.warning('Input Required', 'Please enter a location to search');
        } else {
            alert('Please enter a location to search');
        }
        return;
    }

    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(searchQuery)}`)
        .then(response => response.json())
        .then(data => {
            if (data && data.length > 0) {
                const result = data[0];
                const lat = parseFloat(result.lat);
                const lng = parseFloat(result.lon);

                lastSeenMap.setView([lat, lng], 15);

                if (lastSeenMarker) {
                    lastSeenMap.removeLayer(lastSeenMarker);
                }

                lastSeenMarker = L.marker([lat, lng], {
                    draggable: true
                }).addTo(lastSeenMap);

                updateLastSeenLocationFields(lat, lng);
                reverseGeocodeLastSeen(lat, lng);

                lastSeenMarker.on('dragend', function(e) {
                    const position = lastSeenMarker.getLatLng();
                    updateLastSeenLocationFields(position.lat, position.lng);
                    reverseGeocodeLastSeen(position.lat, position.lng);
                });

                if (window.toast) {
                    window.toast.success('Location Found', 'Click on the map to adjust the exact position');
                }
            } else {
                if (window.toast) {
                    window.toast.error('Not Found', 'Location not found. Try a different search term.');
                } else {
                    alert('Location not found. Try a different search term.');
                }
            }
        })
        .catch(error => {
            console.error('Geocoding failed:', error);
            if (window.toast) {
                window.toast.error('Search Failed', 'Failed to search location. Please try again.');
            } else {
                alert('Failed to search location. Please try again.');
            }
        });
}

