                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Additional Description <span class="optional">(Optional)</span>
                                </label>
                                <textarea name="description" class="form-control"
                                          placeholder="Any additional information about the person..."
                                          rows="3">{{ person.description if person.description else '' }}</textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Last Seen Information -->
                <div class="form-step" data-step="3">
                    <h2 class="step-title">Last Seen Information</h2>
                    <p class="step-description">When and where was the person last seen?</p>

                    <div class="form-section">
                        <h3 class="section-title">
                            <i class="fas fa-calendar-alt"></i>
