                        </h3>

                        <!-- Reporter Map Container -->
                        <div class="form-group full-width">
                            <label class="form-label">
                                Select Reporter Location on Map
                            </label>
                            <div id="reporterMap" class="map-container"></div>
                            <div class="map-controls">
                                <input type="text" id="searchReporterLocation" class="form-control"
                                       placeholder="Search for reporter's location (e.g., Harare CBD, Zimbabwe)">
                                <button type="button" class="btn-map" onclick="searchReporterLocationOnMap()">
                                    <i class="fas fa-search"></i>
                                    Search
                                </button>
                                <button type="button" class="btn-map" onclick="getReporterCurrentLocation()">
                                    <i class="fas fa-crosshairs"></i>
                                    My Location
                                </button>
                            </div>
                            <span class="form-helper">
                                <i class="fas fa-info-circle"></i>
                                Click on the map to select the reporter's location or search for an address
                            </span>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">
                                    Latitude <span class="optional">(Optional)</span>
                                </label>
                                <input type="number" name="reporter_latitude" id="reporter_latitude" class="form-control"
                                       placeholder="-17.8292" step="any" readonly>
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Longitude <span class="optional">(Optional)</span>
                                </label>
                                <input type="number" name="reporter_longitude" id="reporter_longitude" class="form-control"
                                       placeholder="31.0522" step="any" readonly>
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Address <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="reporter_address" id="reporter_address" class="form-control"
                                       placeholder="Street address">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    City <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="reporter_city" id="reporter_city" class="form-control"
                                       placeholder="Harare">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    State/Province <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="reporter_state" id="reporter_state" class="form-control"
                                       placeholder="Harare Province">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Country <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="reporter_country" id="reporter_country" class="form-control"
                                       placeholder="Zimbabwe">
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Postal Code <span class="optional">(Optional)</span>
                                </label>
                                <input type="text" name="reporter_postal_code" class="form-control"
                                       placeholder="00000000" value="00000000">
