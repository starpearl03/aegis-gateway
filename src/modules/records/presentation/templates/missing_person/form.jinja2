                        </h3>
                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Last Seen Date <span class="required">*</span>
                                </label>
                                <input type="datetime-local" name="last_seen_date" class="form-control" required
                                       value="{{ person.last_seen_date if person.last_seen_date else '' }}">
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="section-title">
                            <i class="fas fa-map-marker-alt"></i>
