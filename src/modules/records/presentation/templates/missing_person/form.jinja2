                                    <option value="SPOUSE" {% if person.reporter and person.reporter.relationship == 'SPOUSE' %}selected{% endif %}>Spouse</option>
                                    <option value="SIBLING" {% if person.reporter and person.reporter.relationship == 'SIBLING' %}selected{% endif %}>Sibling</option>
                                    <option value="CHILD" {% if person.reporter and person.reporter.relationship == 'CHILD' %}selected{% endif %}>Child</option>
                                    <option value="FRIEND" {% if person.reporter and person.reporter.relationship == 'FRIEND' %}selected{% endif %}>Friend</option>
                                    <option value="RELATIVE" {% if person.reporter and person.reporter.relationship == 'RELATIVE' %}selected{% endif %}>Other Relative</option>
                                    <option value="OTHER" {% if person.reporter and person.reporter.relationship == 'OTHER' %}selected{% endif %}>Other</option>
