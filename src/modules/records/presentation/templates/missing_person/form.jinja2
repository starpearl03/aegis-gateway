                        <div class="form-grid single">
                            <div class="form-group">
                                <label class="form-label">
                                    Distinctive Features <span class="optional">(Optional)</span>
                                </label>
                                <textarea name="distinctive_features" class="form-control"
                                          placeholder="Scars, tattoos, birthmarks, or other identifying features..."
                                          rows="3">{{ person.distinctive_features if person.distinctive_features else '' }}</textarea>
                                <span class="form-helper">
                                    <i class="fas fa-info-circle"></i>
