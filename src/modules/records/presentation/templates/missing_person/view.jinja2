{% extends 'base.jinja2' %}

{% set person = missing_person if missing_person else {} %}
{% set person_images = images if images else [] %}
{% set last_seen_loc = person.last_seen_location if person and person.last_seen_location else {} %}
{% set found_loc = person.found_location if person and person.found_location else {} %}
{% set reporter_info = person.reporter if person and person.reporter else {} %}

{% block title %}{{ person.first_name }} {{ person.last_name }} | Missing Person | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   MODERN CENTERED LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--error);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   HERO HEADER - REDESIGNED CENTERED LAYOUT
   =========================== */
.hero-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
}

.hero-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--error), #dc2626);
}

.hero-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 30px;
    padding: 30px;
    align-items: center;
}

/* Left Stats Section */
.stats-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-right: 20px;
}

.stat-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    background: rgba(10, 14, 39, 0.3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    transition: var(--transition);
}

.stat-item:hover {
    border-color: var(--error);
    transform: translateY(-2px);
}

.stat-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
}

/* Center Photo Section */
.photo-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 280px;
    margin: 0 auto;
}

.main-photo-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
}

.main-photo {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.15));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    color: var(--error);
    font-weight: 700;
    overflow: hidden;
    border: 3px solid var(--border);
    position: relative;
    cursor: pointer;
    transition: var(--transition);
}

.main-photo:hover {
    border-color: var(--error);
    transform: scale(1.02);
}

.main-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.status-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    backdrop-filter: blur(10px);
}

.status-overlay.missing {
    background: rgba(239, 68, 68, 0.9);
    color: white;
}

.status-overlay.found {
    background: rgba(16, 185, 129, 0.9);
    color: white;
}

.status-overlay.deceased {
    background: rgba(100, 116, 139, 0.9);
    color: white;
}

.person-info-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.person-name {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.5px;
    line-height: 1.1;
}

.title-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
}

.info-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    background: rgba(10, 14, 39, 0.4);
    color: var(--text-secondary);
    border: 1px solid var(--border);
}

.info-badge i {
    font-size: 10px;
    color: var(--error);
}

/* Mini Gallery */
.mini-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    width: 100%;
}

.mini-gallery-item {
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: rgba(10, 14, 39, 0.4);
    border: 1px solid var(--border);
    transition: var(--transition);
}

.mini-gallery-item:hover {
    transform: scale(1.05);
    border-color: var(--error);
}

.mini-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.mini-gallery-more {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    background: rgba(239, 68, 68, 0.1);
}

/* Right Stats Section */
.stats-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-left: 20px;
}

/* Action Buttons */
.action-group-center {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 8px;
}

.btn {
    padding: 10px 18px;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    justify-content: center;
}

.btn i {
    font-size: 13px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--error), #dc2626);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--error);
}

/* ===========================
   ALERT BANNER - COMPACT
   =========================== */
.alert-banner {
    padding: 14px 18px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 12px;
    backdrop-filter: blur(10px);
    border: 1px solid;
}

.alert-banner.danger {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.3);
}

.alert-banner.success {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.3);
}

.alert-banner-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 14px;
}

.alert-banner.danger .alert-banner-icon {
    background: var(--error);
    color: white;
}

.alert-banner.success .alert-banner-icon {
    background: var(--success);
    color: white;
}

.alert-banner-content {
    flex: 1;
}

.alert-banner-title {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 2px;
}

.alert-banner.danger .alert-banner-title {
    color: var(--error);
}

.alert-banner.success .alert-banner-title {
    color: var(--success);
}

.alert-banner-text {
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-secondary);
}

/* ===========================
   CONTENT LAYOUT - 2 COLUMNS
   =========================== */
.content-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 20px;
    align-items: start;
}

.main-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.side-column {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ===========================
   CARD COMPONENT - COMPACT
   =========================== */
.card {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.card-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    background: transparent;
}

.card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
}

.card-title i {
    font-size: 16px;
    color: var(--error);
}

.card-body {
    padding: 20px;
}

.card-body.compact {
    padding: 16px;
}

/* ===========================
   INFO ROWS - TIGHTER
   =========================== */
.info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.info-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 13px;
    color: var(--text-primary);
    line-height: 1.4;
}

.info-value.empty {
    color: var(--text-muted);
    font-style: italic;
}

.info-divider {
    height: 1px;
    background: var(--border-light);
    margin: 16px 0;
}

/* ===========================
   LOCATION CARDS - MODERN
   =========================== */
.location-card {
    padding: 16px;
    background: rgba(10, 14, 39, 0.3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: 12px;
}

.location-card:last-child {
    margin-bottom: 0;
}

.location-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-light);
}

.location-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
}

.location-icon.last-seen {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
}

.location-icon.found {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
}

.location-info {
    flex: 1;
}

.location-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
}

.location-date {
    font-size: 11px;
    color: var(--text-secondary);
}

.location-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.location-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
}

.location-row i {
    color: var(--text-muted);
    font-size: 11px;
    margin-top: 2px;
    width: 14px;
}

.location-row-value {
    color: var(--text-primary);
    line-height: 1.4;
}

/* ===========================
   GALLERY - MASONRY STYLE
   =========================== */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
}

.gallery-item {
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    position: relative;
    background: rgba(10, 14, 39, 0.3);
    border: 1px solid var(--border);
    transition: var(--transition);
}

.gallery-item:hover {
    transform: translateY(-4px);
    border-color: var(--error);
    box-shadow: var(--shadow-md);
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.gallery-item.primary::before {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    background: var(--error);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
}

.gallery-item.primary::after {
    content: '⭐';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}

.no-images {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-muted);
}

.no-images i {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.3;
}

.no-images p {
    font-size: 13px;
    margin: 0;
}

/* ===========================
   ACTION BUTTONS - COMPACT
   =========================== */
.btn-success {
    background: linear-gradient(135deg, var(--success), #059669);
    color: white;
}

.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-danger {
    background: transparent;
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.btn-danger:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: var(--error);
}

.btn-block {
    width: 100%;
}

.action-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* ===========================
   TIMELINE - COMPACT
   =========================== */
.timeline-item {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-light);
}

.timeline-item:last-child {
    border-bottom: none;
}

.timeline-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--error);
    font-size: 13px;
}

.timeline-content {
    flex: 1;
}

.timeline-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.timeline-value {
    font-size: 12px;
    color: var(--text-primary);
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 1200px) {
    .content-layout {
        grid-template-columns: 1fr 320px;
    }
}

@media (max-width: 968px) {
    .hero-content {
        grid-template-columns: 1fr;
        gap: 24px;
        text-align: center;
    }

    .stats-left,
    .stats-right {
        padding: 0;
        order: 3;
    }

    .photo-center {
        order: 1;
        max-width: 240px;
    }

    .stats-left,
    .stats-right {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .content-layout {
        grid-template-columns: 1fr;
    }

    .side-column {
        position: static;
    }
}

@media (max-width: 768px) {
    .hero-content {
        padding: 20px;
    }

    .stats-left,
    .stats-right {
        grid-template-columns: 1fr;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .mini-gallery {
        grid-template-columns: repeat(2, 1fr);
    }

    .action-group-center {
        flex-direction: column;
        align-items: center;
    }

    .btn {
        width: 100%;
        max-width: 200px;
    }
}

/* ===========================
   PRINT STYLES
   =========================== */
@media print {
    .side-column,
    .action-group-center,
    .btn {
        display: none !important;
    }

    .content-layout {
        grid-template-columns: 1fr;
    }

    .stats-left,
    .stats-right {
        display: none !important;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <a href="{{ url_for('missing_person.list_missing_persons') }}" class="breadcrumb-item">
            <span>Missing Persons</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>{{ person.first_name }} {{ person.last_name }}</span>
        </span>
    </div>

    <!-- Hero Header - Redesigned -->
    <div class="hero-header">
        <div class="hero-content">
            <!-- Left Stats Section -->
            <div class="stats-left">
                <div class="stat-group">
                    {% if person.last_seen_date %}
                    <div class="stat-item">
                        <div class="stat-label">Last Seen</div>
                        <div class="stat-value">{{ person.last_seen_date[:10] if person.last_seen_date else 'Unknown' }}</div>
                    </div>
                    {% endif %}

                    {% if person.age %}
                    <div class="stat-item">
                        <div class="stat-label">Age</div>
                        <div class="stat-value">{{ person.age }} years</div>
                    </div>
                    {% endif %}

                    {% if person.gender %}
                    <div class="stat-item">
                        <div class="stat-label">Gender</div>
                        <div class="stat-value">{{ person.gender }}</div>
                    </div>
                    {% endif %}
                </div>

                <div class="stat-group">
                    {% if person.height %}
                    <div class="stat-item">
                        <div class="stat-label">Height</div>
                        <div class="stat-value">{{ person.height }} cm</div>
                    </div>
                    {% endif %}

                    {% if person.weight %}
                    <div class="stat-item">
                        <div class="stat-label">Weight</div>
                        <div class="stat-value">{{ person.weight }} kg</div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Center Photo Section -->
            <div class="photo-center">
                <div class="main-photo-container">
                    <div class="main-photo">
                        {% if person_images and person_images|length > 0 %}
                            {% set primary_image = person_images|selectattr('is_primary')|first %}
                            {% if primary_image %}
                                <img src="{{ url_for('uploads', filename=primary_image.image_path|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                            {% else %}
                                <img src="{{ url_for('uploads', filename=person_images[0].image_path|image_url) }}" alt="{{ person.first_name }} {{ person.last_name }}">
                            {% endif %}
                        {% else %}
                            {{ person.first_name[0] if person.first_name else 'U' }}{{ person.last_name[0] if person.last_name else 'N' }}
                        {% endif %}
                        <span class="status-overlay {{ person.status|lower if person.status else 'missing' }}">
                            {{ person.status if person.status else 'MISSING' }}
                        </span>
                    </div>
                </div>

                <div class="person-info-center">
                    <h1 class="person-name">{{ person.first_name }} {{ person.last_name }}</h1>
                    <div class="title-badges">
                        {% if person.national_id %}
                        <span class="info-badge">
                            <i class="fas fa-id-card"></i>
                            ID: {{ person.national_id }}
                        </span>
                        {% endif %}
                        {% if person.phone_number %}
                        <span class="info-badge">
                            <i class="fas fa-phone"></i>
                            {{ person.phone_number }}
                        </span>
                        {% endif %}
                    </div>
                </div>

                <div class="action-group-center">
                    <a href="{{ url_for('missing_person.missing_person_form', missing_person_id=person.id) }}" class="btn btn-secondary">
                        <i class="fas fa-edit"></i>
                        Edit
                    </a>
                    <button class="btn btn-primary" onclick="window.print()">
                        <i class="fas fa-print"></i>
                        Print
                    </button>
                </div>

                {% if person_images and person_images|length > 1 %}
                <div class="mini-gallery">
                    {% for image in person_images[1:4] %}
                    <div class="mini-gallery-item">
                        <img src="{{ url_for('uploads', filename=image.image_path|image_url) }}" alt="Photo {{ loop.index + 1 }}">
                    </div>
                    {% endfor %}
                    {% if person_images|length > 4 %}
                    <div class="mini-gallery-item mini-gallery-more">
                        +{{ person_images|length - 4 }}
                    </div>
                    {% endif %}
                </div>
                {% endif %}
            </div>

            <!-- Right Stats Section -->
            <div class="stats-right">
                <div class="stat-group">
                    {% if person.hair_color %}
                    <div class="stat-item">
                        <div class="stat-label">Hair Color</div>
                        <div class="stat-value">{{ person.hair_color }}</div>
                    </div>
                    {% endif %}

                    {% if person.eye_color %}
                    <div class="stat-item">
                        <div class="stat-label">Eye Color</div>
                        <div class="stat-value">{{ person.eye_color }}</div>
                    </div>
                    {% endif %}

                    {% if person.skin_tone %}
                    <div class="stat-item">
                        <div class="stat-label">Skin Tone</div>
                        <div class="stat-value">{{ person.skin_tone }}</div>
                    </div>
                    {% endif %}
                </div>

                <div class="stat-group">
                    {% if person.date_of_birth %}
                    <div class="stat-item">
                        <div class="stat-label">Date of Birth</div>
                        <div class="stat-value">{{ person.date_of_birth }}</div>
                    </div>
                    {% endif %}

                    {% if person.created_at %}
                    <div class="stat-item">
                        <div class="stat-label">Reported</div>
                        <div class="stat-value">{{ person.created_at[:10] }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Banner -->
    {% if person.status == 'MISSING' %}
    <div class="alert-banner danger">
        <div class="alert-banner-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="alert-banner-content">
            <div class="alert-banner-title">Active Missing Person Case</div>
            <div class="alert-banner-text">
                Missing since {{ person.last_seen_date[:10] if person.last_seen_date else 'unknown date' }}. Contact authorities if you have information.
            </div>
        </div>
    </div>
    {% elif person.status == 'FOUND' %}
    <div class="alert-banner success">
        <div class="alert-banner-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="alert-banner-content">
            <div class="alert-banner-title">Person Found</div>
            <div class="alert-banner-text">
                Found on {{ person.found_date[:10] if person.found_date else 'unknown date' }}{% if person.found_condition %} - {{ person.found_condition }}{% endif %}.
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Content Layout -->
    <div class="content-layout">
        <!-- Main Column -->
        <div class="main-column">
            <!-- Personal Information -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-user"></i>
                        Personal Information
                    </h2>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Full Name</div>
                            <div class="info-value">{{ person.first_name }} {{ person.last_name }}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Date of Birth</div>
                            <div class="info-value {{ 'empty' if not person.date_of_birth else '' }}">
                                {{ person.date_of_birth if person.date_of_birth else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Gender</div>
                            <div class="info-value {{ 'empty' if not person.gender else '' }}">
                                {{ person.gender if person.gender else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Age</div>
                            <div class="info-value {{ 'empty' if not person.age else '' }}">
                                {{ person.age ~ ' years' if person.age else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Phone Number</div>
                            <div class="info-value {{ 'empty' if not person.phone_number else '' }}">
                                {{ person.phone_number if person.phone_number else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Email</div>
                            <div class="info-value {{ 'empty' if not person.email else '' }}">
                                {{ person.email if person.email else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">National ID</div>
                            <div class="info-value {{ 'empty' if not person.national_id else '' }}">
                                {{ person.national_id if person.national_id else 'Not provided' }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Physical Description -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-ruler-combined"></i>
                        Physical Description
                    </h2>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Height</div>
                            <div class="info-value {{ 'empty' if not person.height else '' }}">
                                {{ person.height ~ ' cm' if person.height else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Weight</div>
                            <div class="info-value {{ 'empty' if not person.weight else '' }}">
                                {{ person.weight ~ ' kg' if person.weight else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Hair Color</div>
                            <div class="info-value {{ 'empty' if not person.hair_color else '' }}">
                                {{ person.hair_color if person.hair_color else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Eye Color</div>
                            <div class="info-value {{ 'empty' if not person.eye_color else '' }}">
                                {{ person.eye_color if person.eye_color else 'Not provided' }}
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Skin Tone</div>
                            <div class="info-value {{ 'empty' if not person.skin_tone else '' }}">
                                {{ person.skin_tone if person.skin_tone else 'Not provided' }}
                            </div>
                        </div>
                    </div>
                    {% if person.distinctive_features %}
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Distinctive Features</div>
                        <div class="info-value">{{ person.distinctive_features }}</div>
                    </div>
                    {% endif %}
                    {% if person.description %}
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Additional Description</div>
                        <div class="info-value">{{ person.description }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Case Information -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-file-alt"></i>
                        Case Information
                    </h2>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Case Status</div>
                            <div class="info-value">{{ person.status if person.status else 'MISSING' }}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Reported Date</div>
                            <div class="info-value">{{ person.created_at[:10] if person.created_at else 'Unknown' }}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Last Updated</div>
                            <div class="info-value">{{ person.updated_at if person.updated_at else 'Never' }}</div>
                        </div>
                        {% if person.found_date %}
                        <div class="info-item">
                            <div class="info-label">Found Date</div>
                            <div class="info-value">{{ person.found_date[:10] }}</div>
                        </div>
                        {% endif %}
                        {% if person.assigned_officer_id %}
                        <div class="info-item">
                            <div class="info-label">Assigned Officer</div>
                            <div class="info-value">{{ person.assigned_officer_id }}</div>
                        </div>
                        {% endif %}
                    </div>
                    {% if person.circumstances %}
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Circumstances</div>
                        <div class="info-value">{{ person.circumstances }}</div>
                    </div>
                    {% endif %}
                    {% if person.found_condition %}
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Found Condition</div>
                        <div class="info-value">{{ person.found_condition }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Photo Gallery -->
            {% if person_images and person_images|length > 0 %}
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-images"></i>
                        Photo Gallery ({{ person_images|length }})
                    </h2>
                </div>
                <div class="card-body">
                    <div class="gallery-grid">
                        {% for image in person_images %}
                        <div class="gallery-item {{ 'primary' if image.is_primary else '' }}" onclick="viewImage('{{ url_for('uploads', filename=image.image_path|image_url) }}')">
                            <img src="{{ url_for('uploads', filename=image.image_path|image_url) }}" alt="Photo {{ loop.index }}">
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% else %}
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-images"></i>
                        Photo Gallery
                    </h2>
                </div>
                <div class="card-body">
                    <div class="no-images">
                        <i class="fas fa-image"></i>
                        <p>No photos available</p>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Side Column -->
        <div class="side-column">
            <!-- Locations -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-map-marker-alt"></i>
                        Locations
                    </h2>
                </div>
                <div class="card-body compact">
                    <!-- Last Seen Location -->
                    {% if last_seen_loc %}
                    <div class="location-card">
                        <div class="location-header">
                            <div class="location-icon last-seen">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="location-info">
                                <div class="location-title">Last Seen</div>
                                <div class="location-date">{{ person.last_seen_date[:10] if person.last_seen_date else 'Unknown' }}</div>
                            </div>
                        </div>
                        <div class="location-details">
                            {% if last_seen_loc.address %}
                            <div class="location-row">
                                <i class="fas fa-home"></i>
                                <span class="location-row-value">{{ last_seen_loc.address }}</span>
                            </div>
                            {% endif %}
                            {% if last_seen_loc.city %}
                            <div class="location-row">
                                <i class="fas fa-city"></i>
                                <span class="location-row-value">
                                    {{ last_seen_loc.city }}{% if last_seen_loc.state %}, {{ last_seen_loc.state }}{% endif %}
                                </span>
                            </div>
                            {% endif %}
                            {% if last_seen_loc.country %}
                            <div class="location-row">
                                <i class="fas fa-globe"></i>
                                <span class="location-row-value">{{ last_seen_loc.country }}</span>
                            </div>
                            {% endif %}
                            {% if last_seen_loc.latitude and last_seen_loc.longitude %}
                            <div class="location-row">
                                <i class="fas fa-map-pin"></i>
                                <span class="location-row-value">{{ last_seen_loc.latitude }}, {{ last_seen_loc.longitude }}</span>
                            </div>
                            {% endif %}
                            {% if last_seen_loc.description %}
                            <div class="location-row">
                                <i class="fas fa-info-circle"></i>
                                <span class="location-row-value">{{ last_seen_loc.description }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    <!-- Found Location -->
                    {% if person.status == 'FOUND' and found_loc %}
                    <div class="location-card">
                        <div class="location-header">
                            <div class="location-icon found">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="location-info">
                                <div class="location-title">Found</div>
                                <div class="location-date">{{ person.found_date[:10] if person.found_date else 'Unknown' }}</div>
                            </div>
                        </div>
                        <div class="location-details">
                            {% if found_loc.address %}
                            <div class="location-row">
                                <i class="fas fa-home"></i>
                                <span class="location-row-value">{{ found_loc.address }}</span>
                            </div>
                            {% endif %}
                            {% if found_loc.city %}
                            <div class="location-row">
                                <i class="fas fa-city"></i>
                                <span class="location-row-value">
                                    {{ found_loc.city }}{% if found_loc.state %}, {{ found_loc.state }}{% endif %}
                                </span>
                            </div>
                            {% endif %}
                            {% if found_loc.country %}
                            <div class="location-row">
                                <i class="fas fa-globe"></i>
                                <span class="location-row-value">{{ found_loc.country }}</span>
                            </div>
                            {% endif %}
                            {% if person.found_condition %}
                            <div class="location-row">
                                <i class="fas fa-heartbeat"></i>
                                <span class="location-row-value">Condition: {{ person.found_condition }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    {% if not last_seen_loc and not (person.status == 'FOUND' and found_loc) %}
                    <div class="no-images">
                        <i class="fas fa-map-marker-alt"></i>
                        <p>No location information</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Reporter Information -->
            {% if reporter_info %}
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-user-tie"></i>
                        Reporter
                    </h2>
                </div>
                <div class="card-body compact">
                    <div class="info-item">
                        <div class="info-label">Name</div>
                        <div class="info-value">{{ reporter_info.first_name }} {{ reporter_info.last_name }}</div>
                    </div>
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Relationship</div>
                        <div class="info-value {{ 'empty' if not reporter_info.relationship else '' }}">
                            {{ reporter_info.relationship if reporter_info.relationship else 'Not specified' }}
                        </div>
                    </div>
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Phone</div>
                        <div class="info-value {{ 'empty' if not reporter_info.phone else '' }}">
                            {{ reporter_info.phone if reporter_info.phone else 'Not provided' }}
                        </div>
                    </div>
                    {% if reporter_info.email %}
                    <div class="info-divider"></div>
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value">{{ reporter_info.email }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            <!-- Timeline -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-clock"></i>
                        Timeline
                    </h2>
                </div>
                <div class="card-body compact">
                    <div class="timeline-item">
                        <div class="timeline-icon">
                            <i class="fas fa-plus"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="timeline-label">Reported</div>
                            <div class="timeline-value">{{ person.created_at if person.created_at else 'Unknown' }}</div>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-icon">
                            <i class="fas fa-edit"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="timeline-label">Last Updated</div>
                            <div class="timeline-value">{{ person.updated_at if person.updated_at else 'Never' }}</div>
                        </div>
                    </div>
                    {% if person.found_date %}
                    <div class="timeline-item">
                        <div class="timeline-icon">
                            <i class="fas fa-check"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="timeline-label">Found</div>
                            <div class="timeline-value">{{ person.found_date }}</div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Actions -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <i class="fas fa-cog"></i>
                        Actions
                    </h2>
                </div>
                <div class="card-body compact">
                    <div class="action-stack">
                        {% if person.status == 'MISSING' %}
                        <button class="btn btn-success btn-block" onclick="updateStatus('{{ person.id }}', 'FOUND')">
                            <i class="fas fa-check-circle"></i>
                            Mark as Found
                        </button>
                        {% endif %}

                        <a href="{{ url_for('missing_person.missing_person_form', missing_person_id=person.id) }}" class="btn btn-secondary btn-block">
                            <i class="fas fa-edit"></i>
                            Edit Information
                        </a>

                        <button class="btn btn-secondary btn-block" onclick="window.print()">
                            <i class="fas fa-print"></i>
                            Print Poster
                        </button>

                        <a href="{{ url_for('missing_person.list_missing_persons') }}" class="btn btn-secondary btn-block">
                            <i class="fas fa-arrow-left"></i>
                            Back to List
                        </a>

                        <button class="btn btn-danger btn-block" onclick="deletePerson('{{ person.id }}', '{{ person.first_name }} {{ person.last_name }}')">
                            <i class="fas fa-trash-alt"></i>
                            Delete Case
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// View Image in Modal/Fullscreen
function viewImage(imageUrl) {
    window.open(imageUrl, '_blank');
}

// Update Status Function
async function updateStatus(personId, newStatus) {
    const notes = prompt(`Enter any notes for marking this person as ${newStatus}:`);
    if (notes === null) return; // User cancelled

    const formData = new FormData();
    formData.append('status', newStatus);
    if (notes) formData.append('notes', notes);

    try {
        const response = await fetch(`/missing-persons/${personId}/update-status`, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.error) {
            if (window.toast) {
                window.toast.error('Error', data.message || 'Failed to update status');
            } else {
                alert('Error: ' + (data.message || 'Failed to update status'));
            }
        } else {
            if (window.toast) {
                window.toast.success('Success', data.message || 'Status updated successfully');
            } else {
                alert('Success: ' + (data.message || 'Status updated successfully'));
            }
            setTimeout(() => window.location.reload(), 1000);
        }
    } catch (error) {
        console.error('Error:', error);
        if (window.toast) {
            window.toast.error('Error', 'Failed to update status');
        } else {
            alert('Error: Failed to update status');
        }
    }
}

// Delete Person Function
async function deletePerson(personId, personName) {
    if (!confirm(`Are you sure you want to delete the case for "${personName}"?\n\nThis action cannot be undone.`)) {
        return;
    }

    try {
        const response = await fetch(`/missing-persons/${personId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            const errorMessage = data.message ||
                               (data.error && data.error.details && data.error.details[0]) ||
                               'Failed to delete case';
            throw new Error(errorMessage);
        }

        // Success
        if (window.toast) {
            window.toast.success('Success', data.message || 'Case deleted successfully');
        } else {
            alert('Success: Case deleted successfully');
        }

        // Redirect after short delay
        setTimeout(() => {
            window.location.href = '{{ url_for("missing_person.list_missing_persons") }}';
        }, 1000);

    } catch (error) {
        console.error('Delete error:', error);

        if (window.toast) {
            window.toast.error('Error', error.message || 'Failed to delete case');
        } else {
            alert('Error: ' + (error.message || 'Failed to delete case'));
        }
    }
}

// Animate on load
document.addEventListener('DOMContentLoaded', function() {
    const cards = document.querySelectorAll('.card');
    cards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';

        setTimeout(() => {
            card.style.transition = 'all 0.4s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, 50 * index);
    });
});

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    // E key for edit
    if (e.key === 'e' || e.key === 'E') {
        if (!e.target.matches('input, textarea, select')) {
            window.location.href = '{{ url_for("missing_person.missing_person_form", missing_person_id=person.id) }}';
        }
    }

    // P key for print
    if (e.key === 'p' || e.key === 'P') {
        if (!e.target.matches('input, textarea, select')) {
            e.preventDefault();
            window.print();
        }
    }

    // ESC or B key to go back
    if (e.key === 'Escape' || e.key === 'b' || e.key === 'B') {
        if (!e.target.matches('input, textarea, select')) {
            window.location.href = '{{ url_for("missing_person.list_missing_persons") }}';
        }
    }
});
</script>
{% endblock %}