    box-shadow: var(--shadow-lg);
    z-index: 1000;
    transition: var(--transition);
    align-items: center;
    justify-content: center;
">
    <i class="fas fa-arrow-up"></i>
</button>

<style>
#scrollToTop:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), var(--shadow-gold-subtle);
}

