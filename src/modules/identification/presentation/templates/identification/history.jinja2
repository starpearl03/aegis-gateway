{% extends 'base.jinja2' %}

{% set searches_list = searches if searches else [] %}
{% set pagination_data = pagination if pagination else {} %}
{% set filters_data = filters if filters else {} %}
{% set current_search_type = filters_data.search_type if filters_data.search_type else '' %}
{% set current_status = filters_data.status if filters_data.status else '' %}
{% set include_deleted = filters_data.include_deleted if filters_data.include_deleted else false %}

{% block title %}Search History | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   PAGE LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   PAGE HEADER
   =========================== */
.page-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: relative;
    z-index: 1;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

.header-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(184, 134, 11, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--border-gold);
}

.header-icon i {
    font-size: 28px;
    color: var(--primary-gold);
}

.header-text h1 {
    font-size: 26px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
}

.header-actions {
    display: flex;
    gap: 12px;
}

/* ===========================
   FILTERS SECTION
   =========================== */
.filters-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.filters-header {
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}

.filters-title i {
    color: var(--primary-gold);
    font-size: 18px;
}

.clear-filters-btn {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 6px;
}

.clear-filters-btn:hover {
    color: var(--primary-gold);
}

.filters-body {
    padding: 24px;
}

.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-control {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: #ffffff;
    transition: var(--transition-fast);
    font-family: inherit;
}

.filter-control:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

.filter-control option {
    background: var(--bg-tertiary);
    color: #ffffff;
}

.checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition);
}

.checkbox-wrapper:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
}

.checkbox-wrapper input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.checkbox-label {
    font-size: 14px;
    color: var(--text-primary);
    cursor: pointer;
}

.filter-actions {
    display: flex;
    gap: 12px;
}

/* ===========================
   HISTORY LIST
   =========================== */
.history-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.history-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.history-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}

.history-title i {
    color: var(--primary-gold);
    font-size: 20px;
}

.history-count {
    font-size: 13px;
    color: var(--text-muted);
    padding: 6px 12px;
    background: rgba(10, 14, 39, 0.4);
    border-radius: var(--radius-md);
}

.history-body {
    padding: 24px;
}

.history-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
}

/* ===========================
   SEARCH CARD
   =========================== */
.search-card {
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    cursor: pointer;
}

.search-card:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.search-card-body {
    padding: 20px 24px;
}

.search-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 16px;
}

.search-info {
    flex: 1;
    min-width: 0;
}

.search-id {
    font-size: 11px;
    color: var(--text-muted);
    font-family: monospace;
    margin-bottom: 6px;
}

.search-type-badge {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 8px;
}

.search-type-badge.criminal {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.search-type-badge.missing_person {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.search-status {
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.search-status.completed {
    background: var(--success-bg);
    color: var(--success);
}

.search-status.processing {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
}

.search-status.failed {
    background: var(--error-bg);
    color: var(--error);
}

.search-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.meta-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.meta-value {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
}

.meta-value i {
    font-size: 12px;
    color: var(--primary-gold);
}

.search-results-summary {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.results-text {
    font-size: 13px;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.results-text i {
    color: var(--primary-gold);
}

.results-count-badge {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary-gold);
    padding: 4px 12px;
    background: rgba(212, 175, 55, 0.1);
    border-radius: 6px;
    border: 1px solid var(--border-gold);
}

.search-actions {
    display: flex;
    gap: 10px;
}

.action-btn {
    padding: 10px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.action-btn i {
    font-size: 14px;
}

.action-btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
}

.action-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold-subtle);
    color: white;
}

.action-btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.action-btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

.action-btn-danger {
    background: var(--error-bg);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.action-btn-danger:hover {
    background: var(--error);
    color: white;
    border-color: var(--error);
}

/* ===========================
   EMPTY STATE
   =========================== */
.empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--text-muted);
}

.empty-state i {
    font-size: 72px;
    margin-bottom: 24px;
    opacity: 0.5;
    color: var(--primary-gold);
}

.empty-state h3 {
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 12px;
    font-weight: 600;
}

.empty-state p {
    font-size: 15px;
    margin-bottom: 28px;
    line-height: 1.6;
}

/* ===========================
   PAGINATION
   =========================== */
.pagination-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
    gap: 16px;
}

.pagination {
    display: flex;
    gap: 8px;
    align-items: center;
}

.page-link {
    padding: 10px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 6px;
}

.page-link:hover:not(.disabled):not(.active) {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    color: var(--primary-gold);
}

.page-link.active {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    border-color: var(--primary-gold);
    color: white;
}

.page-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.page-info {
    font-size: 13px;
    color: var(--text-muted);
    padding: 0 12px;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold-subtle);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 968px) {
    .header-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .header-actions {
        width: 100%;
    }

    .filters-grid {
        grid-template-columns: 1fr;
    }

    .search-meta {
        grid-template-columns: 1fr;
    }

    .search-actions {
        flex-direction: column;
    }

    .action-btn {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 768px) {
    .page-header {
        padding: 20px;
    }

    .header-left {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-text h1 {
        font-size: 22px;
    }

    .filter-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .pagination {
        flex-wrap: wrap;
        justify-content: center;
    }

    .search-header {
        flex-direction: column;
        align-items: flex-start;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <a href="{{ url_for('identification.search_page') }}" class="breadcrumb-item">
            <span>Face Recognition</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Search History</span>
        </span>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fas fa-history"></i>
                </div>
                <div class="header-text">
                    <h1>Search History</h1>
                    <p>View and manage all your face recognition search history</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="{{ url_for('identification.search_page') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    New Search
                </a>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <div class="filters-header">
            <h2 class="filters-title">
                <i class="fas fa-filter"></i>
                Filters
            </h2>
            <a href="{{ url_for('identification.list_search_history') }}" class="clear-filters-btn">
                <i class="fas fa-times-circle"></i>
                Clear Filters
            </a>
        </div>
        <div class="filters-body">
            <form method="GET" action="{{ url_for('identification.list_search_history') }}">
                <div class="filters-grid">
                    <!-- Search Type Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-tag"></i>
                            Search Type
                        </label>
                        <select name="search_type" class="filter-control">
                            <option value="">All Types</option>
                            <option value="criminal" {% if current_search_type == 'criminal' %}selected{% endif %}>Criminal</option>
                            <option value="missing_person" {% if current_search_type == 'missing_person' %}selected{% endif %}>Missing Person</option>
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-info-circle"></i>
                            Status
                        </label>
                        <select name="status" class="filter-control">
                            <option value="">All Statuses</option>
                            <option value="completed" {% if current_status == 'completed' %}selected{% endif %}>Completed</option>
                            <option value="processing" {% if current_status == 'processing' %}selected{% endif %}>Processing</option>
                            <option value="failed" {% if current_status == 'failed' %}selected{% endif %}>Failed</option>
                        </select>
                    </div>

                    <!-- Per Page Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-list"></i>
                            Per Page
                        </label>
                        <select name="per_page" class="filter-control">
                            <option value="10" {% if pagination_data.per_page == 10 %}selected{% endif %}>10</option>
                            <option value="20" {% if pagination_data.per_page == 20 %}selected{% endif %}>20</option>
                            <option value="50" {% if pagination_data.per_page == 50 %}selected{% endif %}>50</option>
                            <option value="100" {% if pagination_data.per_page == 100 %}selected{% endif %}>100</option>
                        </select>
                    </div>

                    <!-- Include Deleted -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-trash-restore"></i>
                            Include Deleted
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="include_deleted" value="true" {% if include_deleted %}checked{% endif %}>
                            <span class="checkbox-label">Show deleted searches</span>
                        </label>
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                        Apply Filters
                    </button>
                    <a href="{{ url_for('identification.list_search_history') }}" class="btn btn-secondary">
                        <i class="fas fa-redo"></i>
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- History List -->
    <div class="history-section">
        <div class="history-header">
            <h2 class="history-title">
                <i class="fas fa-list"></i>
                Search Results
            </h2>
            <span class="history-count">
                {{ pagination_data.total if pagination_data.total else 0 }} total search{{ 'es' if (pagination_data.total != 1) else '' }}
            </span>
        </div>
        <div class="history-body">
            {% if searches_list and searches_list|length > 0 %}
                <div class="history-grid">
                    {% for search in searches_list %}
                        {% set search_data = search if search is mapping else {} %}
                        {% set search_id = search_data.id if search_data.id else search.id %}
                        {% set search_type = search_data.search_type if search_data.search_type else '' %}
                        {% set status = search_data.status if search_data.status else 'unknown' %}
                        {% set file_type = search_data.file_type if search_data.file_type else 'unknown' %}
                        {% set created_at = search_data.created_at if search_data.created_at else '' %}
                        {% set result_count = search_data.result_count if search_data.result_count is defined else 0 %}

                        <div class="search-card" onclick="window.location.href='{{ url_for('identification.view_search_results', search_id=search_id) }}'">
                            <div class="search-card-body">
                                <div class="search-header">
                                    <div class="search-info">
                                        <div class="search-id">ID: {{ search_id[:16] }}...</div>
                                        <span class="search-type-badge {{ search_type|replace('_', '') }}">
                                            {{ search_type|replace('_', ' ')|title }}
                                        </span>
                                    </div>
                                    <span class="search-status {{ status|lower }}">
                                        {{ status|replace('_', ' ')|title }}
                                    </span>
                                </div>

                                <div class="search-meta">
                                    <div class="meta-item">
                                        <div class="meta-label">Date</div>
                                        <div class="meta-value">
                                            <i class="fas fa-calendar"></i>
                                            {{ created_at[:10] if created_at else 'N/A' }}
                                        </div>
                                    </div>
                                    <div class="meta-item">
                                        <div class="meta-label">Time</div>
                                        <div class="meta-value">
                                            <i class="fas fa-clock"></i>
                                            {{ created_at[11:19] if created_at else 'N/A' }}
                                        </div>
                                    </div>
                                    <div class="meta-item">
                                        <div class="meta-label">File Type</div>
                                        <div class="meta-value">
                                            <i class="fas fa-{{ 'image' if file_type == 'image' else 'video' }}"></i>
                                            {{ file_type|title }}
                                        </div>
                                    </div>
                                </div>

                                <div class="search-results-summary">
                                    <span class="results-text">
                                        <i class="fas fa-check-circle"></i>
                                        Matches Found
                                    </span>
                                    <span class="results-count-badge">{{ result_count }}</span>
                                </div>

                                <div class="search-actions">
                                    <a href="{{ url_for('identification.view_search_results', search_id=search_id) }}"
                                       class="action-btn action-btn-primary"
                                       onclick="event.stopPropagation()">
                                        <i class="fas fa-eye"></i>
                                        View Results
                                    </a>
                                    {% if current_user and current_user.role == 'admin' %}
                                    <button type="button"
                                            class="action-btn action-btn-danger"
                                            onclick="event.stopPropagation(); deleteSearch('{{ search_id }}')">
                                        <i class="fas fa-trash-alt"></i>
                                        Delete
                                    </button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-search"></i>
                    <h3>No Search History Found</h3>
                    <p>{% if current_search_type or current_status %}
                        No searches match your current filters. Try adjusting your filters or clearing them.
                    {% else %}
                        You haven't performed any face recognition searches yet.<br>Start your first search to see results here.
                    {% endif %}</p>
                    <a href="{{ url_for('identification.search_page') }}" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                        Start New Search
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Pagination -->
        {% if pagination_data.total_pages and pagination_data.total_pages > 1 %}
        <div class="pagination-section">
            <div class="pagination">
                <!-- Previous Button -->
                <a href="?page={{ pagination_data.page - 1 }}&per_page={{ pagination_data.per_page }}&search_type={{ current_search_type }}&status={{ current_status }}&include_deleted={{ include_deleted }}"
                   class="page-link {{ 'disabled' if pagination_data.page <= 1 else '' }}">
                    <i class="fas fa-chevron-left"></i>
                    Previous
                </a>

                <!-- Page Info -->
                <span class="page-info">
                    Page {{ pagination_data.page }} of {{ pagination_data.total_pages }}
                </span>

                <!-- Page Numbers (show 5 pages max) -->
                {% set start_page = [1, pagination_data.page - 2]|max %}
                {% set end_page = [pagination_data.total_pages, pagination_data.page + 2]|min %}

                {% for page_num in range(start_page, end_page + 1) %}
                    <a href="?page={{ page_num }}&per_page={{ pagination_data.per_page }}&search_type={{ current_search_type }}&status={{ current_status }}&include_deleted={{ include_deleted }}"
                       class="page-link {{ 'active' if page_num == pagination_data.page else '' }}">
                        {{ page_num }}
                    </a>
                {% endfor %}

                <!-- Next Button -->
                <a href="?page={{ pagination_data.page + 1 }}&per_page={{ pagination_data.per_page }}&search_type={{ current_search_type }}&status={{ current_status }}&include_deleted={{ include_deleted }}"
                   class="page-link {{ 'disabled' if pagination_data.page >= pagination_data.total_pages else '' }}">
                    Next
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<script>
// Delete search
async function deleteSearch(searchId) {
    if (!confirm('Are you sure you want to delete this search? This action cannot be undone.')) {
        return;
    }

    try {
        const response = await fetch(`/identification/searches/${searchId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            const errorMessage = data.message ||
                               (data.error && data.error.details && data.error.details[0]) ||
                               'Failed to delete search';
            throw new Error(errorMessage);
        }

        // Success
        if (window.toast) {
            window.toast.success('Success', data.message || 'Search deleted successfully');
        } else {
            alert('Success: Search deleted successfully');
        }

        // Reload page after short delay
        setTimeout(() => {
            window.location.reload();
        }, 1000);

    } catch (error) {
        console.error('Delete error:', error);

        if (window.toast) {
            window.toast.error('Error', error.message || 'Failed to delete search');
        } else {
            alert('Error: ' + (error.message || 'Failed to delete search'));
        }
    }
}

// Animate cards on page load
document.addEventListener('DOMContentLoaded', function() {
    const searchCards = document.querySelectorAll('.search-card');

    searchCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';

        setTimeout(() => {
            card.style.transition = 'all 0.4s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, 50 * index);
    });

    // Auto-submit filters on change (optional)
    const filterSelects = document.querySelectorAll('.filter-control');
    const autoSubmit = false; // Set to true to enable auto-submit

    if (autoSubmit) {
        filterSelects.forEach(select => {
            select.addEventListener('change', function() {
                this.closest('form').submit();
            });
        });

        const checkbox = document.querySelector('input[name="include_deleted"]');
        if (checkbox) {
            checkbox.addEventListener('change', function() {
                this.closest('form').submit();
            });
        }
    }
});

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    // N key for new search
    if (e.key === 'n' || e.key === 'N') {
        if (!e.target.matches('input, textarea, select')) {
            window.location.href = '{{ url_for("identification.search_page") }}';
        }
    }

    // ESC to clear filters
    if (e.key === 'Escape') {
        window.location.href = '{{ url_for("identification.list_search_history") }}';
    }
});

// Export history as CSV (optional feature)
function exportHistory() {
    if (window.toast) {
        window.toast.info('Coming Soon', 'CSV export functionality will be available soon');
    } else {
        alert('CSV export functionality will be available soon');
    }
}

// Print history
function printHistory() {
    window.print();
}

// Add smooth scroll behavior
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    });
});

// Format dates on hover (optional enhancement)
document.querySelectorAll('.meta-value').forEach(element => {
    const dateText = element.textContent.trim();
    if (dateText.match(/^\d{4}-\d{2}-\d{2}$/)) {
        element.setAttribute('title', new Date(dateText).toLocaleDateString('en-US', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }));
    }
});

// Track page view for analytics (optional)
(function() {
    console.log('Search History Page View', {
        filters: {
            search_type: '{{ current_search_type }}',
            status: '{{ current_status }}',
            include_deleted: {{ 'true' if include_deleted else 'false' }}
        },
        pagination: {
            page: {{ pagination_data.page if pagination_data.page else 1 }},
            total: {{ pagination_data.total if pagination_data.total else 0 }}
        }
    });
})();

// Bulk selection (for future bulk actions)
let selectedSearches = new Set();

function toggleSelection(searchId) {
    if (selectedSearches.has(searchId)) {
        selectedSearches.delete(searchId);
    } else {
        selectedSearches.add(searchId);
    }
    updateBulkActions();
}

function updateBulkActions() {
    const count = selectedSearches.size;
    const bulkActionsBar = document.getElementById('bulkActionsBar');

    if (bulkActionsBar) {
        if (count > 0) {
            bulkActionsBar.style.display = 'flex';
            bulkActionsBar.querySelector('.selected-count').textContent = count;
        } else {
            bulkActionsBar.style.display = 'none';
        }
    }
}

// Quick stats calculation
function calculateStats() {
    const cards = document.querySelectorAll('.search-card');
    let totalMatches = 0;

    cards.forEach(card => {
        const badge = card.querySelector('.results-count-badge');
        if (badge) {
            totalMatches += parseInt(badge.textContent) || 0;
        }
    });

    console.log('Quick Stats:', {
        totalSearches: cards.length,
        totalMatches: totalMatches,
        averageMatches: cards.length > 0 ? (totalMatches / cards.length).toFixed(1) : 0
    });
}

// Run stats on load
document.addEventListener('DOMContentLoaded', calculateStats);

// Handle mobile responsiveness
function handleResize() {
    const width = window.innerWidth;

    if (width < 768) {
        // Mobile optimizations
        document.querySelectorAll('.meta-value').forEach(el => {
            el.style.fontSize = '13px';
        });
    }
}

window.addEventListener('resize', handleResize);
handleResize();

// Refresh data periodically (optional - useful for processing searches)
let autoRefresh = false;
let refreshInterval = null;

function toggleAutoRefresh() {
    autoRefresh = !autoRefresh;

    if (autoRefresh) {
        refreshInterval = setInterval(() => {
            // Check if there are processing searches
            const processingSearches = document.querySelectorAll('.search-status.processing');
            if (processingSearches.length > 0) {
                window.location.reload();
            }
        }, 30000); // Refresh every 30 seconds

        if (window.toast) {
            window.toast.info('Auto-Refresh', 'Auto-refresh enabled for processing searches');
        }
    } else {
        if (refreshInterval) {
            clearInterval(refreshInterval);
            refreshInterval = null;
        }

        if (window.toast) {
            window.toast.info('Auto-Refresh', 'Auto-refresh disabled');
        }
    }
}

// Check for processing searches on load
document.addEventListener('DOMContentLoaded', function() {
    const processingSearches = document.querySelectorAll('.search-status.processing');
    if (processingSearches.length > 0) {
        console.log(`Found ${processingSearches.length} processing search(es)`);
        // Could enable auto-refresh here if desired
    }
});
</script>

<!-- Optional: Scroll to Top Button -->
<button id="scrollToTop" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" style="
    display: none;
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 48px;
    height: 48px;
    background: var(--primary-gold);
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 20px;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    transition: var(--transition);
    align-items: center;
    justify-content: center;
">
    <i class="fas fa-arrow-up"></i>
</button>

<script>
// Show/hide scroll to top button
window.addEventListener('scroll', function() {
    const scrollBtn = document.getElementById('scrollToTop');
    if (scrollBtn) {
        if (window.pageYOffset > 300) {
            scrollBtn.style.display = 'flex';
        } else {
            scrollBtn.style.display = 'none';
        }
    }
});

// Enhance scroll to top button
const scrollBtn = document.getElementById('scrollToTop');
if (scrollBtn) {
    scrollBtn.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-4px) scale(1.05)';
    });

    scrollBtn.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
    });
}
</script>

<style>
/* Print styles */
@media print {
    .page-breadcrumb,
    .header-actions,
    .filters-section,
    .pagination-section,
    .action-btn,
    #scrollToTop {
        display: none !important;
    }

    .search-card {
        page-break-inside: avoid;
        border: 1px solid #ccc !important;
        background: white !important;
    }

    .page-header,
    .history-section {
        border: 1px solid #ccc !important;
        background: white !important;
    }

    .search-card-body {
        padding: 16px !important;
    }
}
</style>
{% endblock %}