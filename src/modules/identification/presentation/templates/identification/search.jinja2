{% extends 'base.jinja2' %}

{% set recent_searches_list = recent_searches if recent_searches else [] %}

{% block title %}Face Recognition Search | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   PAGE LAYOUT - THREE COLUMN
   =========================== */
.search-container {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 24px;
    height: calc(100vh - 96px);
    overflow: hidden;
}

/* ===========================
   LEFT SIDEBAR - SEARCH HISTORY
   =========================== */
.history-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.sidebar-header {
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border);
    background: transparent;
}

.sidebar-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 4px 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.sidebar-title i {
    color: var(--primary-gold);
    font-size: 18px;
}

.sidebar-subtitle {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
}

.history-list {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

.history-list::-webkit-scrollbar {
    width: 6px;
}

.history-list::-webkit-scrollbar-track {
    background: transparent;
}

.history-list::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
}

.history-item {
    padding: 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: 8px;
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
    display: block;
}

.history-item:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    transform: translateX(4px);
}

.history-item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.history-type {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 6px;
}

.history-type.criminal {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
}

.history-type.missing_person {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
}

.history-date {
    font-size: 11px;
    color: var(--text-muted);
}

.history-status {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 4px;
}

.history-results {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
}

.history-results i {
    color: var(--primary-gold);
}

.no-history {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-muted);
}

.no-history i {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
}

.no-history p {
    font-size: 13px;
    margin: 0;
}

.history-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--border);
    background: transparent;
    text-align: center;
}

.view-all-link {
    font-size: 13px;
    color: var(--primary-gold);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition);
}

.view-all-link:hover {
    color: var(--primary-gold-light);
}

/* ===========================
   MAIN CONTENT AREA
   =========================== */
.main-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
    padding-right: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

.main-content::-webkit-scrollbar {
    width: 6px;
}

.main-content::-webkit-scrollbar-track {
    background: transparent;
}

.main-content::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   SEARCH FORM SECTION
   =========================== */
.search-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.search-header {
    padding: 24px 28px;
    border-bottom: 1px solid var(--border);
    background: transparent;
}

.search-header-content {
    display: flex;
    align-items: center;
    gap: 16px;
}

.search-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(184, 134, 11, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--border-gold);
}

.search-icon i {
    font-size: 24px;
    color: var(--primary-gold);
}

.search-header-text h2 {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px 0;
    letter-spacing: -0.5px;
}

.search-header-text p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
}

.search-body {
    padding: 28px;
}

/* ===========================
   UPLOAD AREA
   =========================== */
.upload-area {
    padding: 40px 32px;
    background: rgba(10, 14, 39, 0.3);
    backdrop-filter: blur(10px);
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    margin-bottom: 24px;
}

.upload-area:hover {
    border-color: var(--primary-gold);
    background: rgba(10, 14, 39, 0.5);
}

.upload-area.dragover {
    border-color: var(--primary-gold);
    background: rgba(212, 175, 55, 0.1);
}

.upload-icon-large {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    background: rgba(212, 175, 55, 0.1);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-gold);
}

.upload-icon-large i {
    font-size: 36px;
    color: var(--primary-gold);
}

.upload-text {
    font-size: 16px;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 6px;
}

.upload-hint {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 16px;
}

.upload-formats {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.upload-formats i {
    color: var(--primary-gold);
}

.file-preview {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin-bottom: 24px;
}

.preview-thumbnail {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
}

.preview-thumbnail img,
.preview-thumbnail video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.preview-info {
    flex: 1;
    min-width: 0;
}

.preview-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.preview-details {
    font-size: 12px;
    color: var(--text-muted);
}

.preview-remove {
    background: var(--error-bg);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 10px 20px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 8px;
}

.preview-remove:hover {
    background: var(--error);
    color: white;
    border-color: var(--error);
}

/* ===========================
   SEARCH OPTIONS
   =========================== */
.search-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.option-card {
    padding: 20px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition);
}

.option-card:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
}

.option-card.selected {
    background: rgba(212, 175, 55, 0.1);
    border-color: var(--primary-gold);
}

.option-card input[type="radio"] {
    display: none;
}

.option-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
}

.option-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.option-card:not(.selected) .option-icon {
    background: rgba(10, 14, 39, 0.4);
}

.option-card.selected .option-icon {
    background: rgba(212, 175, 55, 0.15);
}

.option-icon i {
    font-size: 18px;
}

.option-card:not(.selected) .option-icon i {
    color: var(--text-secondary);
}

.option-card.selected .option-icon i {
    color: var(--primary-gold);
}

.option-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
}

.option-description {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
}

/* ===========================
   SEARCH BUTTON
   =========================== */
.search-actions {
    display: flex;
    gap: 12px;
}

.btn {
    padding: 14px 28px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
    flex: 1;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold-subtle);
}

.btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

.btn.loading {
    position: relative;
    pointer-events: none;
}

.btn.loading::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ===========================
   RESULTS SECTION
   =========================== */
.results-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: none;
}

.results-section.show {
    display: block;
}

.results-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.results-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
}

.results-title i {
    color: var(--primary-gold);
    font-size: 20px;
}

.results-count {
    font-size: 13px;
    color: var(--text-muted);
    padding: 6px 12px;
    background: rgba(10, 14, 39, 0.4);
    border-radius: var(--radius-md);
}

.results-body {
    padding: 24px;
}

.result-card {
    padding: 20px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 16px;
    transition: var(--transition);
    cursor: pointer;
}

.result-card:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    transform: translateX(4px);
}

.result-card:last-child {
    margin-bottom: 0;
}

.result-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
}

.result-avatar {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(184, 134, 11, 0.15));
    border: 2px solid var(--border-gold);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: var(--primary-gold);
    font-weight: 700;
}

.result-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.result-info {
    flex: 1;
    min-width: 0;
}

.result-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
}

.result-type {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 8px;
}

.result-type.criminal {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
}

.result-type.missing_person {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
}

.result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 13px;
    color: var(--text-secondary);
}

.result-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
}

.result-meta-item i {
    color: var(--primary-gold);
    font-size: 12px;
}

.result-confidence {
    display: flex;
    align-items: center;
    gap: 12px;
}

.confidence-bar {
    flex: 1;
    height: 6px;
    background: rgba(10, 14, 39, 0.6);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
}

.confidence-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s ease;
}

.confidence-fill.high {
    background: linear-gradient(90deg, var(--success), #34d399);
}

.confidence-fill.medium {
    background: linear-gradient(90deg, var(--warning), #fbbf24);
}

.confidence-fill.low {
    background: linear-gradient(90deg, var(--error), #f87171);
}

.confidence-label {
    font-size: 14px;
    font-weight: 600;
    min-width: 50px;
    text-align: right;
}

.confidence-label.high {
    color: var(--success);
}

.confidence-label.medium {
    color: var(--warning);
}

.confidence-label.low {
    color: var(--error);
}

.no-results {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}

.no-results i {
    font-size: 64px;
    margin-bottom: 20px;
    opacity: 0.5;
}

.no-results h3 {
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 8px;
    font-weight: 600;
}

.no-results p {
    font-size: 14px;
    margin: 0;
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 1200px) {
    .search-container {
        grid-template-columns: 280px 1fr;
    }
}

@media (max-width: 968px) {
    .search-container {
        grid-template-columns: 1fr;
        height: auto;
    }

    .history-sidebar {
        max-height: 400px;
    }

    .search-options {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .search-header-content {
        flex-direction: column;
        text-align: center;
    }

    .result-header {
        flex-direction: column;
        text-align: center;
    }

    .result-meta {
        justify-content: center;
    }

    .search-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }
}
</style>
{% endblock %}

{% block content %}
<div style="display: flex; flex-direction: column; gap: 24px;">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Face Recognition Search</span>
        </span>
    </div>

    <!-- Main Container -->
    <div class="search-container">
        <!-- Left Sidebar - Search History -->
        <div class="history-sidebar">
            <div class="sidebar-header">
                <h3 class="sidebar-title">
                    <i class="fas fa-history"></i>
                    Recent Searches
                </h3>
                <p class="sidebar-subtitle">Your last 10 searches</p>
            </div>

            <div class="history-list">
                {% if recent_searches_list and recent_searches_list|length > 0 %}
                    {% for search in recent_searches_list %}
                    <a href="{{ url_for('identification.view_search_results', search_id=search.id) }}" class="history-item">
                        <div class="history-item-header">
                            <span class="history-type {{ search.search_type|replace('_', '') }}">
                                {{ search.search_type|replace('_', ' ')|title }}
                            </span>
                            <span class="history-date">{{ search.created_at[:10] if search.created_at else '' }}</span>
                        </div>
                        <div class="history-status">{{ search.status|replace('_', ' ')|title }}</div>
                        <div class="history-results">
                            <i class="fas fa-check-circle"></i>
                            <span>{{ search.result_count if search.result_count else 0 }} matches found</span>
                        </div>
                    </a>
                    {% endfor %}
                {% else %}
                    <div class="no-history">
                        <i class="fas fa-search"></i>
                        <p>No recent searches</p>
                    </div>
                {% endif %}
            </div>

            {% if recent_searches_list and recent_searches_list|length > 0 %}
            <div class="history-footer">
                <a href="{{ url_for('identification.list_search_history') }}" class="view-all-link">
                    View All History →
                </a>
            </div>
            {% endif %}
        </div>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Search Form Section -->
            <div class="search-section">
                <div class="search-header">
                    <div class="search-header-content">
                        <div class="search-icon">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <div class="search-header-text">
                            <h2>Face Recognition Search</h2>
                            <p>Upload an image or video to search for criminals or missing persons in our database</p>
                        </div>
                    </div>
                </div>

                <div class="search-body">
                    <form id="searchForm" method="POST" enctype="multipart/form-data">
                        <!-- Upload Area -->
                        <div class="upload-area" id="uploadArea" onclick="document.getElementById('fileInput').click()">
                            <div class="upload-icon-large">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>
                            <div class="upload-text">Click to upload or drag and drop</div>
                            <div class="upload-hint">Upload a photo or video to begin face recognition search</div>
                            <div class="upload-formats">
                                <i class="fas fa-info-circle"></i>
                                <span>Supported: JPG, PNG, GIF, MP4, AVI, MOV (Max 50MB)</span>
                            </div>
                        </div>

                        <input type="file" id="fileInput" name="file" accept="image/*,video/*" style="display: none;" onchange="handleFileSelect(event)">

                        <!-- File Preview -->
                        <div id="filePreview" class="file-preview" style="display: none;">
                            <div class="preview-thumbnail" id="previewThumbnail"></div>
                            <div class="preview-info">
                                <div class="preview-name" id="previewName"></div>
                                <div class="preview-details" id="previewDetails"></div>
                            </div>
                            <button type="button" class="preview-remove" onclick="clearFile()">
                                <i class="fas fa-times"></i>
                                Remove
                            </button>
                        </div>

                        <!-- Search Options -->
                        <div class="search-options">
                            <label class="option-card" onclick="selectSearchType('criminal')">
                                <input type="radio" name="search_type" value="criminal" required>
                                <div class="option-header">
                                    <div class="option-icon">
                                        <i class="fas fa-user-secret"></i>
                                    </div>
                                    <div class="option-title">Search Criminals</div>
                                </div>
                                <div class="option-description">
                                    Search our criminal database for potential matches
                                </div>
                            </label>

                            <label class="option-card" onclick="selectSearchType('missing_person')">
                                <input type="radio" name="search_type" value="missing_person" required>
                                <div class="option-header">
                                    <div class="option-icon">
                                        <i class="fas fa-user-slash"></i>
                                    </div>
                                    <div class="option-title">Search Missing Persons</div>
                                </div>
                                <div class="option-description">
                                    Search missing persons database for potential matches
                                </div>
                            </label>
                        </div>

                        <!-- Search Actions -->
                        <div class="search-actions">
                            <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                                <i class="fas fa-search"></i>
                                Start Face Recognition Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Results Section (Initially Hidden) -->
            <div class="results-section" id="resultsSection">
                <div class="results-header">
                    <h3 class="results-title">
                        <i class="fas fa-check-circle"></i>
                        Search Results
                    </h3>
                    <span class="results-count" id="resultsCount">0 matches found</span>
                </div>
                <div class="results-body" id="resultsBody">
                    <!-- Results will be dynamically inserted here -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let selectedFile = null;
let selectedSearchType = null;

// Drag and drop handlers
document.addEventListener('DOMContentLoaded', function() {
    const uploadArea = document.getElementById('uploadArea');

    uploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        uploadArea.classList.add('dragover');
    });

    uploadArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        uploadArea.classList.remove('dragover');
    });

    uploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        uploadArea.classList.remove('dragover');

        const files = e.dataTransfer.files;
        if (files.length > 0) {
            const fileInput = document.getElementById('fileInput');
            fileInput.files = files;
            handleFileSelect({ target: fileInput });
        }
    });
});

// Handle file selection
function handleFileSelect(event) {
    const file = event.target.files[0];

    if (!file) return;

    // Validate file size (50MB)
    const maxSize = 50 * 1024 * 1024;
    if (file.size > maxSize) {
        if (window.toast) {
            window.toast.error('File Too Large', 'File size must be less than 50MB');
        } else {
            alert('File size must be less than 50MB');
        }
        clearFile();
        return;
    }

    // Validate file type
    const validImageTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
    const validVideoTypes = ['video/mp4', 'video/avi', 'video/mov', 'video/wmv', 'video/flv', 'video/mkv'];
    const validTypes = [...validImageTypes, ...validVideoTypes];

    if (!validTypes.includes(file.type)) {
        if (window.toast) {
            window.toast.error('Invalid File Type', 'Please upload an image (JPG, PNG, GIF) or video (MP4, AVI, MOV)');
        } else {
            alert('Please upload an image (JPG, PNG, GIF) or video (MP4, AVI, MOV)');
        }
        clearFile();
        return;
    }

    selectedFile = file;

    // Show preview
    const preview = document.getElementById('filePreview');
    const thumbnail = document.getElementById('previewThumbnail');
    const name = document.getElementById('previewName');
    const details = document.getElementById('previewDetails');

    preview.style.display = 'flex';
    name.textContent = file.name;
    details.textContent = `${(file.size / (1024 * 1024)).toFixed(2)} MB`;

    // Create thumbnail
    const reader = new FileReader();
    reader.onload = function(e) {
        if (validImageTypes.includes(file.type)) {
            thumbnail.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
        } else if (validVideoTypes.includes(file.type)) {
            thumbnail.innerHTML = `<video src="${e.target.result}" muted></video>`;
        }
    };
    reader.readAsDataURL(file);

    // Enable submit button if search type is selected
    updateSubmitButton();
}

// Clear selected file
function clearFile() {
    selectedFile = null;
    document.getElementById('fileInput').value = '';
    document.getElementById('filePreview').style.display = 'none';
    document.getElementById('previewThumbnail').innerHTML = '';
    updateSubmitButton();
}

// Select search type
function selectSearchType(type) {
    selectedSearchType = type;

    // Update UI
    document.querySelectorAll('.option-card').forEach(card => {
        card.classList.remove('selected');
    });

    event.currentTarget.classList.add('selected');

    // Check the radio button
    const radio = event.currentTarget.querySelector('input[type="radio"]');
    if (radio) {
        radio.checked = true;
    }

    updateSubmitButton();
}

// Update submit button state
function updateSubmitButton() {
    const submitBtn = document.getElementById('submitBtn');
    if (selectedFile && selectedSearchType) {
        submitBtn.disabled = false;
    } else {
        submitBtn.disabled = true;
    }
}

// Form submission
document.getElementById('searchForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    if (!selectedFile || !selectedSearchType) {
        if (window.toast) {
            window.toast.warning('Missing Information', 'Please select a file and search type');
        } else {
            alert('Please select a file and search type');
        }
        return;
    }

    const submitBtn = document.getElementById('submitBtn');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.classList.add('loading');
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('search_type', selectedSearchType);

    try {
        const response = await fetch('{{ url_for("identification.create_search") }}', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            const errorMessage = data.message ||
                               (data.error && data.error.details && data.error.details[0]) ||
                               'Failed to process search';
            throw new Error(errorMessage);
        }

        // Success
        if (window.toast) {
            window.toast.success('Success', data.message || 'Search completed successfully');
        }

        // Show results
        if (data.value && data.value.id) {
            // Redirect to results page after short delay
            setTimeout(() => {
                if (data.value.redirect_url) {
                    window.location.href = data.value.redirect_url;
                } else {
                    window.location.href = `/identification/searches/${data.value.id}`;
                }
            }, 1000);
        }

    } catch (error) {
        console.error('Search error:', error);

        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
        submitBtn.innerHTML = originalText;

        if (window.toast) {
            window.toast.error('Error', error.message || 'Failed to process search');
        } else {
            alert('Error: ' + (error.message || 'Failed to process search'));
        }
    }
});

// Display results dynamically (for inline results if needed)
function displayResults(results) {
    const resultsSection = document.getElementById('resultsSection');
    const resultsBody = document.getElementById('resultsBody');
    const resultsCount = document.getElementById('resultsCount');

    if (!results || results.length === 0) {
        resultsBody.innerHTML = `
            <div class="no-results">
                <i class="fas fa-search"></i>
                <h3>No Matches Found</h3>
                <p>No matches were found in the database for this search</p>
            </div>
        `;
        resultsCount.textContent = '0 matches found';
        resultsSection.classList.add('show');
        return;
    }

    resultsCount.textContent = `${results.length} match${results.length !== 1 ? 'es' : ''} found`;

    let html = '';
    results.forEach(result => {
        const personType = result.person_type || 'unknown';
        const confidenceLevel = result.similarity_score >= 0.8 ? 'high' :
                               result.similarity_score >= 0.6 ? 'medium' : 'low';
        const confidencePercent = (result.similarity_score * 100).toFixed(1);

        // Determine view URL
        let viewUrl = '#';
        if (personType === 'criminal' && result.person_id) {
            viewUrl = `/criminals/${result.person_id}`;
        } else if (personType === 'missing_person' && result.person_id) {
            viewUrl = `/missing-persons/${result.person_id}`;
        }

        // Get person details
        const personDetails = result.person_details || {};
        const firstName = personDetails.first_name || '';
        const lastName = personDetails.last_name || '';
        const fullName = `${firstName} ${lastName}`.trim() || 'Unknown Person';
        const initials = `${firstName[0] || ''}${lastName[0] || ''}`;

        html += `
            <div class="result-card" onclick="window.location.href='${viewUrl}'">
                <div class="result-header">
                    <div class="result-avatar">
                        ${result.matched_image_path ?
                            `<img src="${result.matched_image_path}" alt="${fullName}">` :
                            initials
                        }
                    </div>
                    <div class="result-info">
                        <h4 class="result-name">${fullName}</h4>
                        <span class="result-type ${personType}">${personType.replace('_', ' ')}</span>
                        <div class="result-meta">
                            ${personDetails.national_id ? `
                                <div class="result-meta-item">
                                    <i class="fas fa-id-card"></i>
                                    <span>${personDetails.national_id}</span>
                                </div>
                            ` : ''}
                            ${personDetails.gender ? `
                                <div class="result-meta-item">
                                    <i class="fas fa-venus-mars"></i>
                                    <span>${personDetails.gender}</span>
                                </div>
                            ` : ''}
                            ${personDetails.date_of_birth ? `
                                <div class="result-meta-item">
                                    <i class="fas fa-calendar"></i>
                                    <span>${personDetails.date_of_birth}</span>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                </div>
                <div class="result-confidence">
                    <div class="confidence-bar">
                        <div class="confidence-fill ${confidenceLevel}" style="width: ${confidencePercent}%"></div>
                    </div>
                    <div class="confidence-label ${confidenceLevel}">${confidencePercent}%</div>
                </div>
            </div>
        `;
    });

    resultsBody.innerHTML = html;
    resultsSection.classList.add('show');

    // Scroll to results
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>
{% endblock %}