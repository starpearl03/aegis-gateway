{% extends 'base.jinja2' %}

{% set default_start = default_start_date if default_start_date else '' %}
{% set default_end = default_end_date if default_end_date else '' %}

{% block title %}Analysis Preview | Sentinel{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
/* ===========================
   PAGE LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* ===========================
   BREADCRUMB - MATCHING THEME
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   PAGE HEADER - TRANSPARENT THEME
   =========================== */
.page-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: relative;
    z-index: 1;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

.header-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    flex-shrink: 0;
}

.header-icon i {
    font-size: 28px;
    color: var(--warning);
}

.header-text h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
}

/* ===========================
   BUTTONS - MATCHING THEME
   =========================== */
.btn {
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: var(--transition);
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--warning), #d97706);
    color: white;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    color: white;
}

.btn-secondary {
    background: transparent;
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--warning);
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* ===========================
   FORM SECTION - TRANSPARENT
   =========================== */
.form-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 24px;
}

.section-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-title i {
    color: var(--warning);
    font-size: 20px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 24px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.form-label i {
    font-size: 12px;
    color: var(--warning);
}

.form-help {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: -4px;
}

.form-control {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: #ffffff;
    transition: var(--transition-fast);
}

.form-control:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
}

.checkbox-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
}

.checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
}

.checkbox-wrapper:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.checkbox-wrapper input {
    width: 18px;
    height: 18px;
}

.checkbox-label {
    font-size: 14px;
    color: var(--text-primary);
}

/* ===========================
   RESULTS SECTION
   =========================== */
.preview-results {
    display: none;
}

.preview-results.show {
    display: block;
}

/* ===========================
   STATS CARDS - TRANSPARENT
   =========================== */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: center;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--warning), #d97706);
    opacity: 0;
    transition: var(--transition);
}

.stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--warning);
}

.stat-card:hover::before {
    opacity: 1;
}

.stat-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--warning);
    margin-bottom: 8px;
}

.stat-label {
    font-size: 12px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
}

/* ===========================
   SUMMARY BOX - TRANSPARENT
   =========================== */
.summary-box {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 24px;
}

.summary-box h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
}

.summary-box h3 i {
    color: var(--warning);
    font-size: 20px;
}

.summary-box p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
}

/* ===========================
   MAP SECTION - CRITICAL: NO BACKDROP FILTER ON MAP CONTAINER
   =========================== */
.map-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 24px;
}

.map-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
}

.map-header h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.map-header h3 i {
    color: var(--warning);
    font-size: 20px;
}

.map-tabs {
    display: flex;
    gap: 8px;
}

.map-tab {
    padding: 8px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 6px;
}

.map-tab:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.map-tab.active {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(217, 119, 6, 0.2));
    border-color: var(--warning);
    color: var(--warning);
}

/* MAP CONTAINER - ABSOLUTELY NO EFFECTS */
#mapContainer {
    width: 100%;
    height: 600px;
    background: #1a1d2e;
    position: relative;
}

.leaflet-container {
    background: #1a1d2e;
    font-family: inherit;
}

/* ===========================
   CONTENT GRID - TRANSPARENT CARDS
   =========================== */
.content-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 24px;
}

.content-card {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.card-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
}

.card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.card-title i {
    color: var(--warning);
    font-size: 18px;
}

.card-count {
    font-size: 13px;
    color: var(--warning);
    padding: 4px 12px;
    background: rgba(245, 158, 11, 0.15);
    border-radius: 6px;
    font-weight: 600;
}

.card-body {
    padding: 20px;
    max-height: 400px;
    overflow-y: auto;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}

.empty-state i {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
}

/* ===========================
   LIST ITEMS - TRANSPARENT
   =========================== */
.list-item {
    padding: 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: 12px;
    transition: var(--transition-fast);
}

.list-item:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.item-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
}

.item-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
}

.item-badge.high {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.item-badge.medium {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.item-badge.low {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.item-badge.critical,
.item-badge.urgent {
    background: rgba(239, 68, 68, 0.2);
    color: #ff1744;
    border: 1px solid rgba(239, 68, 68, 0.4);
}

.item-description {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 8px;
    line-height: 1.5;
}

.item-meta {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: var(--text-muted);
}

.item-meta span {
    display: flex;
    align-items: center;
    gap: 4px;
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 968px) {
    .form-grid,
    .stats-grid,
    .content-grid {
        grid-template-columns: 1fr;
    }

    .checkbox-group {
        grid-template-columns: 1fr;
    }

    .header-content {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 768px) {
    .page-header {
        padding: 24px;
    }

    .header-left {
        flex-direction: column;
        align-items: flex-start;
    }

    .map-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    #mapContainer {
        height: 400px;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Crime Analysis Preview</span>
        </span>
    </div>

    <!-- Header -->
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="header-text">
                    <h1>Crime Analysis Preview</h1>
                    <p>Generate AI-powered crime analysis reports with customizable hotspot detection</p>
                </div>
            </div>
            <a href="{{ url_for('analysis.list_analyses') }}" class="btn btn-secondary">
                <i class="fas fa-list"></i>
                View Reports
            </a>
        </div>
    </div>

    <!-- Form -->
    <div class="form-section">
        <h2 class="section-title">
            <i class="fas fa-sliders-h"></i>
            Analysis Parameters
        </h2>
        <form id="previewForm">
            <!-- Date Range -->
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-calendar-alt"></i>
                        Start Date
                    </label>
                    <input type="date" name="start_date" class="form-control" value="{{ default_start }}" required>
                </div>
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-calendar-alt"></i>
                        End Date
                    </label>
                    <input type="date" name="end_date" class="form-control" value="{{ default_end }}" required>
                </div>
            </div>

            <!-- ✅ NEW: Clustering Parameters -->
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-circle-notch"></i>
                        Clustering Radius (km)
                    </label>
                    <input
                        type="number"
                        name="radius_km"
                        class="form-control"
                        value="2.0"
                        min="0.1"
                        max="10"
                        step="0.1"
                        required
                    >
                    <small class="form-help">Distance for grouping nearby incidents (0.1 - 10 km)</small>
                </div>
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-hashtag"></i>
                        Minimum Incidents
                    </label>
                    <input
                        type="number"
                        name="min_incidents"
                        class="form-control"
                        value="3"
                        min="2"
                        max="20"
                        step="1"
                        required
                    >
                    <small class="form-help">Minimum incidents to form a hotspot (2 - 20)</small>
                </div>
            </div>

            <!-- Checkboxes -->
            <div class="checkbox-group">
                <label class="checkbox-wrapper">
                    <input type="checkbox" name="include_hotspots" value="true" checked>
                    <span class="checkbox-label">Include Hotspots</span>
                </label>
                <label class="checkbox-wrapper">
                    <input type="checkbox" name="include_trends" value="true" checked>
                    <span class="checkbox-label">Include Trends</span>
                </label>
                <label class="checkbox-wrapper">
                    <input type="checkbox" name="include_recommendations" value="true" checked>
                    <span class="checkbox-label">Include Recommendations</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary" id="previewBtn">
                <i class="fas fa-eye"></i>
                Generate Preview
            </button>
        </form>
    </div>

    <!-- Results (Hidden Initially) -->
    <div class="preview-results" id="previewResults">
        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value" id="totalCrimes">0</div>
                <div class="stat-label">Total Crimes</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="totalMissingPersons">0</div>
                <div class="stat-label">Missing Persons</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="totalHotspots">0</div>
                <div class="stat-label">Hotspots</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="totalAlerts">0</div>
                <div class="stat-label">Alerts</div>
            </div>
        </div>

        <!-- Summary -->
        <div class="summary-box">
            <h3>
                <i class="fas fa-file-alt"></i>
                Analysis Summary
            </h3>
            <p id="analysisSummary">Loading...</p>
        </div>

        <!-- Map -->
        <div class="map-section">
            <div class="map-header">
                <h3>
                    <i class="fas fa-map-marked-alt"></i>
                    Map Visualization
                </h3>
                <div class="map-tabs">
                    <button type="button" class="map-tab active" data-view="hotspots" onclick="switchMapView('hotspots')">
                        <i class="fas fa-fire"></i> Hotspots
                    </button>
                    <button type="button" class="map-tab" data-view="crimes" onclick="switchMapView('crimes')">
                        <i class="fas fa-map-pin"></i> Crimes
                    </button>
                </div>
            </div>
            <div id="mapContainer"></div>
        </div>

        <!-- Content Grid -->
        <div class="content-grid">
            <!-- Hotspots -->
            <div class="content-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-fire"></i>
                        Crime Hotspots
                    </h3>
                    <span class="card-count" id="hotspotsCount">0</span>
                </div>
                <div class="card-body" id="hotspotsList">
                    <div class="empty-state">
                        <i class="fas fa-fire"></i>
                        <p>No hotspots</p>
                    </div>
                </div>
            </div>

            <!-- Trends -->
            <div class="content-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-chart-line"></i>
                        Trends
                    </h3>
                    <span class="card-count" id="trendsCount">0</span>
                </div>
                <div class="card-body" id="trendsList">
                    <div class="empty-state">
                        <i class="fas fa-chart-line"></i>
                        <p>No trends</p>
                    </div>
                </div>
            </div>

            <!-- Recommendations -->
            <div class="content-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-lightbulb"></i>
                        Recommendations
                    </h3>
                    <span class="card-count" id="recommendationsCount">0</span>
                </div>
                <div class="card-body" id="recommendationsList">
                    <div class="empty-state">
                        <i class="fas fa-lightbulb"></i>
                        <p>No recommendations</p>
                    </div>
                </div>
            </div>

            <!-- Alerts -->
            <div class="content-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i>
                        Alerts
                    </h3>
                    <span class="card-count" id="alertsCount">0</span>
                </div>
                <div class="card-body" id="alertsList">
                    <div class="empty-state">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p>No alerts</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-section">
            <h3 style="color: var(--text-primary); margin: 0 0 8px 0; font-size: 18px; font-weight: 600;">Ready to Generate?</h3>
            <p style="color: var(--text-secondary); margin: 0 0 20px 0; font-size: 14px;">Click below to save this analysis permanently with the selected clustering parameters.</p>
            <button type="button" class="btn btn-primary" onclick="generateAnalysis()">
                <i class="fas fa-save"></i>
                Generate & Save Analysis
            </button>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
let previewData = null;
let map = null;
let hotspotsLayer = null;
let crimesLayer = null;

// Form submission
document.getElementById('previewForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn = document.getElementById('previewBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

    try {
        const response = await fetch('{{ url_for("analysis.preview_analysis") }}', {
            method: 'POST',
            body: new FormData(this)
        });

        const data = await response.json();

        // Debug logging
        console.log('Full response:', data);
        console.log('Response value:', data.value);

        if (!response.ok || data.error) {
            throw new Error(data.message || 'Failed to generate preview');
        }

        previewData = data.value;

        // Debug what we're passing to displayResults
        console.log('Preview data structure:', {
            hasAnalysis: !!previewData.analysis,
            hasHotspots: !!previewData.hotspots,
            hasTrends: !!previewData.trends,
            hasRecommendations: !!previewData.recommendations,
            hotspotsCount: (previewData.hotspots || []).length,
            trendsCount: (previewData.trends || []).length,
            recommendationsCount: (previewData.recommendations || []).length
        });

        displayResults(previewData);

        // Show results
        document.getElementById('previewResults').classList.add('show');

        // Initialize map AFTER showing results
        setTimeout(() => {
            const hotspots = previewData.hotspots || [];
            const crimes = previewData.individual_crimes || [];
            console.log('Initializing map with:', { hotspots: hotspots.length, crimes: crimes.length });
            initMap(hotspots, crimes);
        }, 600);

        if (window.toast) window.toast.success('Success', 'Preview generated');

    } catch (error) {
        console.error('Preview error:', error);
        if (window.toast) window.toast.error('Error', error.message);
        else alert('Error: ' + error.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-eye"></i> Generate Preview';
    }
});

function displayResults(data) {
    console.log('displayResults called with:', data);

    const analysis = data.analysis || {};
    const hotspots = data.hotspots || [];
    const trends = data.trends || [];
    const recommendations = data.recommendations || [];
    const alerts = data.preview_alerts || [];

    console.log('Extracted data:', {
        analysis,
        hotspotsLength: hotspots.length,
        trendsLength: trends.length,
        recommendationsLength: recommendations.length,
        alertsLength: alerts.length
    });

    // Update stats
    document.getElementById('totalCrimes').textContent = analysis.total_crimes || 0;
    document.getElementById('totalMissingPersons').textContent = analysis.total_missing_persons || 0;
    document.getElementById('totalHotspots').textContent = hotspots.length;
    document.getElementById('totalAlerts').textContent = alerts.length;
    document.getElementById('analysisSummary').textContent = analysis.summary || 'No summary available';

    // Display all sections
    displayHotspots(hotspots);
    displayTrends(trends);
    displayRecommendations(recommendations);
    displayAlerts(alerts);
}

function displayHotspots(hotspots) {
    console.log('displayHotspots called with:', hotspots);

    const container = document.getElementById('hotspotsList');
    const countElement = document.getElementById('hotspotsCount');

    countElement.textContent = hotspots.length;

    if (hotspots.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="fas fa-fire"></i><p>No hotspots identified</p></div>';
        return;
    }

    container.innerHTML = hotspots.map(h => {
        const loc = h.location || {};
        const locationName = loc.city || loc.address || 'Unknown Location';
        const riskLevel = h.risk_level || 'low';
        const incidentCount = h.incident_count || 0;
        const crimeType = h.crime_type || '';
        const isMissing = h.is_missing_person_hotspot || false;

        return `
            <div class="list-item">
                <div class="item-header">
                    <span class="item-title">${locationName}</span>
                    <span class="item-badge ${riskLevel}">${riskLevel}</span>
                </div>
                <div class="item-meta">
                    <span><i class="fas fa-exclamation-circle"></i> ${incidentCount} incidents</span>
                    ${crimeType ? `<span><i class="fas fa-gavel"></i> ${crimeType}</span>` : ''}
                    <span><i class="fas fa-${isMissing ? 'user-slash' : 'user-secret'}"></i> ${isMissing ? 'Missing Persons' : 'Crime'}</span>
                </div>
            </div>
        `;
    }).join('');
}

function displayTrends(trends) {
    console.log('displayTrends called with:', trends);

    const container = document.getElementById('trendsList');
    const countElement = document.getElementById('trendsCount');

    countElement.textContent = trends.length;

    if (trends.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="fas fa-chart-line"></i><p>No trends identified</p></div>';
        return;
    }

    container.innerHTML = trends.map(t => {
        const crimeType = t.crime_type || 'General Trend';
        const severity = t.severity || 'low';
        const description = t.description || 'No description';
        const trendCategory = t.trend_category || '';
        const affectedDemo = t.affected_demographic || '';
        const timePattern = t.time_pattern || '';

        return `
            <div class="list-item">
                <div class="item-header">
                    <span class="item-title">${crimeType}</span>
                    <span class="item-badge ${severity}">${severity}</span>
                </div>
                <div class="item-description">${description}</div>
                ${(trendCategory || affectedDemo || timePattern) ? `
                    <div class="item-meta">
                        ${trendCategory ? `<span><i class="fas fa-layer-group"></i> ${trendCategory.replace('_', ' ')}</span>` : ''}
                        ${affectedDemo ? `<span><i class="fas fa-users"></i> ${affectedDemo}</span>` : ''}
                        ${timePattern ? `<span><i class="fas fa-clock"></i> ${timePattern}</span>` : ''}
                    </div>
                ` : ''}
            </div>
        `;
    }).join('');
}

function displayRecommendations(recommendations) {
    console.log('displayRecommendations called with:', recommendations);

    const container = document.getElementById('recommendationsList');
    const countElement = document.getElementById('recommendationsCount');

    countElement.textContent = recommendations.length;

    if (recommendations.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="fas fa-lightbulb"></i><p>No recommendations generated</p></div>';
        return;
    }

    container.innerHTML = recommendations.map(r => {
        const priority = r.priority || 'low';
        const text = r.recommendation_text || 'No recommendation text';

        return `
            <div class="list-item">
                <div class="item-header">
                    <span class="item-badge ${priority}">${priority}</span>
                </div>
                <div class="item-description">${text}</div>
            </div>
        `;
    }).join('');
}

function displayAlerts(alerts) {
    console.log('displayAlerts called with:', alerts);

    const container = document.getElementById('alertsList');
    const countElement = document.getElementById('alertsCount');

    countElement.textContent = alerts.length;

    if (alerts.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>No alerts will be created</p></div>';
        return;
    }

    container.innerHTML = alerts.map(a => {
        const location = a.location || 'Unknown Location';
        const message = a.message || 'No message';
        const recipientCount = a.recipient_count || 0;

        return `
            <div class="list-item">
                <div class="item-header">
                    <span class="item-title"><i class="fas fa-map-marker-alt"></i> ${location}</span>
                </div>
                <div class="item-description">${message}</div>
                <div class="item-meta">
                    <span><i class="fas fa-users"></i> ${recipientCount} recipient${recipientCount !== 1 ? 's' : ''}</span>
                </div>
            </div>
        `;
    }).join('');
}

// Initialize map - CLEAN VERSION
function initMap(hotspots, crimes) {
    console.log('initMap called with:', { hotspots: hotspots.length, crimes: crimes.length });

    if (map) {
        map.remove();
        map = null;
    }

    map = L.map('mapContainer').setView([-17.8292, 31.0522], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
    }).addTo(map);

    hotspotsLayer = L.layerGroup().addTo(map);
    crimesLayer = L.layerGroup();

    const bounds = [];

    // Add hotspots
    hotspots.forEach(h => {
        const loc = h.location;
        if (loc && loc.latitude && loc.longitude) {
            const lat = parseFloat(loc.latitude);
            const lng = parseFloat(loc.longitude);
            if (!isNaN(lat) && !isNaN(lng)) {
                bounds.push([lat, lng]);
                const color = getHotspotColor(h.risk_level || 'low');
                const radius = Math.max((h.incident_count || 1) * 50, 100);

                L.circle([lat, lng], {
                    color: color,
                    fillColor: color,
                    fillOpacity: 0.4,
                    radius: radius
                }).addTo(hotspotsLayer).bindPopup(`
                    <div style="font-family: inherit;">
                        <strong style="color: var(--text-primary); font-size: 14px;">${loc.city || loc.address || 'Hotspot'}</strong><br>
                        <span style="color: var(--text-secondary); font-size: 12px;">
                            Risk: <strong>${h.risk_level || 'Unknown'}</strong><br>
                            Incidents: <strong>${h.incident_count || 0}</strong><br>
                            ${h.crime_type ? `Type: <strong>${h.crime_type}</strong>` : ''}
                        </span>
                    </div>
                `);
            }
        }
    });

    // Add crimes
    crimes.forEach(c => {
        if (c.latitude && c.longitude) {
            const lat = parseFloat(c.latitude);
            const lng = parseFloat(c.longitude);
            if (!isNaN(lat) && !isNaN(lng)) {
                bounds.push([lat, lng]);
                const color = getCrimeColor(c.crime_type);

                L.circleMarker([lat, lng], {
                    radius: 8,
                    fillColor: color,
                    color: '#fff',
                    weight: 2,
                    fillOpacity: 0.8
                }).addTo(crimesLayer).bindPopup(`
                    <div style="font-family: inherit;">
                        <strong style="color: var(--text-primary); font-size: 14px;">${c.crime_type || 'Crime'}</strong><br>
                        <span style="color: var(--text-secondary); font-size: 12px;">
                            Status: <strong>${c.status || 'Unknown'}</strong><br>
                            ${c.date_committed ? `Date: <strong>${c.date_committed.substring(0, 10)}</strong>` : ''}
                        </span>
                    </div>
                `);
            }
        }
    });

    if (bounds.length > 0) {
        map.fitBounds(bounds, { padding: [50, 50] });
    }

    setTimeout(() => map.invalidateSize(), 200);
    setTimeout(() => map.invalidateSize(), 500);
}

function switchMapView(view) {
    if (!map) return;

    document.querySelectorAll('.map-tab').forEach(t => t.classList.remove('active'));
    event.target.closest('.map-tab').classList.add('active');

    if (view === 'hotspots') {
        map.removeLayer(crimesLayer);
        map.addLayer(hotspotsLayer);
    } else {
        map.removeLayer(hotspotsLayer);
        map.addLayer(crimesLayer);
    }

    setTimeout(() => map.invalidateSize(), 100);
}

function getHotspotColor(risk) {
    const colors = {
        low: '#4CAF50',
        medium: '#FFC107',
        high: '#FF5722',
        critical: '#F44336'
    };
    return colors[risk.toLowerCase()] || '#9E9E9E';
}

function getCrimeColor(type) {
    const colors = {
        murder: '#8B0000',
        homicide: '#8B0000',
        assault: '#DC143C',
        robbery: '#FF4500',
        burglary: '#FF8C00',
        theft: '#FFD700',
        larceny: '#FFD700',
        vandalism: '#9370DB',
        drug: '#8B4513',
        drugs: '#8B4513',
        fraud: '#4B0082',
        kidnapping: '#8B008B',
        arson: '#FF6347'
    };
    return colors[type?.toLowerCase()] || '#808080';
}

async function generateAnalysis() {
    if (!previewData) {
        alert('Please generate a preview first');
        return;
    }

    if (!confirm('Save this analysis permanently?\n\nThis will create the analysis report with all hotspots, trends, recommendations, and alert broadcasts using your selected clustering parameters.')) {
        return;
    }

    try {
        const formData = new FormData(document.getElementById('previewForm'));

        const response = await fetch('{{ url_for("analysis.generate_analysis") }}', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        console.log('Generate analysis response:', data);

        if (!response.ok || data.error) {
            throw new Error(data.message || 'Failed to generate analysis');
        }

        if (window.toast) {
            window.toast.success('Success', 'Analysis saved successfully');
        } else {
            alert('Success: Analysis saved successfully');
        }

        // Redirect to the analysis view page
        setTimeout(() => {
            if (data.value && data.value.redirect_url) {
                window.location.href = data.value.redirect_url;
            } else {
                window.location.href = '{{ url_for("analysis.list_analyses") }}';
            }
        }, 1000);

    } catch (error) {
        console.error('Generate analysis error:', error);
        if (window.toast) {
            window.toast.error('Error', error.message);
        } else {
            alert('Error: ' + error.message);
        }
    }
}
</script>
