{% extends 'base.jinja2' %}

{% set default_start = default_start_date if default_start_date else '' %}
{% set default_end = default_end_date if default_end_date else '' %}

{% block title %}Analysis Preview | Sentinel{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
/* ===========================
   NEW EXOTIC FLEXBOX LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.layout-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 20px;
    align-items: start;
}

.layout-full {
    grid-column: 1 / -1;
}

.layout-sidebar {
    position: sticky;
    top: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.layout-main {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 600px;
}

/* ===========================
   WELCOME STATE
   =========================== */
.welcome-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 40px;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    height: 100%;
    min-height: 500px;
}

.welcome-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.15));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    border: 2px solid var(--warning);
}

.welcome-icon i {
    font-size: 32px;
    color: var(--warning);
}

.welcome-content h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 12px 0;
}

.welcome-content p {
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0 0 28px 0;
    line-height: 1.5;
    max-width: 400px;
}

.welcome-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 32px;
    max-width: 400px;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px;
    background: rgba(10, 14, 39, 0.3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
}

.feature-item i {
    color: var(--warning);
    font-size: 14px;
}

.feature-item span {
    font-size: 12px;
    color: var(--text-primary);
    font-weight: 500;
}

/* ===========================
   COMPACT BREADCRUMB & HEADER
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 11px;
}

.page-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    z-index: 1;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 16px;
}

.header-icon {
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    flex-shrink: 0;
}

.header-icon i {
    font-size: 24px;
    color: var(--warning);
}

.header-text h1 {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
}

/* ===========================
   COMPACT FORM SIDEBAR
   =========================== */
.form-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: fit-content;
}

.sidebar-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.sidebar-title i {
    color: var(--warning);
    font-size: 18px;
}

.form-grid-compact {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.form-group-compact {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-label-compact {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.form-label-compact i {
    font-size: 11px;
    color: var(--warning);
}

.form-control-compact {
    padding: 10px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px;
    color: #ffffff;
    transition: var(--transition-fast);
    width: 100%;
}

.form-control-compact:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
}

.form-help-compact {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: -2px;
}

.checkbox-group-compact {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.checkbox-wrapper-compact {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
    cursor: pointer;
}

.checkbox-wrapper-compact:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.checkbox-wrapper-compact input {
    width: 16px;
    height: 16px;
    cursor: pointer;
}

.checkbox-label-compact {
    font-size: 13px;
    color: var(--text-primary);
    cursor: pointer;
}

.form-actions-compact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
}

/* ===========================
   QUICK STATS SIDEBAR
   =========================== */
.quick-stats-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stats-title-compact {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.stats-title-compact i {
    color: var(--warning);
    font-size: 16px;
}

.stats-grid-compact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.stat-item-compact {
    padding: 10px;
    background: rgba(10, 14, 39, 0.3);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: center;
}

.stat-value-compact {
    font-size: 18px;
    font-weight: 700;
    color: var(--warning);
    margin-bottom: 2px;
    line-height: 1;
}

.stat-label-compact {
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

/* ===========================
   COMPACT BUTTONS WITH LOADING
   =========================== */
.btn {
    padding: 10px 16px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: var(--transition);
    justify-content: center;
}

.btn i {
    font-size: 14px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--warning), #d97706);
    color: white;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    color: white;
}

.btn-secondary {
    background: transparent;
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--warning);
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* ===========================
   EXOTIC PREVIEW LAYOUT - DYNAMIC HEIGHT
   =========================== */
.preview-results {
    display: none;
}

.preview-results.show {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 16px;
    height: 100%;
}

/* ===========================
   COMPACT STATS GRID
   =========================== */
.stats-grid-main {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.stat-card-compact {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    text-align: center;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.stat-card-compact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--warning), #d97706);
    opacity: 0;
    transition: var(--transition);
}

.stat-card-compact:hover {
    transform: translateY(-1px);
    border-color: var(--warning);
}

.stat-card-compact:hover::before {
    opacity: 1;
}

.stat-value-main {
    font-size: 24px;
    font-weight: 700;
    color: var(--warning);
    margin-bottom: 4px;
}

.stat-label-main {
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
}

/* ===========================
   COMPACT SUMMARY BOX
   =========================== */
.summary-box-compact {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
}

.summary-box-compact h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 12px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
}

.summary-box-compact h3 i {
    color: var(--warning);
    font-size: 18px;
}

.summary-box-compact p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
}

/* ===========================
   DYNAMIC HEIGHT TWO-COLUMN LAYOUT
   =========================== */
.preview-content-dynamic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
    gap: 16px;
    height: 100%;
    min-height: auto;
}

/* DYNAMIC MAP SECTION - ADJUSTS TO CARDS HEIGHT */
.map-section-dynamic {
    grid-column: 1;
    grid-row: 1;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 400px;
    height: fit-content;
}

.map-header-compact {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    flex-shrink: 0;
}

.map-header-compact h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.map-header-compact h3 i {
    color: var(--warning);
    font-size: 16px;
}

.map-tabs-compact {
    display: flex;
    gap: 6px;
}

.map-tab-compact {
    padding: 6px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 4px;
}

.map-tab-compact:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.map-tab-compact.active {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(217, 119, 6, 0.2));
    border-color: var(--warning);
    color: var(--warning);
}

/* DYNAMIC MAP CONTAINER */
#mapContainer {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background: #1a1d2e;
    position: relative;
    flex: 1;
}

.leaflet-container {
    background: #1a1d2e;
    font-family: inherit;
}

/* RIGHT SIDEBAR - ALL CARDS STACKED */
.cards-stack-full {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: fit-content;
}

.content-card-full-height {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 200px;
    height: fit-content;
}

.card-header-full {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    flex-shrink: 0;
}

.card-title-full {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
}

.card-title-full i {
    color: var(--warning);
    font-size: 15px;
}

.card-count-full {
    font-size: 11px;
    color: var(--warning);
    padding: 3px 8px;
    background: rgba(245, 158, 11, 0.15);
    border-radius: 6px;
    font-weight: 600;
}

.card-body-full {
    padding: 16px;
    overflow: visible;
    flex: 1;
    max-height: none;
}

/* FULL WIDTH GENERATE SECTION */
.generate-section-full {
    grid-column: 1 / -1;
    grid-row: 2;
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
}

.generate-section-full h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
}

.generate-section-full p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
}

/* ===========================
   ULTRA COMPACT LIST ITEMS - NO SCROLL
   =========================== */
.list-item-ultra-compact {
    padding: 10px 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 8px;
}

.list-item-ultra-compact:last-child {
    margin-bottom: 0;
}

.list-item-ultra-compact:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.item-header-ultra-compact {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
}

.item-title-ultra-compact {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    flex: 1;
}

.item-badge-ultra-compact {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.3px;
    flex-shrink: 0;
    /* Default styling for unspecified badges */
    background: rgba(156, 163, 175, 0.15);
    color: var(--text-muted);
    border: 1px solid rgba(156, 163, 175, 0.3);
}

.item-badge-ultra-compact.high {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.item-badge-ultra-compact.medium {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.item-badge-ultra-compact.low {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.item-badge-ultra-compact.urgent {
    background: rgba(239, 68, 68, 0.2);
    color: #ff1744;
    border: 1px solid rgba(239, 68, 68, 0.5);
}

.item-description-ultra-compact {
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.item-meta-ultra-compact {
    display: flex;
    gap: 8px;
    font-size: 10px;
    color: var(--text-muted);
    flex-wrap: wrap;
}

.item-meta-ultra-compact span {
    display: flex;
    align-items: center;
    gap: 3px;
}

.item-meta-ultra-compact i {
    font-size: 9px;
}

/* HOTSPOT ITEMS - NO SCROLL */
.hotspot-item-full {
    padding: 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 8px;
}

.hotspot-item-full:last-child {
    margin-bottom: 0;
}

.hotspot-item-full:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--warning);
}

.hotspot-header-full {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
}

.hotspot-location-full {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
    flex: 1;
}

.hotspot-badge-full {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.3px;
    flex-shrink: 0;
}

.hotspot-badge-full.high {
    background: rgba(239, 68, 68, 0.15);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.hotspot-badge-full.medium {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.hotspot-badge-full.low {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.hotspot-stats-full {
    display: flex;
    gap: 8px;
    font-size: 10px;
    color: var(--text-muted);
}

.hotspot-stats-full span {
    display: flex;
    align-items: center;
    gap: 3px;
}

.hotspot-stats-full i {
    font-size: 9px;
}

.empty-state-compact {
    text-align: center;
    padding: 30px 16px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
}

.empty-state-compact i {
    font-size: 32px;
    margin-bottom: 8px;
    opacity: 0.5;
}

.empty-state-compact p {
    font-size: 13px;
    margin: 0;
}

/* ===========================
   RESPONSIVE DESIGN
   =========================== */
@media (max-width: 1200px) {
    .layout-grid {
        grid-template-columns: 280px 1fr;
    }

    .preview-content-dynamic {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
    }

    .map-section-dynamic {
        grid-column: 1;
        grid-row: 1;
    }

    .cards-stack-full {
        grid-column: 1;
        grid-row: 2;
    }

    .generate-section-full {
        grid-column: 1;
        grid-row: 3;
    }
}

@media (max-width: 968px) {
    .layout-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .layout-sidebar {
        position: static;
        order: 2;
    }

    .layout-main {
        order: 1;
    }

    .stats-grid-main {
        grid-template-columns: repeat(2, 1fr);
    }

    .welcome-features {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .page-header {
        padding: 16px 20px;
    }

    .header-content {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-left {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .header-text h1 {
        font-size: 20px;
    }

    .map-header-compact {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .map-tabs-compact {
        width: 100%;
        justify-content: center;
    }

    .stats-grid-main {
        grid-template-columns: 1fr;
    }

    .welcome-state {
        padding: 60px 20px;
    }

    .welcome-icon {
        width: 60px;
        height: 60px;
    }

    .welcome-icon i {
        font-size: 24px;
    }

    .welcome-content h2 {
        font-size: 20px;
    }
}

@media (max-width: 480px) {
    .form-sidebar,
    .quick-stats-sidebar {
        padding: 16px;
    }

    .card-body-full {
        padding: 12px;
    }

    .welcome-state {
        padding: 40px 16px;
    }
}
</style>
