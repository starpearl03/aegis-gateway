                </div>
            </div>
        </div>

        <!-- RIGHT MAIN: Welcome State / Results -->
        <div class="layout-main">
            <!-- Welcome State (Shown Initially) -->
            <div class="welcome-state" id="welcomeState">
                <div class="welcome-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="welcome-content">
                    <h2>Ready to Analyze Crime Data?</h2>
                    <p>Configure your analysis parameters on the left and generate a preview to see AI-powered insights, hotspots, trends, and recommendations.</p>
                    <button type="button" class="btn btn-primary" id="welcomePreviewBtn">
                        <i class="fas fa-bolt"></i>
                        Generate Your First Preview
                    </button>

                    <div class="welcome-features">
                        <div class="feature-item">
                            <i class="fas fa-fire"></i>
                            <span>Hotspot Detection</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-chart-line"></i>
                            <span>Trend Analysis</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-lightbulb"></i>
                            <span>AI Recommendations</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-map-marked-alt"></i>
                            <span>Interactive Maps</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results (Hidden Initially) -->
            <div class="preview-results" id="previewResults">
                <!-- Main Stats -->
                <div class="stats-grid-main">
                    <div class="stat-card-compact">
                        <div class="stat-value-main" id="totalCrimes">0</div>
                        <div class="stat-label-main">Total Crimes</div>
                    </div>
                    <div class="stat-card-compact">
                        <div class="stat-value-main" id="totalMissingPersons">0</div>
                        <div class="stat-label-main">Missing Persons</div>
                    </div>
                    <div class="stat-card-compact">
                        <div class="stat-value-main" id="totalHotspots">0</div>
                        <div class="stat-label-main">Hotspots</div>
                    </div>
                    <div class="stat-card-compact">
                        <div class="stat-value-main" id="totalAlerts">0</div>
                        <div class="stat-label-main">Alerts</div>
                    </div>
                </div>

                <!-- Summary -->
                <div class="summary-box-compact">
                    <h3>
                        <i class="fas fa-file-alt"></i>
                        Analysis Summary
                    </h3>
                    <p id="analysisSummary">Generate a preview to see the analysis summary...</p>
                </div>

                <!-- Dynamic Height Two-Column Layout -->
                <div class="preview-content-dynamic">
                    <!-- Dynamic Map Section (Left) -->
                    <div class="map-section-dynamic">
                        <div class="map-header-compact">
                            <h3>
                                <i class="fas fa-map-marked-alt"></i>
                                Crime Analysis Map
                            </h3>
                            <div class="map-tabs-compact">
                                <button type="button" class="map-tab-compact active" data-view="hotspots" onclick="switchMapView('hotspots')">
                                    <i class="fas fa-fire"></i> Hotspots
                                </button>
                                <button type="button" class="map-tab-compact" data-view="crimes" onclick="switchMapView('crimes')">
                                    <i class="fas fa-map-pin"></i> Crimes
                                </button>
                            </div>
                        </div>
                        <div id="mapContainer"></div>
                    </div>

                    <!-- Right Sidebar - All Cards Stacked -->
                    <div class="cards-stack-full">
                        <!-- Trends Card -->
                        <div class="content-card-full-height">
                            <div class="card-header-full">
                                <h3 class="card-title-full">
                                    <i class="fas fa-chart-line"></i>
                                    Crime Trends
                                </h3>
                                <span class="card-count-full" id="trendsCount">0</span>
                            </div>
                            <div class="card-body-full">
                                <div class="compact-content" id="trendsList">
                                    <div class="empty-state-compact">
                                        <i class="fas fa-chart-line"></i>
                                        <p>No trends identified</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Recommendations Card -->
                        <div class="content-card-full-height">
                            <div class="card-header-full">
                                <h3 class="card-title-full">
                                    <i class="fas fa-lightbulb"></i>
                                    Recommendations
                                </h3>
                                <span class="card-count-full" id="recommendationsCount">0</span>
                            </div>
                            <div class="card-body-full">
                                <div class="compact-content" id="recommendationsList">
                                    <div class="empty-state-compact">
                                        <i class="fas fa-lightbulb"></i>
                                        <p>No recommendations generated</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Hotspots Card -->
                        <div class="content-card-full-height">
                            <div class="card-header-full">
                                <h3 class="card-title-full">
                                    <i class="fas fa-fire"></i>
                                    Crime Hotspots
                                </h3>
                                <span class="card-count-full" id="hotspotsCount">0</span>
                            </div>
                            <div class="card-body-full">
                                <div class="compact-content" id="hotspotsList">
                                    <div class="empty-state-compact">
                                        <i class="fas fa-fire"></i>
                                        <p>No hotspots identified</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Full Width Generate Section -->
                    <div class="generate-section-full">
                        <h3>Ready to Generate Full Report?</h3>
                        <p>Save this analysis permanently with all insights, hotspots, trends, and recommendations.</p>
                        <button type="button" class="btn btn-primary" onclick="generateAnalysis()">
                            <i class="fas fa-save"></i>
                            Generate & Save Analysis Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
let previewData = null;
let map = null;
let hotspotsLayer = null;
let crimesLayer = null;

// Welcome button loading state
document.getElementById('welcomePreviewBtn').addEventListener('click', function() {
    const btn = this;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

    // Trigger form submission
    document.getElementById('previewBtn').click();

    // Reset button after 5 seconds if something goes wrong
    setTimeout(() => {
        if (btn.disabled) {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    }, 5000);
});

// Form submission
document.getElementById('previewForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn = document.getElementById('previewBtn');
    const welcomeBtn = document.getElementById('welcomePreviewBtn');

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

    if (welcomeBtn) {
        welcomeBtn.disabled = true;
        welcomeBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
    }

    try {
        const response = await fetch('{{ url_for("analysis.preview_analysis") }}', {
            method: 'POST',
            body: new FormData(this)
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            throw new Error(data.message || 'Failed to generate preview');
        }

        previewData = data.value;
        displayResults(previewData);

        // Hide welcome state and show results
        document.getElementById('welcomeState').style.display = 'none';
        document.getElementById('previewResults').classList.add('show');

        // Initialize map AFTER showing results
        setTimeout(() => {
            const hotspots = previewData.hotspots || [];
            const crimes = previewData.individual_crimes || [];
            initMap(hotspots, crimes);
        }, 600);

        if (window.toast) window.toast.success('Success', 'Preview generated');

    } catch (error) {
        console.error('Preview error:', error);
        if (window.toast) window.toast.error('Error', error.message);
        else alert('Error: ' + error.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-eye"></i> Generate Preview';

        if (welcomeBtn) {
            welcomeBtn.disabled = false;
            welcomeBtn.innerHTML = '<i class="fas fa-bolt"></i> Generate Your First Preview';
        }
    }
});

function displayResults(data) {
    const analysis = data.analysis || {};
    const hotspots = data.hotspots || [];
    const trends = data.trends || [];
    const recommendations = data.recommendations || [];
    const alerts = data.preview_alerts || [];

    // Update main stats
    document.getElementById('totalCrimes').textContent = analysis.total_crimes || 0;
    document.getElementById('totalMissingPersons').textContent = analysis.total_missing_persons || 0;
    document.getElementById('totalHotspots').textContent = hotspots.length;
    document.getElementById('totalAlerts').textContent = alerts.length;
    document.getElementById('analysisSummary').textContent = analysis.summary || 'No summary available';

    // Update sidebar stats
    document.getElementById('sidebarTotalCrimes').textContent = analysis.total_crimes || 0;
    document.getElementById('sidebarTotalMissing').textContent = analysis.total_missing_persons || 0;
    document.getElementById('sidebarTotalHotspots').textContent = hotspots.length;
    document.getElementById('sidebarTotalAlerts').textContent = alerts.length;

    // Display all sections
    displayHotspots(hotspots);
    displayTrends(trends);
    displayRecommendations(recommendations);

    // Adjust map height after content loads
    setTimeout(adjustMapHeight, 100);
}

function adjustMapHeight() {
    const mapSection = document.querySelector('.map-section-dynamic');
    const cardsStack = document.querySelector('.cards-stack-full');

    if (mapSection && cardsStack) {
        const cardsHeight = cardsStack.offsetHeight;
        mapSection.style.minHeight = Math.max(400, cardsHeight) + 'px';

        // Refresh map size
        if (map) {
            setTimeout(() => map.invalidateSize(), 200);
        }
    }
}

function displayHotspots(hotspots) {
    const container = document.getElementById('hotspotsList');
    const countElement = document.getElementById('hotspotsCount');

    countElement.textContent = hotspots.length;

    if (hotspots.length === 0) {
        container.innerHTML = '<div class="empty-state-compact"><i class="fas fa-fire"></i><p>No hotspots identified</p></div>';
        return;
    }

    container.innerHTML = hotspots.map(h => {
        const loc = h.location || {};
        const locationName = loc.city || loc.address || 'Unknown Location';
        const riskLevel = h.risk_level || 'low';
        const incidentCount = h.incident_count || 0;
        const crimeType = h.crime_type || '';
        const isMissing = h.is_missing_person_hotspot || false;

        return `
            <div class="hotspot-item-full">
                <div class="hotspot-header-full">
                    <div class="hotspot-location-full">${locationName}</div>
                    <div class="hotspot-badge-full ${riskLevel}">${riskLevel}</div>
                </div>
                <div class="hotspot-stats-full">
                    <span><i class="fas fa-exclamation-circle"></i> ${incidentCount} incidents</span>
                    ${isMissing ? `<span><i class="fas fa-user-slash"></i> Missing Persons</span>` : (crimeType ? `<span><i class="fas fa-gavel"></i> ${crimeType}</span>` : '')}
                </div>
            </div>
        `;
    }).join('');
}

function displayTrends(trends) {
    const container = document.getElementById('trendsList');
    const countElement = document.getElementById('trendsCount');

    countElement.textContent = trends.length;

    if (trends.length === 0) {
        container.innerHTML = '<div class="empty-state-compact"><i class="fas fa-chart-line"></i><p>No trends identified</p></div>';
        return;
    }

    container.innerHTML = trends.map(t => {
        const crimeType = t.crime_type || 'General Trend';
        const severity = t.severity || 'low';
        const description = t.description || 'No description';
        const trendCategory = t.trend_category || '';
        const affectedDemo = t.affected_demographic || '';
        const timePattern = t.time_pattern || '';

        return `
            <div class="list-item-ultra-compact">
                <div class="item-header-ultra-compact">
                    <span class="item-title-ultra-compact">${crimeType}</span>
                    <span class="item-badge-ultra-compact ${severity}">${severity}</span>
                </div>
                <div class="item-description-ultra-compact">${description}</div>
                ${(trendCategory || affectedDemo || timePattern) ? `
                    <div class="item-meta-ultra-compact">
                        ${trendCategory ? `<span><i class="fas fa-layer-group"></i> ${trendCategory.replace('_', ' ')}</span>` : ''}
                        ${affectedDemo ? `<span><i class="fas fa-users"></i> ${affectedDemo}</span>` : ''}
                        ${timePattern ? `<span><i class="fas fa-clock"></i> ${timePattern}</span>` : ''}
                    </div>
                ` : ''}
            </div>
        `;
    }).join('');
}

function displayRecommendations(recommendations) {
    const container = document.getElementById('recommendationsList');
    const countElement = document.getElementById('recommendationsCount');

    countElement.textContent = recommendations.length;

    if (recommendations.length === 0) {
        container.innerHTML = '<div class="empty-state-compact"><i class="fas fa-lightbulb"></i><p>No recommendations generated</p></div>';
        return;
    }

    container.innerHTML = recommendations.map(r => {
        const priority = r.priority || 'low';
        const text = r.recommendation_text || 'No recommendation text';

        return `
            <div class="list-item-ultra-compact">
                <div class="item-header-ultra-compact">
                    <span class="item-badge-ultra-compact ${priority}">${priority}</span>
                </div>
                <div class="item-description-ultra-compact">${text}</div>
            </div>
        `;
    }).join('');
}

// Initialize map
function initMap(hotspots, crimes) {
    if (map) {
        map.remove();
        map = null;
    }

    map = L.map('mapContainer').setView([-17.8292, 31.0522], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
    }).addTo(map);

    hotspotsLayer = L.layerGroup().addTo(map);
    crimesLayer = L.layerGroup();

    const bounds = [];

    // Add hotspots using colors from backend
    hotspots.forEach(h => {
        const loc = h.location;
        if (loc && loc.latitude && loc.longitude) {
            const lat = parseFloat(loc.latitude);
            const lng = parseFloat(loc.longitude);
            if (!isNaN(lat) && !isNaN(lng)) {
                bounds.push([lat, lng]);

                // ✅ Use color from backend data
                const color = h.color || '#9E9E9E';
                const radius = Math.max((h.incident_count || 1) * 50, 100);

                L.circle([lat, lng], {
                    color: color,
                    fillColor: color,
                    fillOpacity: 0.4,
                    radius: radius
                }).addTo(hotspotsLayer).bindPopup(`
                    <div style="font-family: inherit;">
                        <strong style="color: var(--text-primary); font-size: 14px;">${loc.city || loc.address || 'Hotspot'}</strong><br>
                        <span style="color: var(--text-secondary); font-size: 12px;">
                            Risk: <strong>${h.risk_level || 'Unknown'}</strong><br>
                            Incidents: <strong>${h.incident_count || 0}</strong><br>
                            ${h.is_missing_person_hotspot
                                ? 'Type: <strong>Missing Person</strong>'
                                : (h.crime_type ? `Type: <strong>${h.crime_type}</strong>` : '')
                            }
                        </span>
                    </div>
                `);
            }
        }
    });

    // Add crimes using colors from backend
    crimes.forEach(c => {
        if (c.latitude && c.longitude) {
            const lat = parseFloat(c.latitude);
            const lng = parseFloat(c.longitude);
            if (!isNaN(lat) && !isNaN(lng)) {
                bounds.push([lat, lng]);

                // ✅ Use color directly from backend data
                const color = c.color || '#808080';

                L.circleMarker([lat, lng], {
                    radius: 8,
                    fillColor: color,
                    color: '#fff',
                    weight: 2,
                    fillOpacity: 0.8
                }).addTo(crimesLayer).bindPopup(`
                    <div style="font-family: inherit;">
                        <strong style="color: var(--text-primary); font-size: 14px;">${c.crime_type || 'Crime'}</strong><br>
                        <span style="color: var(--text-secondary); font-size: 12px;">
                            Status: <strong>${c.status || 'Unknown'}</strong><br>
                            ${c.date_committed ? `Date: <strong>${c.date_committed.substring(0, 10)}</strong>` : ''}
                        </span>
                    </div>
                `);
            }
        }
    });

    if (bounds.length > 0) {
        map.fitBounds(bounds, { padding: [50, 50] });
    }

    setTimeout(() => map.invalidateSize(), 200);
    setTimeout(() => map.invalidateSize(), 500);
}

function switchMapView(view) {
    if (!map) return;

    document.querySelectorAll('.map-tab-compact').forEach(t => t.classList.remove('active'));
    event.target.closest('.map-tab-compact').classList.add('active');

    if (view === 'hotspots') {
        map.removeLayer(crimesLayer);
        map.addLayer(hotspotsLayer);
    } else {
        map.removeLayer(hotspotsLayer);
        map.addLayer(crimesLayer);
    }

    setTimeout(() => map.invalidateSize(), 100);
}

async function generateAnalysis() {
    if (!previewData) {
        alert('Please generate a preview first');
        return;
    }

    if (!confirm('Save this analysis permanently?\n\nThis will create the analysis report with all hotspots, trends, recommendations, and alert broadcasts using your selected clustering parameters.')) {
        return;
    }

    try {
        const formData = new FormData(document.getElementById('previewForm'));

        const response = await fetch('{{ url_for("analysis.generate_analysis") }}', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            throw new Error(data.message || 'Failed to generate analysis');
        }

        if (window.toast) {
            window.toast.success('Success', 'Analysis saved successfully');
        } else {
            alert('Success: Analysis saved successfully');
        }

        // Redirect to the analysis view page
        setTimeout(() => {
            if (data.value && data.value.redirect_url) {
                window.location.href = data.value.redirect_url;
            } else {
                window.location.href = '{{ url_for("analysis.list_analyses") }}';
            }
        }, 1000);

    } catch (error) {
        console.error('Generate analysis error:', error);
        if (window.toast) {
            window.toast.error('Error', error.message);
        } else {
            alert('Error: ' + error.message);
        }
    }
}

// Adjust map height on window resize
window.addEventListener('resize', adjustMapHeight);
</script>
{% endblock %}