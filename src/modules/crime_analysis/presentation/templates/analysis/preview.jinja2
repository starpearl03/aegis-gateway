                    </div>
                </form>
            </div>

            <!-- Quick Stats Sidebar -->
            <div class="quick-stats-sidebar">
                <h3 class="stats-title-compact">
                    <i class="fas fa-chart-pie"></i>
                    Quick Stats
                </h3>
                <div class="stats-grid-compact">
                    <div class="stat-item-compact">
                        <div class="stat-value-compact" id="sidebarTotalCrimes">0</div>
                        <div class="stat-label-compact">Total Crimes</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact" id="sidebarTotalMissing">0</div>
                        <div class="stat-label-compact">Missing Persons</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact" id="sidebarTotalHotspots">0</div>
                        <div class="stat-label-compact">Hotspots</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact" id="sidebarTotalAlerts">0</div>
