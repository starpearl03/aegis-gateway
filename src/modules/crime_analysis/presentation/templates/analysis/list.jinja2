{% extends 'base.jinja2' %}

{% set analyses_list = analyses if analyses else [] %}
{% set pagination_data = pagination if pagination else {} %}
{% set filters_data = filters if filters else {} %}
{% set current_generated_by = filters_data.generated_by if filters_data.generated_by else '' %}
{% set current_start_date = filters_data.start_date if filters_data.start_date else '' %}
{% set current_end_date = filters_data.end_date if filters_data.end_date else '' %}
{% set include_deleted = filters_data.include_deleted if filters_data.include_deleted else false %}

{% block title %}Analysis Reports | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   NEW LAYOUT SYSTEM
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.layout-grid {
    display: grid;
    grid-template-columns: 300px 1fr; /* Fixed sidebar + flexible main */
    gap: 24px;
    align-items: start;
}

.layout-full {
    grid-column: 1 / -1;
}

.layout-sidebar {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.layout-main {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* ===========================
   COMPACT FILTERS SIDEBAR
   =========================== */
.filters-sidebar {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: fit-content;
}

.filters-header {
    padding: 16px 20px; /* More compact */
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-title {
    font-size: 15px; /* Smaller */
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px; /* Tighter */
    margin: 0;
}

.filters-title i {
    color: var(--primary-gold);
    font-size: 16px; /* Smaller icon */
}

.clear-filters-btn {
    font-size: 12px; /* Smaller */
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 4px; /* Tighter */
}

.clear-filters-btn:hover {
    color: var(--primary-gold);
}

.filters-body {
    padding: 16px; /* More compact */
}

.filters-grid {
    display: flex;
    flex-direction: column;
    gap: 12px; /* Tighter spacing */
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px; /* Tighter */
}

.filter-label {
    font-size: 12px; /* Smaller */
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-control {
    padding: 10px 12px; /* More compact */
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px; /* Smaller */
    color: #ffffff;
    transition: var(--transition-fast);
    font-family: inherit;
    width: 100%;
}

.filter-control:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

.filter-control option {
    background: var(--bg-tertiary);
    color: #ffffff;
}

.checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 8px; /* Tighter */
    padding: 10px 12px; /* More compact */
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition);
}

.checkbox-wrapper:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
}

.checkbox-wrapper input[type="checkbox"] {
    width: 16px; /* Smaller */
    height: 16px;
    cursor: pointer;
}

.checkbox-label {
    font-size: 13px; /* Smaller */
    color: var(--text-primary);
    cursor: pointer;
}

.filter-actions {
    display: flex;
    flex-direction: column; /* Stack buttons */
    gap: 8px; /* Tighter */
    margin-top: 8px;
}

/* ===========================
   QUICK STATS CARD
   =========================== */
.quick-stats {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px; /* More compact */
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stats-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
}

.stats-title i {
    color: var(--primary-gold);
    font-size: 16px;
}

.stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.stat-item-compact {
    padding: 10px;
    background: rgba(10, 14, 39, 0.3);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: center;
}

.stat-value-compact {
    font-size: 18px; /* Smaller */
    font-weight: 700;
    color: var(--primary-gold);
    margin-bottom: 2px;
    line-height: 1;
}

.stat-label-compact {
    font-size: 10px; /* Smaller */
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   PAGE HEADER - COMPACT
   =========================== */
.page-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 24px; /* More compact */
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 200px; /* Smaller */
    height: 200px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    z-index: 1;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 16px; /* Tighter */
}

.header-icon {
    width: 56px; /* Smaller */
    height: 56px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(184, 134, 11, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--border-gold);
}

.header-icon i {
    font-size: 24px; /* Smaller */
    color: var(--primary-gold);
}

.header-text h1 {
    font-size: 22px; /* Smaller */
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 13px; /* Smaller */
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
}

.header-actions {
    display: flex;
    gap: 10px; /* Tighter */
}

/* ===========================
   ANALYSES GRID - IMPROVED LAYOUT
   =========================== */
.analyses-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.analyses-header {
    padding: 16px 20px; /* More compact */
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.analyses-title {
    font-size: 16px; /* Smaller */
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px; /* Tighter */
    margin: 0;
}

.analyses-title i {
    color: var(--primary-gold);
    font-size: 18px; /* Smaller */
}

.analyses-count {
    font-size: 12px; /* Smaller */
    color: var(--text-muted);
    padding: 4px 10px; /* More compact */
    background: rgba(10, 14, 39, 0.4);
    border-radius: var(--radius-md);
}

.analyses-body {
    padding: 20px; /* More compact */
}

.analyses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); /* Better card sizing */
    gap: 16px;
}

/* ===========================
   ANALYSIS CARD - COMPACT
   =========================== */
.analysis-card {
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    height: fit-content;
}

.analysis-card:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.analysis-card-body {
    padding: 16px; /* More compact */
    display: flex;
    flex-direction: column;
    gap: 12px; /* Tighter spacing */
}

.analysis-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.analysis-info {
    flex: 1;
    min-width: 0;
}

.analysis-id {
    font-size: 10px; /* Smaller */
    color: var(--text-muted);
    font-family: monospace;
    margin-bottom: 4px;
}

.analysis-period {
    font-size: 14px; /* Smaller */
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
}

.analysis-generated-by {
    font-size: 11px; /* Smaller */
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 4px;
}

.analysis-generated-by i {
    color: var(--primary-gold);
    font-size: 10px;
}

.analysis-date {
    text-align: right;
    flex-shrink: 0;
}

.analysis-date-label {
    font-size: 10px; /* Smaller */
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    margin-bottom: 2px;
}

.analysis-date-value {
    font-size: 12px; /* Smaller */
    color: var(--text-primary);
    font-weight: 500;
}

.analysis-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px; /* Tighter */
}

.stat-item {
    padding: 10px; /* More compact */
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: center;
}

.stat-value {
    font-size: 16px; /* Smaller */
    font-weight: 700;
    color: var(--primary-gold);
    margin-bottom: 2px;
    line-height: 1;
}

.stat-label {
    font-size: 10px; /* Smaller */
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

.analysis-summary {
    padding: 10px 12px; /* More compact */
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
}

.summary-text {
    font-size: 12px; /* Smaller */
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.analysis-actions {
    display: flex;
    gap: 8px; /* Tighter */
}

.action-btn {
    padding: 8px 14px; /* More compact */
    border-radius: var(--radius-md);
    font-size: 12px; /* Smaller */
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 6px; /* Tighter */
    text-decoration: none;
    flex: 1; /* Equal width buttons */
    justify-content: center;
}

.action-btn i {
    font-size: 12px; /* Smaller */
}

.action-btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
}

.action-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-gold-subtle);
    color: white;
}

.action-btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.action-btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

.action-btn-danger {
    background: var(--error-bg);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.action-btn-danger:hover {
    background: var(--error);
    color: white;
    border-color: var(--error);
}

/* ===========================
   EMPTY STATE
   =========================== */
.empty-state {
    text-align: center;
    padding: 60px 20px; /* More compact */
    color: var(--text-muted);
    grid-column: 1 / -1;
}

.empty-state i {
    font-size: 60px; /* Smaller */
    margin-bottom: 20px;
    opacity: 0.5;
    color: var(--primary-gold);
}

.empty-state h3 {
    font-size: 18px; /* Smaller */
    color: var(--text-primary);
    margin-bottom: 8px;
    font-weight: 600;
}

.empty-state p {
    font-size: 14px; /* Smaller */
    margin-bottom: 20px;
    line-height: 1.5;
}

/* ===========================
   PAGINATION
   =========================== */
.pagination-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px; /* More compact */
    gap: 12px;
}

.pagination {
    display: flex;
    gap: 6px; /* Tighter */
    align-items: center;
}

.page-link {
    padding: 8px 12px; /* More compact */
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px; /* Smaller */
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 4px; /* Tighter */
}

.page-link:hover:not(.disabled):not(.active) {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    color: var(--primary-gold);
}

.page-link.active {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    border-color: var(--primary-gold);
    color: white;
}

.page-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.page-info {
    font-size: 12px; /* Smaller */
    color: var(--text-muted);
    padding: 0 8px;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 10px 18px; /* More compact */
    border-radius: var(--radius-md);
    font-size: 13px; /* Smaller */
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px; /* Tighter */
    text-decoration: none;
}

.btn i {
    font-size: 14px; /* Smaller */
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
}

.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-gold-subtle);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 1200px) {
    .layout-grid {
        grid-template-columns: 280px 1fr; /* Slightly smaller sidebar */
    }

    .analyses-grid {
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    }
}

@media (max-width: 968px) {
    .layout-grid {
        grid-template-columns: 1fr; /* Stack on mobile */
        gap: 16px;
    }

    .layout-sidebar {
        position: static;
        order: 2; /* Move sidebar below main content */
    }

    .layout-main {
        order: 1;
    }

    .analyses-grid {
        grid-template-columns: 1fr; /* Single column on mobile */
    }

    .header-content {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-actions {
        width: 100%;
    }

    .analysis-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .page-header {
        padding: 16px 20px;
    }

    .header-left {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .header-text h1 {
        font-size: 20px;
    }

    .analyses-grid {
        grid-template-columns: 1fr;
    }

    .analysis-actions {
        flex-direction: column;
    }

    .action-btn {
        width: 100%;
    }

    .pagination {
        flex-wrap: wrap;
        justify-content: center;
    }

    .analysis-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .analysis-date {
        text-align: left;
        align-self: flex-start;
    }
}

@media (max-width: 480px) {
    .analyses-body {
        padding: 16px;
    }

    .analysis-card-body {
        padding: 12px;
    }

    .analysis-stats {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb layout-full">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Analysis Reports</span>
        </span>
    </div>

    <!-- Page Header -->
    <div class="page-header layout-full">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <div class="header-text">
                    <h1>Crime Analysis Reports</h1>
                    <p>View and manage AI-powered crime analysis reports with hotspots, trends, and recommendations</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="{{ url_for('analysis.preview_analysis') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    New Analysis
                </a>
            </div>
        </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="layout-grid">
        <!-- LEFT SIDEBAR: Filters & Quick Stats -->
        <div class="layout-sidebar">
            <!-- Compact Filters -->
            <div class="filters-sidebar">
                <div class="filters-header">
                    <h2 class="filters-title">
                        <i class="fas fa-filter"></i>
                        Filters
                    </h2>
                    <a href="{{ url_for('analysis.list_analyses') }}" class="clear-filters-btn">
                        <i class="fas fa-times-circle"></i>
                        Clear
                    </a>
                </div>
                <div class="filters-body">
                    <form method="GET" action="{{ url_for('analysis.list_analyses') }}">
                        <div class="filters-grid">
                            <!-- Generated By Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-user"></i>
                                    Generated By
                                </label>
                                <input type="text"
                                       name="generated_by"
                                       class="filter-control"
                                       placeholder="User ID"
                                       value="{{ current_generated_by }}">
                            </div>

                            <!-- Start Date Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-calendar-alt"></i>
                                    Start Date
                                </label>
                                <input type="date"
                                       name="start_date"
                                       class="filter-control"
                                       value="{{ current_start_date }}">
                            </div>

                            <!-- End Date Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-calendar-check"></i>
                                    End Date
                                </label>
                                <input type="date"
                                       name="end_date"
                                       class="filter-control"
                                       value="{{ current_end_date }}">
                            </div>

                            <!-- Per Page Filter -->
                            <div class="filter-group">
                                <label class="filter-label">
                                    <i class="fas fa-list"></i>
                                    Per Page
                                </label>
                                <select name="per_page" class="filter-control">
                                    <option value="10" {% if pagination_data.per_page == 10 %}selected{% endif %}>10</option>
                                    <option value="20" {% if pagination_data.per_page == 20 %}selected{% endif %}>20</option>
                                    <option value="50" {% if pagination_data.per_page == 50 %}selected{% endif %}>50</option>
                                    <option value="100" {% if pagination_data.per_page == 100 %}selected{% endif %}>100</option>
                                </select>
                            </div>

                            <!-- Include Deleted -->
                            <div class="filter-group">
                                <label class="checkbox-wrapper">
                                    <input type="checkbox" name="include_deleted" value="true" {% if include_deleted %}checked{% endif %}>
                                    <span class="checkbox-label">Include Deleted Reports</span>
                                </label>
                            </div>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i>
                                Apply Filters
                            </button>
                            <a href="{{ url_for('analysis.list_analyses') }}" class="btn btn-secondary">
                                <i class="fas fa-redo"></i>
                                Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Quick Stats Card -->
            <div class="quick-stats">
                <h3 class="stats-title">
                    <i class="fas fa-chart-pie"></i>
                    Quick Stats
                </h3>
                <div class="stats-grid">
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ pagination_data.total if pagination_data.total else 0 }}</div>
                        <div class="stat-label-compact">Total Reports</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ analyses_list|length }}</div>
                        <div class="stat-label-compact">Showing</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ pagination_data.total_pages if pagination_data.total_pages else 1 }}</div>
                        <div class="stat-label-compact">Pages</div>
                    </div>
                    <div class="stat-item-compact">
                        <div class="stat-value-compact">{{ pagination_data.page if pagination_data.page else 1 }}</div>
                        <div class="stat-label-compact">Current</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT MAIN: Analyses List -->
        <div class="layout-main">
            <!-- Analyses List -->
            <div class="analyses-section">
                <div class="analyses-header">
                    <h2 class="analyses-title">
                        <i class="fas fa-list"></i>
                        Analysis Reports
                    </h2>
                    <span class="analyses-count">
                        {{ pagination_data.total if pagination_data.total else 0 }} report{{ 's' if (pagination_data.total != 1) else '' }}
                    </span>
                </div>
                <div class="analyses-body">
                    {% if analyses_list and analyses_list|length > 0 %}
                        <div class="analyses-grid">
                            {% for analysis in analyses_list %}
                                {% set analysis_id = analysis.id if analysis.id else '' %}
                                {% set period_start = analysis.analysis_period_start if analysis.analysis_period_start else '' %}
                                {% set period_end = analysis.analysis_period_end if analysis.analysis_period_end else '' %}
                                {% set total_crimes = analysis.total_crimes if analysis.total_crimes is defined else 0 %}
                                {% set total_missing = analysis.total_missing_persons if analysis.total_missing_persons is defined else 0 %}
                                {% set summary = analysis.summary if analysis.summary else 'No summary available' %}
                                {% set generated_by = analysis.generated_by if analysis.generated_by else 'Unknown' %}
                                {% set created_at = analysis.created_at if analysis.created_at else '' %}

                                <div class="analysis-card" onclick="window.location.href='{{ url_for('analysis.view_analysis', analysis_id=analysis_id) }}'">
                                    <div class="analysis-card-body">
                                        <div class="analysis-header">
                                            <div class="analysis-info">
                                                <div class="analysis-id">ID: {{ analysis_id[:16] }}...</div>
                                                <div class="analysis-period">
                                                    {{ period_start[:10] if period_start else 'N/A' }} to {{ period_end[:10] if period_end else 'N/A' }}
                                                </div>
                                                <div class="analysis-generated-by">
                                                    <i class="fas fa-user"></i>
                                                    {{ generated_by[:20] }}...
                                                </div>
                                            </div>
                                            <div class="analysis-date">
                                                <div class="analysis-date-label">Created</div>
                                                <div class="analysis-date-value">{{ created_at[:10] if created_at else 'N/A' }}</div>
                                            </div>
                                        </div>

                                        <div class="analysis-stats">
                                            <div class="stat-item">
                                                <div class="stat-value">{{ total_crimes }}</div>
                                                <div class="stat-label">Crimes</div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-value">{{ total_missing }}</div>
                                                <div class="stat-label">Missing</div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-value">-</div>
                                                <div class="stat-label">Hotspots</div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-value">-</div>
                                                <div class="stat-label">Alerts</div>
                                            </div>
                                        </div>

                                        <div class="analysis-summary">
                                            <div class="summary-text">{{ summary }}</div>
                                        </div>

                                        <div class="analysis-actions">
                                            <a href="{{ url_for('analysis.view_analysis', analysis_id=analysis_id) }}"
                                               class="action-btn action-btn-primary"
                                               onclick="event.stopPropagation()">
                                                <i class="fas fa-eye"></i>
                                                View
                                            </a>
                                            {% if current_user and current_user.role == 'admin' %}
                                            <button type="button"
                                                    class="action-btn action-btn-danger"
                                                    onclick="event.stopPropagation(); deleteAnalysis('{{ analysis_id }}')">
                                                <i class="fas fa-trash-alt"></i>
                                                Delete
                                            </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-chart-bar"></i>
                            <h3>No Analysis Reports Found</h3>
                            <p>{% if current_generated_by or current_start_date or current_end_date %}
                                No reports match your current filters. Try adjusting your filters or clearing them.
                            {% else %}
                                You haven't generated any analysis reports yet.<br>Start by creating your first crime analysis report.
                            {% endif %}</p>
                            <a href="{{ url_for('analysis.preview_analysis') }}" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Create New Analysis
                            </a>
                        </div>
                    {% endif %}
                </div>

                <!-- Pagination -->
                {% if pagination_data.total_pages and pagination_data.total_pages > 1 %}
                <div class="pagination-section">
                    <div class="pagination">
                        <!-- Previous Button -->
                        <a href="?page={{ pagination_data.page - 1 }}&per_page={{ pagination_data.per_page }}&generated_by={{ current_generated_by }}&start_date={{ current_start_date }}&end_date={{ current_end_date }}&include_deleted={{ include_deleted }}"
                           class="page-link {{ 'disabled' if pagination_data.page <= 1 else '' }}">
                            <i class="fas fa-chevron-left"></i>
                            Prev
                        </a>

                        <!-- Page Info -->
                        <span class="page-info">
                            Page {{ pagination_data.page }} of {{ pagination_data.total_pages }}
                        </span>

                        <!-- Page Numbers (show 5 pages max) -->
                        {% set start_page = [1, pagination_data.page - 2]|max %}
                        {% set end_page = [pagination_data.total_pages, pagination_data.page + 2]|min %}

                        {% for page_num in range(start_page, end_page + 1) %}
                            <a href="?page={{ page_num }}&per_page={{ pagination_data.per_page }}&generated_by={{ current_generated_by }}&start_date={{ current_start_date }}&end_date={{ current_end_date }}&include_deleted={{ include_deleted }}"
                               class="page-link {{ 'active' if page_num == pagination_data.page else '' }}">
                                {{ page_num }}
                            </a>
                        {% endfor %}

                        <!-- Next Button -->
                        <a href="?page={{ pagination_data.page + 1 }}&per_page={{ pagination_data.per_page }}&generated_by={{ current_generated_by }}&start_date={{ current_start_date }}&end_date={{ current_end_date }}&include_deleted={{ include_deleted }}"
                           class="page-link {{ 'disabled' if pagination_data.page >= pagination_data.total_pages else '' }}">
                            Next
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
// Delete analysis
async function deleteAnalysis(analysisId) {
    if (!confirm('Are you sure you want to delete this analysis report? This action cannot be undone and will delete all associated hotspots, trends, recommendations, and alerts.')) {
        return;
    }

    try {
        const response = await fetch(`/analysis/${analysisId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            const errorMessage = data.message ||
                               (data.error && data.error.details && data.error.details[0]) ||
                               'Failed to delete analysis';
            throw new Error(errorMessage);
        }

        // Success
        if (window.toast) {
            window.toast.success('Success', data.message || 'Analysis deleted successfully');
        } else {
            alert('Success: Analysis deleted successfully');
        }

        // Reload page after short delay
        setTimeout(() => {
            window.location.reload();
        }, 1000);

    } catch (error) {
        console.error('Delete error:', error);

        if (window.toast) {
            window.toast.error('Error', error.message || 'Failed to delete analysis');
        } else {
            alert('Error: ' + (error.message || 'Failed to delete analysis'));
        }
    }
}

// Animate cards on page load
document.addEventListener('DOMContentLoaded', function() {
    const analysisCards = document.querySelectorAll('.analysis-card');

    analysisCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';

        setTimeout(() => {
            card.style.transition = 'all 0.4s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, 50 * index);
    });

    // Auto-submit filters on change (optional)
    const autoSubmit = false; // Set to true to enable auto-submit

    if (autoSubmit) {
        const filterInputs = document.querySelectorAll('.filter-control');
        filterInputs.forEach(input => {
            input.addEventListener('change', function() {
                this.closest('form').submit();
            });
        });

        const checkbox = document.querySelector('input[name="include_deleted"]');
        if (checkbox) {
            checkbox.addEventListener('change', function() {
                this.closest('form').submit();
            });
        }
    }
});

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    // N key for new analysis
    if (e.key === 'n' || e.key === 'N') {
        if (!e.target.matches('input, textarea, select')) {
            window.location.href = '{{ url_for("analysis.preview_analysis") }}';
        }
    }

    // ESC to clear filters
    if (e.key === 'Escape') {
        window.location.href = '{{ url_for("analysis.list_analyses") }}';
    }
});

// Calculate and update quick stats
function updateQuickStats() {
    const totalCrimes = Array.from(document.querySelectorAll('.stat-value')).reduce((sum, el, index) => {
        return index % 4 === 0 ? sum + (parseInt(el.textContent) || 0) : sum;
    }, 0);

    const totalMissing = Array.from(document.querySelectorAll('.stat-value')).reduce((sum, el, index) => {
        return index % 4 === 1 ? sum + (parseInt(el.textContent) || 0) : sum;
    }, 0);

    console.log('Quick Stats:', {
        totalReports: {{ analyses_list|length }},
        totalCrimes: totalCrimes,
        totalMissing: totalMissing
    });
}

document.addEventListener('DOMContentLoaded', updateQuickStats);
</script>

<!-- Scroll to Top Button -->
<button id="scrollToTop" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" style="
    display: none;
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 48px;
    height: 48px;
    background: var(--primary-gold);
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 20px;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    transition: var(--transition);
    align-items: center;
    justify-content: center;
">
    <i class="fas fa-arrow-up"></i>
</button>

<script>
// Show/hide scroll to top button
window.addEventListener('scroll', function() {
    const scrollBtn = document.getElementById('scrollToTop');
    if (scrollBtn) {
        if (window.pageYOffset > 300) {
            scrollBtn.style.display = 'flex';
        } else {
            scrollBtn.style.display = 'none';
        }
    }
});

// Enhance scroll to top button
const scrollBtn = document.getElementById('scrollToTop');
if (scrollBtn) {
    scrollBtn.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-4px) scale(1.05)';
    });

    scrollBtn.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
    });
}
</script>
{% endblock %}