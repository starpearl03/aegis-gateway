{% extends 'base.jinja2' %}

{% set analyses_list = analyses if analyses else [] %}
{% set pagination_data = pagination if pagination else {} %}
{% set filters_data = filters if filters else {} %}
{% set current_generated_by = filters_data.generated_by if filters_data.generated_by else '' %}
{% set current_start_date = filters_data.start_date if filters_data.start_date else '' %}
{% set current_end_date = filters_data.end_date if filters_data.end_date else '' %}
{% set include_deleted = filters_data.include_deleted if filters_data.include_deleted else false %}

{% block title %}Analysis Reports | Sentinel{% endblock %}

{% block extra_css %}
<style>
/* ===========================
   PAGE LAYOUT
   =========================== */
.page-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* ===========================
   BREADCRUMB
   =========================== */
.page-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-item:hover {
    color: var(--primary-gold);
}

.breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
}

.breadcrumb-separator {
    color: var(--text-muted);
    font-size: 12px;
}

/* ===========================
   PAGE HEADER
   =========================== */
.page-header {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
    pointer-events: none;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: relative;
    z-index: 1;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

.header-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(184, 134, 11, 0.15));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--border-gold);
}

.header-icon i {
    font-size: 28px;
    color: var(--primary-gold);
}

.header-text h1 {
    font-size: 26px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px 0;
    letter-spacing: -0.5px;
}

.header-text p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
}

.header-actions {
    display: flex;
    gap: 12px;
}

/* ===========================
   FILTERS SECTION
   =========================== */
.filters-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.filters-header {
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}

.filters-title i {
    color: var(--primary-gold);
    font-size: 18px;
}

.clear-filters-btn {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 6px;
}

.clear-filters-btn:hover {
    color: var(--primary-gold);
}

.filters-body {
    padding: 24px;
}

.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-control {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: #ffffff;
    transition: var(--transition-fast);
    font-family: inherit;
}

.filter-control:focus {
    outline: none;
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

.filter-control option {
    background: var(--bg-tertiary);
    color: #ffffff;
}

.checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition);
}

.checkbox-wrapper:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
}

.checkbox-wrapper input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.checkbox-label {
    font-size: 14px;
    color: var(--text-primary);
    cursor: pointer;
}

.filter-actions {
    display: flex;
    gap: 12px;
}

/* ===========================
   ANALYSES LIST
   =========================== */
.analyses-section {
    background: transparent;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.analyses-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.analyses-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}

.analyses-title i {
    color: var(--primary-gold);
    font-size: 20px;
}

.analyses-count {
    font-size: 13px;
    color: var(--text-muted);
    padding: 6px 12px;
    background: rgba(10, 14, 39, 0.4);
    border-radius: var(--radius-md);
}

.analyses-body {
    padding: 24px;
}

.analyses-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
}

/* ===========================
   ANALYSIS CARD
   =========================== */
.analysis-card {
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    cursor: pointer;
}

.analysis-card:hover {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.analysis-card-body {
    padding: 20px 24px;
}

.analysis-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 16px;
}

.analysis-info {
    flex: 1;
    min-width: 0;
}

.analysis-id {
    font-size: 11px;
    color: var(--text-muted);
    font-family: monospace;
    margin-bottom: 6px;
}

.analysis-period {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
}

.analysis-generated-by {
    font-size: 12px;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 4px;
}

.analysis-generated-by i {
    color: var(--primary-gold);
    font-size: 11px;
}

.analysis-date {
    text-align: right;
}

.analysis-date-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    margin-bottom: 4px;
}

.analysis-date-value {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
}

.analysis-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
}

.stat-item {
    padding: 12px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: center;
}

.stat-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-gold);
    margin-bottom: 4px;
    line-height: 1;
}

.stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

.analysis-summary {
    padding: 12px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin-bottom: 16px;
}

.summary-text {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.analysis-actions {
    display: flex;
    gap: 10px;
}

.action-btn {
    padding: 10px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.action-btn i {
    font-size: 14px;
}

.action-btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
}

.action-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold-subtle);
    color: white;
}

.action-btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.action-btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

.action-btn-danger {
    background: var(--error-bg);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.action-btn-danger:hover {
    background: var(--error);
    color: white;
    border-color: var(--error);
}

/* ===========================
   EMPTY STATE
   =========================== */
.empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--text-muted);
}

.empty-state i {
    font-size: 72px;
    margin-bottom: 24px;
    opacity: 0.5;
    color: var(--primary-gold);
}

.empty-state h3 {
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 12px;
    font-weight: 600;
}

.empty-state p {
    font-size: 15px;
    margin-bottom: 28px;
    line-height: 1.6;
}

/* ===========================
   PAGINATION
   =========================== */
.pagination-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
    gap: 16px;
}

.pagination {
    display: flex;
    gap: 8px;
    align-items: center;
}

.page-link {
    padding: 10px 16px;
    background: rgba(10, 14, 39, 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 6px;
}

.page-link:hover:not(.disabled):not(.active) {
    background: rgba(10, 14, 39, 0.6);
    border-color: var(--primary-gold);
    color: var(--primary-gold);
}

.page-link.active {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    border-color: var(--primary-gold);
    color: white;
}

.page-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.page-info {
    font-size: 13px;
    color: var(--text-muted);
    padding: 0 12px;
}

/* ===========================
   BUTTONS
   =========================== */
.btn {
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.btn i {
    font-size: 16px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-gold-dark));
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold-subtle);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: rgba(10, 14, 39, 0.4);
    border-color: var(--primary-gold);
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 968px) {
    .header-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .header-actions {
        width: 100%;
    }

    .filters-grid {
        grid-template-columns: 1fr;
    }

    .analysis-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .analysis-actions {
        flex-direction: column;
    }

    .action-btn {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 768px) {
    .page-header {
        padding: 20px;
    }

    .header-left {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-text h1 {
        font-size: 22px;
    }

    .filter-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .pagination {
        flex-wrap: wrap;
        justify-content: center;
    }

    .analysis-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .analysis-date {
        text-align: left;
    }

    .analysis-stats {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Breadcrumb -->
    <div class="page-breadcrumb">
        <a href="{{ url_for('dashboard.dashboard_home') }}" class="breadcrumb-item">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-item active">
            <span>Analysis Reports</span>
        </span>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <div class="header-text">
                    <h1>Crime Analysis Reports</h1>
                    <p>View and manage AI-powered crime analysis reports with hotspots, trends, and recommendations</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="{{ url_for('analysis.preview_analysis') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    New Analysis
                </a>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <div class="filters-header">
            <h2 class="filters-title">
                <i class="fas fa-filter"></i>
                Filters
            </h2>
            <a href="{{ url_for('analysis.list_analyses') }}" class="clear-filters-btn">
                <i class="fas fa-times-circle"></i>
                Clear Filters
            </a>
        </div>
        <div class="filters-body">
            <form method="GET" action="{{ url_for('analysis.list_analyses') }}">
                <div class="filters-grid">
                    <!-- Generated By Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-user"></i>
                            Generated By
                        </label>
                        <input type="text"
                               name="generated_by"
                               class="filter-control"
                               placeholder="User ID"
                               value="{{ current_generated_by }}">
                    </div>

                    <!-- Start Date Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-calendar-alt"></i>
                            Period Start Date
                        </label>
                        <input type="date"
                               name="start_date"
                               class="filter-control"
                               value="{{ current_start_date }}">
                    </div>

                    <!-- End Date Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-calendar-check"></i>
                            Period End Date
                        </label>
                        <input type="date"
                               name="end_date"
                               class="filter-control"
                               value="{{ current_end_date }}">
                    </div>

                    <!-- Per Page Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-list"></i>
                            Per Page
                        </label>
                        <select name="per_page" class="filter-control">
                            <option value="10" {% if pagination_data.per_page == 10 %}selected{% endif %}>10</option>
                            <option value="20" {% if pagination_data.per_page == 20 %}selected{% endif %}>20</option>
                            <option value="50" {% if pagination_data.per_page == 50 %}selected{% endif %}>50</option>
                            <option value="100" {% if pagination_data.per_page == 100 %}selected{% endif %}>100</option>
                        </select>
                    </div>

                    <!-- Include Deleted -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-trash-restore"></i>
                            Include Deleted
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="include_deleted" value="true" {% if include_deleted %}checked{% endif %}>
                            <span class="checkbox-label">Show deleted reports</span>
                        </label>
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                        Apply Filters
                    </button>
                    <a href="{{ url_for('analysis.list_analyses') }}" class="btn btn-secondary">
                        <i class="fas fa-redo"></i>
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Analyses List -->
    <div class="analyses-section">
        <div class="analyses-header">
            <h2 class="analyses-title">
                <i class="fas fa-list"></i>
                Analysis Reports
            </h2>
            <span class="analyses-count">
                {{ pagination_data.total if pagination_data.total else 0 }} total report{{ 's' if (pagination_data.total != 1) else '' }}
            </span>
        </div>
        <div class="analyses-body">
            {% if analyses_list and analyses_list|length > 0 %}
                <div class="analyses-grid">
                    {% for analysis in analyses_list %}
                        {% set analysis_id = analysis.id if analysis.id else '' %}
                        {% set period_start = analysis.analysis_period_start if analysis.analysis_period_start else '' %}
                        {% set period_end = analysis.analysis_period_end if analysis.analysis_period_end else '' %}
                        {% set total_crimes = analysis.total_crimes if analysis.total_crimes is defined else 0 %}
                        {% set total_missing = analysis.total_missing_persons if analysis.total_missing_persons is defined else 0 %}
                        {% set summary = analysis.summary if analysis.summary else 'No summary available' %}
                        {% set generated_by = analysis.generated_by if analysis.generated_by else 'Unknown' %}
                        {% set created_at = analysis.created_at if analysis.created_at else '' %}

                        <div class="analysis-card" onclick="window.location.href='{{ url_for('analysis.view_analysis', analysis_id=analysis_id) }}'">
                            <div class="analysis-card-body">
                                <div class="analysis-header">
                                    <div class="analysis-info">
                                        <div class="analysis-id">ID: {{ analysis_id[:16] }}...</div>
                                        <div class="analysis-period">
                                            {{ period_start[:10] if period_start else 'N/A' }} to {{ period_end[:10] if period_end else 'N/A' }}
                                        </div>
                                        <div class="analysis-generated-by">
                                            <i class="fas fa-user"></i>
                                            Generated by: {{ generated_by[:20] }}...
                                        </div>
                                    </div>
                                    <div class="analysis-date">
                                        <div class="analysis-date-label">Created</div>
                                        <div class="analysis-date-value">{{ created_at[:10] if created_at else 'N/A' }}</div>
                                    </div>
                                </div>

                                <div class="analysis-stats">
                                    <div class="stat-item">
                                        <div class="stat-value">{{ total_crimes }}</div>
                                        <div class="stat-label">Crimes</div>
                                    </div>
                                    <div class="stat-item">
                                        <div class="stat-value">{{ total_missing }}</div>
                                        <div class="stat-label">Missing</div>
                                    </div>
                                    <div class="stat-item">
                                        <div class="stat-value">-</div>
                                        <div class="stat-label">Hotspots</div>
                                    </div>
                                    <div class="stat-item">
                                        <div class="stat-value">-</div>
                                        <div class="stat-label">Alerts</div>
                                    </div>
                                </div>

                                <div class="analysis-summary">
                                    <div class="summary-text">{{ summary }}</div>
                                </div>

                                <div class="analysis-actions">
                                    <a href="{{ url_for('analysis.view_analysis', analysis_id=analysis_id) }}"
                                       class="action-btn action-btn-primary"
                                       onclick="event.stopPropagation()">
                                        <i class="fas fa-eye"></i>
                                        View Report
                                    </a>
                                    {% if current_user and current_user.role == 'admin' %}
                                    <button type="button"
                                            class="action-btn action-btn-danger"
                                            onclick="event.stopPropagation(); deleteAnalysis('{{ analysis_id }}')">
                                        <i class="fas fa-trash-alt"></i>
                                        Delete
                                    </button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-chart-bar"></i>
                    <h3>No Analysis Reports Found</h3>
                    <p>{% if current_generated_by or current_start_date or current_end_date %}
                        No reports match your current filters. Try adjusting your filters or clearing them.
                    {% else %}
                        You haven't generated any analysis reports yet.<br>Start by creating your first crime analysis report.
                    {% endif %}</p>
                    <a href="{{ url_for('analysis.preview_analysis') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Create New Analysis
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Pagination -->
        {% if pagination_data.total_pages and pagination_data.total_pages > 1 %}
        <div class="pagination-section">
            <div class="pagination">
                <!-- Previous Button -->
                <a href="?page={{ pagination_data.page - 1 }}&per_page={{ pagination_data.per_page }}&generated_by={{ current_generated_by }}&start_date={{ current_start_date }}&end_date={{ current_end_date }}&include_deleted={{ include_deleted }}"
                   class="page-link {{ 'disabled' if pagination_data.page <= 1 else '' }}">
                    <i class="fas fa-chevron-left"></i>
                    Previous
                </a>

                <!-- Page Info -->
                <span class="page-info">
                    Page {{ pagination_data.page }} of {{ pagination_data.total_pages }}
                </span>

                <!-- Page Numbers (show 5 pages max) -->
                {% set start_page = [1, pagination_data.page - 2]|max %}
                {% set end_page = [pagination_data.total_pages, pagination_data.page + 2]|min %}

                {% for page_num in range(start_page, end_page + 1) %}
                    <a href="?page={{ page_num }}&per_page={{ pagination_data.per_page }}&generated_by={{ current_generated_by }}&start_date={{ current_start_date }}&end_date={{ current_end_date }}&include_deleted={{ include_deleted }}"
                       class="page-link {{ 'active' if page_num == pagination_data.page else '' }}">
                        {{ page_num }}
                    </a>
                {% endfor %}

                <!-- Next Button -->
                <a href="?page={{ pagination_data.page + 1 }}&per_page={{ pagination_data.per_page }}&generated_by={{ current_generated_by }}&start_date={{ current_start_date }}&end_date={{ current_end_date }}&include_deleted={{ include_deleted }}"
                   class="page-link {{ 'disabled' if pagination_data.page >= pagination_data.total_pages else '' }}">
                    Next
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<script>
// Delete analysis
async function deleteAnalysis(analysisId) {
    if (!confirm('Are you sure you want to delete this analysis report? This action cannot be undone and will delete all associated hotspots, trends, recommendations, and alerts.')) {
        return;
    }

    try {
        const response = await fetch(`/analysis/${analysisId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || data.error) {
            const errorMessage = data.message ||
                               (data.error && data.error.details && data.error.details[0]) ||
                               'Failed to delete analysis';
            throw new Error(errorMessage);
        }

        // Success
        if (window.toast) {
            window.toast.success('Success', data.message || 'Analysis deleted successfully');
        } else {
            alert('Success: Analysis deleted successfully');
        }

        // Reload page after short delay
        setTimeout(() => {
            window.location.reload();
        }, 1000);

    } catch (error) {
        console.error('Delete error:', error);

        if (window.toast) {
            window.toast.error('Error', error.message || 'Failed to delete analysis');
        } else {
            alert('Error: ' + (error.message || 'Failed to delete analysis'));
        }
    }
}

// Animate cards on page load
document.addEventListener('DOMContentLoaded', function() {
    const analysisCards = document.querySelectorAll('.analysis-card');

    analysisCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';

        setTimeout(() => {
            card.style.transition = 'all 0.4s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, 50 * index);
    });

    // Auto-submit filters on change (optional)
    const autoSubmit = false; // Set to true to enable auto-submit

    if (autoSubmit) {
        const filterInputs = document.querySelectorAll('.filter-control');
        filterInputs.forEach(input => {
            input.addEventListener('change', function() {
                this.closest('form').submit();
            });
        });

        const checkbox = document.querySelector('input[name="include_deleted"]');
        if (checkbox) {
            checkbox.addEventListener('change', function() {
                this.closest('form').submit();
            });
        }
    }
});

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    // N key for new analysis
    if (e.key === 'n' || e.key === 'N') {
        if (!e.target.matches('input, textarea, select')) {
            window.location.href = '{{ url_for("analysis.preview_analysis") }}';
        }
    }

    // ESC to clear filters
    if (e.key === 'Escape') {
        window.location.href = '{{ url_for("analysis.list_analyses") }}';
    }
});

// Export reports as CSV (optional feature)
function exportReports() {
    if (window.toast) {
        window.toast.info('Coming Soon', 'CSV export functionality will be available soon');
    } else {
        alert('CSV export functionality will be available soon');
    }
}

// Print reports
function printReports() {
    window.print();
}

// Add smooth scroll behavior
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    });
});

// Format dates on hover (optional enhancement)
document.querySelectorAll('.analysis-date-value, .analysis-period').forEach(element => {
    const dateText = element.textContent.trim();
    const dateMatch = dateText.match(/\d{4}-\d{2}-\d{2}/);

    if (dateMatch) {
        const date = new Date(dateMatch[0]);
        if (!isNaN(date.getTime())) {
            element.setAttribute('title', date.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            }));
        }
    }
});

// Track page view for analytics (optional)
(function() {
    console.log('Analysis Reports Page View', {
        filters: {
            generated_by: '{{ current_generated_by }}',
            start_date: '{{ current_start_date }}',
            end_date: '{{ current_end_date }}',
            include_deleted: {{ 'true' if include_deleted else 'false' }}
        },
        pagination: {
            page: {{ pagination_data.page if pagination_data.page else 1 }},
            total: {{ pagination_data.total if pagination_data.total else 0 }}
        }
    });
})();

// Bulk selection (for future bulk actions)
let selectedAnalyses = new Set();

function toggleSelection(analysisId) {
    if (selectedAnalyses.has(analysisId)) {
        selectedAnalyses.delete(analysisId);
    } else {
        selectedAnalyses.add(analysisId);
    }
    updateBulkActions();
}

function updateBulkActions() {
    const count = selectedAnalyses.size;
    const bulkActionsBar = document.getElementById('bulkActionsBar');

    if (bulkActionsBar) {
        if (count > 0) {
            bulkActionsBar.style.display = 'flex';
            bulkActionsBar.querySelector('.selected-count').textContent = count;
        } else {
            bulkActionsBar.style.display = 'none';
        }
    }
}

// Quick stats calculation
function calculateStats() {
    const cards = document.querySelectorAll('.analysis-card');
    let totalCrimes = 0;
    let totalMissing = 0;

    cards.forEach(card => {
        const statsItems = card.querySelectorAll('.stat-value');
        if (statsItems.length >= 2) {
            totalCrimes += parseInt(statsItems[0].textContent) || 0;
            totalMissing += parseInt(statsItems[1].textContent) || 0;
        }
    });

    console.log('Quick Stats:', {
        totalReports: cards.length,
        totalCrimes: totalCrimes,
        totalMissing: totalMissing,
        averageCrimes: cards.length > 0 ? (totalCrimes / cards.length).toFixed(1) : 0
    });
}

// Run stats on load
document.addEventListener('DOMContentLoaded', calculateStats);

// Handle mobile responsiveness
function handleResize() {
    const width = window.innerWidth;

    if (width < 768) {
        // Mobile optimizations
        document.querySelectorAll('.stat-value').forEach(el => {
            el.style.fontSize = '18px';
        });
    }
}

window.addEventListener('resize', handleResize);
handleResize();

// Search within page (optional enhancement)
function searchReports(query) {
    const cards = document.querySelectorAll('.analysis-card');
    const lowerQuery = query.toLowerCase();

    cards.forEach(card => {
        const text = card.textContent.toLowerCase();
        if (text.includes(lowerQuery)) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}

// Add live search input (optional)
function addLiveSearch() {
    const searchInput = document.createElement('input');
    searchInput.type = 'text';
    searchInput.placeholder = 'Search reports...';
    searchInput.className = 'filter-control';
    searchInput.style.marginBottom = '16px';

    searchInput.addEventListener('input', function(e) {
        searchReports(e.target.value);
    });

    const analysesBody = document.querySelector('.analyses-body');
    if (analysesBody) {
        analysesBody.insertBefore(searchInput, analysesBody.firstChild);
    }
}

// Uncomment to enable live search
// document.addEventListener('DOMContentLoaded', addLiveSearch);

// Copy analysis ID to clipboard
function copyAnalysisId(analysisId) {
    navigator.clipboard.writeText(analysisId).then(() => {
        if (window.toast) {
            window.toast.success('Copied', 'Analysis ID copied to clipboard');
        } else {
            alert('Analysis ID copied to clipboard');
        }
    }).catch(err => {
        console.error('Failed to copy:', err);
    });
}

// Add hover effects for better UX
document.addEventListener('DOMContentLoaded', function() {
    const cards = document.querySelectorAll('.analysis-card');

    cards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transition = 'all 0.3s ease';
        });
    });
});

// Compare analyses (optional feature)
function compareAnalyses() {
    if (selectedAnalyses.size < 2) {
        if (window.toast) {
            window.toast.warning('Select Reports', 'Please select at least 2 reports to compare');
        }
        return;
    }

    if (window.toast) {
        window.toast.info('Coming Soon', 'Report comparison feature will be available soon');
    }
}

// Download report as PDF (optional)
function downloadReport(analysisId) {
    if (window.toast) {
        window.toast.info('Coming Soon', 'PDF download functionality will be available soon');
    } else {
        alert('PDF download functionality will be available soon');
    }
}

// Share report (optional)
function shareReport(analysisId) {
    const url = window.location.origin + `/analysis/${analysisId}`;

    if (navigator.share) {
        navigator.share({
            title: 'Crime Analysis Report',
            text: 'Check out this crime analysis report',
            url: url
        }).catch(err => console.log('Error sharing:', err));
    } else {
        // Fallback: copy to clipboard
        navigator.clipboard.writeText(url).then(() => {
            if (window.toast) {
                window.toast.success('Link Copied', 'Report link copied to clipboard');
            }
        });
    }
}

// Auto-refresh for real-time updates (optional)
let autoRefresh = false;
let refreshInterval = null;

function toggleAutoRefresh() {
    autoRefresh = !autoRefresh;

    if (autoRefresh) {
        refreshInterval = setInterval(() => {
            window.location.reload();
        }, 60000); // Refresh every 60 seconds

        if (window.toast) {
            window.toast.info('Auto-Refresh', 'Auto-refresh enabled (every 60s)');
        }
    } else {
        if (refreshInterval) {
            clearInterval(refreshInterval);
            refreshInterval = null;
        }

        if (window.toast) {
            window.toast.info('Auto-Refresh', 'Auto-refresh disabled');
        }
    }
}

// Filter by date range shortcut
function setDateRange(range) {
    const endDate = new Date();
    let startDate = new Date();

    switch(range) {
        case 'today':
            startDate = new Date();
            break;
        case 'week':
            startDate.setDate(startDate.getDate() - 7);
            break;
        case 'month':
            startDate.setMonth(startDate.getMonth() - 1);
            break;
        case 'quarter':
            startDate.setMonth(startDate.getMonth() - 3);
            break;
        case 'year':
            startDate.setFullYear(startDate.getFullYear() - 1);
            break;
    }

    document.querySelector('input[name="start_date"]').value = startDate.toISOString().split('T')[0];
    document.querySelector('input[name="end_date"]').value = endDate.toISOString().split('T')[0];

    document.querySelector('form').submit();
}

// Add date range shortcuts (optional)
function addDateRangeShortcuts() {
    const shortcuts = ['Today', 'Week', 'Month', 'Quarter', 'Year'];
    const container = document.createElement('div');
    container.style.cssText = 'display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;';

    shortcuts.forEach(shortcut => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = shortcut;
        btn.className = 'btn btn-secondary';
        btn.style.padding = '8px 16px';
        btn.style.fontSize = '13px';
        btn.onclick = () => setDateRange(shortcut.toLowerCase());
        container.appendChild(btn);
    });

    const filtersBody = document.querySelector('.filters-body form');
    if (filtersBody) {
        filtersBody.insertBefore(container, filtersBody.firstChild);
    }
}

// Uncomment to enable date range shortcuts
// document.addEventListener('DOMContentLoaded', addDateRangeShortcuts);
</script>

<!-- Optional: Scroll to Top Button -->
<button id="scrollToTop" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" style="
    display: none;
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 48px;
    height: 48px;
    background: var(--primary-gold);
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 20px;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    transition: var(--transition);
    align-items: center;
    justify-content: center;
">
    <i class="fas fa-arrow-up"></i>
</button>

<script>
// Show/hide scroll to top button
window.addEventListener('scroll', function() {
    const scrollBtn = document.getElementById('scrollToTop');
    if (scrollBtn) {
        if (window.pageYOffset > 300) {
            scrollBtn.style.display = 'flex';
        } else {
            scrollBtn.style.display = 'none';
        }
    }
});

// Enhance scroll to top button
const scrollBtn = document.getElementById('scrollToTop');
if (scrollBtn) {
    scrollBtn.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-4px) scale(1.05)';
    });

    scrollBtn.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
    });
}
</script>

<style>
/* Print styles */
@media print {
    .page-breadcrumb,
    .header-actions,
    .filters-section,
    .pagination-section,
    .action-btn,
    #scrollToTop {
        display: none !important;
    }

    .analysis-card {
        page-break-inside: avoid;
        border: 1px solid #ccc !important;
        background: white !important;
    }

    .page-header,
    .analyses-section {
        border: 1px solid #ccc !important;
        background: white !important;
    }

    .analysis-card-body {
        padding: 16px !important;
    }
}

/* Loading animation for delete */
@keyframes deleteAnimation {
    0% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.8); }
}

.analysis-card.deleting {
    animation: deleteAnimation 0.3s ease forwards;
    pointer-events: none;
}
</style>
{% endblock %}