<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sentinel | Zimbabwe Police Department{% endblock %}</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    {% block extra_css %}{% endblock %}

<style>
/* ===========================
   ROOT VARIABLES - DARK LUXURY THEME
   =========================== */
:root {
    /* Gold Accents - Used sparingly */
    --primary-gold: #d4af37;
    --primary-gold-light: #f4d03f;
    --primary-gold-dark: #b8860b;

    /* Dark Backgrounds - Primary theme colors */
    --bg-primary: #0a0e27;
    --bg-secondary: #0f172a;
    --bg-tertiary: #1e293b;
    --bg-hover: #1a2235;

    /* Surface Colors */
    --surface: #141b2d;
    --surface-elevated: #1a1f35;
    --card-bg: rgba(26, 31, 53, 0.8);

    /* Text Colors */
    --text-primary: #e8edf2;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;

    /* Border Colors - Subtle */
    --border: rgba(148, 163, 184, 0.1);
    --border-light: rgba(148, 163, 184, 0.06);
    --border-gold: rgba(212, 175, 55, 0.2);

    /* Status Colors */
    --success: #10b981;
    --success-bg: rgba(16, 185, 129, 0.1);
    --error: #ef4444;
    --error-bg: rgba(239, 68, 68, 0.1);
    --warning: #f59e0b;
    --warning-bg: rgba(245, 158, 11, 0.1);
    --info: #3b82f6;
    --info-bg: rgba(59, 130, 246, 0.1);

    /* Sidebar */
    --sidebar-width: 280px;
    --sidebar-collapsed-width: 80px;

    /* Shadows */
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.5);
    --shadow-gold-subtle: 0 2px 10px rgba(212, 175, 55, 0.15);

    /* Transitions */
    --transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);

    /* Border Radius */
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
}

/* ===========================
   BASE STYLES
   =========================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    height: 100%;
    overflow: hidden;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ===========================
   ANIMATED BACKGROUND - Matching styles.scss
   =========================== */
body {
    background: linear-gradient(135deg,
        #0a0f1e 0%,
        #0f172a 25%,
        #1e293b 50%,
        #0f172a 75%,
        #0a0f1e 100%
    );
    position: relative;
}

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
        radial-gradient(circle at 20% 30%, rgba(99, 102, 241, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(59, 130, 246, 0.02) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

body::after {
    content: '';
    position: fixed;
    width: min(800px, 50vw);
    height: min(800px, 50vw);
    top: -200px;
    right: -200px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(60px);
    animation: float 20s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
}

@keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-100px, -100px); }
}

/* ===========================
   TOAST NOTIFICATIONS - COMPACT
   =========================== */
#toastContainer {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 1055;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.toast {
    background: var(--surface-elevated);
    backdrop-filter: blur(20px);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    cursor: pointer;
    position: relative;
    min-width: 320px;
    max-width: 360px;
    transition: var(--transition);
}

.toast:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg), var(--shadow-gold-subtle);
    border-color: var(--border-gold);
}

.toast-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 100%;
    transform-origin: left;
    transition: transform linear;
}

.toast-progress.success { background: linear-gradient(90deg, var(--success), #34d399); }
.toast-progress.error { background: linear-gradient(90deg, var(--error), #f87171); }
.toast-progress.warning { background: linear-gradient(90deg, var(--warning), #fbbf24); }
.toast-progress.info { background: linear-gradient(90deg, var(--primary-gold), var(--primary-gold-light)); }

.toast-header {
    background: transparent;
    border-bottom: 1px solid var(--border);
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.toast-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
}

.toast-icon.success { background: var(--success-bg); color: var(--success); }
.toast-icon.error { background: var(--error-bg); color: var(--error); }
.toast-icon.warning { background: var(--warning-bg); color: var(--warning); }
.toast-icon.info {
    background: rgba(212, 175, 55, 0.1);
    color: var(--primary-gold);
    border: 1px solid var(--border-gold);
}

.toast-header strong {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 12px;
    flex: 1;
}

.toast-header .btn-close {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 2px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: var(--transition-fast);
    opacity: 1;
}

.toast-header .btn-close i {
    font-size: 11px;
}

.toast-header .btn-close:hover {
    background: var(--bg-hover);
    color: var(--primary-gold);
}

.toast-body {
    background: transparent;
    color: var(--text-secondary);
    padding: 12px 12px 14px;
    font-size: 14px;
    line-height: 1.5;
}

.toast.show { animation: toastSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
.toast.hide { animation: toastSlideOut 0.3s cubic-bezier(0.4, 0, 1, 1); }

@keyframes toastSlideIn {
    from { opacity: 0; transform: translateX(100%) scale(0.9); }
    to { opacity: 1; transform: translateX(0) scale(1); }
}

@keyframes toastSlideOut {
    to { opacity: 0; transform: translateX(100%) scale(0.9); }
}

/* ===========================
   SIDEBAR
   =========================== */
.sidebar {
    width: var(--sidebar-width);
    background: transparent;
    backdrop-filter: blur(10px);
    border-right: 1px solid var(--border);
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
}

/* Logo Section */
.logo-section {
    display: flex;
    align-items: center;
    padding: 24px 20px;
    border-bottom: 1px solid var(--border);
    background: transparent;
    flex-shrink: 0;
    transition: var(--transition);
}

.logo-grid {
    margin-right: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-elevated);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    flex-shrink: 0;
    border: 1px solid var(--border-gold);
}

.logo-grid i {
    font-size: 22px;
    color: var(--primary-gold);
}

.logo-section h1 {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.5px;
    color: var(--text-primary);
}

.logo-version {
    font-size: 10px;
    color: var(--primary-gold);
    margin-left: 8px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--border-gold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Navigation Scroll Area */
.nav-scroll-area {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

.nav-scroll-area::-webkit-scrollbar { width: 6px; }
.nav-scroll-area::-webkit-scrollbar-track { background: transparent; }
.nav-scroll-area::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
}

/* Navigation Menu */
.nav-menu {
    list-style: none;
    padding: 16px 16px 24px;
    margin: 0;
}

.nav-section {
    margin-top: 24px;
    margin-bottom: 8px;
}

.nav-section:first-child {
    margin-top: 0;
}

.nav-section-title {
    padding: 0 12px 8px;
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
}

.nav-item {
    margin-bottom: 4px;
    list-style: none;
}

.nav-link {
    display: flex;
    align-items: center;
    padding: 12px 12px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
    font-size: 14px;
    font-weight: 500;
    border-radius: var(--radius-md);
    position: relative;
    gap: 12px;
}

.nav-link:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    transform: translateX(4px);
}

.icon-container {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: var(--transition);
    background: transparent;
    flex-shrink: 0;
}

.icon-container i {
    font-size: 18px;
    color: var(--text-secondary);
    transition: var(--transition);
}

/* Active State - Darker background with white border */
.nav-link.active {
    background: rgba(10, 14, 39, 0.6);
    color: var(--text-primary);
    font-weight: 600;
    border: 1px solid var(--border);
}

.nav-link.active .icon-container {
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--border-gold);
}

.nav-link.active .icon-container i {
    color: var(--primary-gold);
}

.nav-link:hover:not(.active) .icon-container {
    background: var(--surface-elevated);
}

.nav-link:hover:not(.active) .icon-container i {
    color: var(--text-primary);
}

/* Badge - Small gold accent */
.notification-badge {
    background: rgba(212, 175, 55, 0.15);
    color: var(--primary-gold);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 12px;
    margin-left: auto;
    min-width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-gold);
}

/* User Profile Footer */
.user-profile {
    display: flex;
    align-items: center;
    padding: 20px 16px;
    border-top: 1px solid var(--border);
    background: transparent;
    transition: var(--transition);
    flex-shrink: 0;
    gap: 14px;
}

.profile-avatar {
    position: relative;
    flex-shrink: 0;
}

.profile-avatar img,
.profile-avatar > div {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    object-fit: cover;
    transition: var(--transition);
    border: 2px solid var(--border);
    box-shadow: var(--shadow-sm);
}

.status-indicator {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--success);
    border: 3px solid rgba(10, 14, 39, 0.8);
    box-shadow: 0 0 0 1px var(--success);
}

.user-info {
    flex: 1;
    min-width: 0;
}

.user-name {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0 0 2px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

.user-status {
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.logout-btn {
    color: var(--text-secondary);
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    text-decoration: none;
    flex-shrink: 0;
    border: 1px solid var(--border);
}

.logout-btn i {
    font-size: 18px;
}

.logout-btn:hover {
    background: rgba(212, 175, 55, 0.1);
    color: var(--primary-gold);
    border-color: var(--border-gold);
    transform: translateY(-2px);
}

.user-profile:hover .profile-avatar img,
.user-profile:hover .profile-avatar > div {
    transform: scale(1.05);
    border-color: var(--border-gold);
}

/* Mobile Toggle - Gold accent */
.sidebar-toggle {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 99;
    background: var(--surface-elevated);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transform: scale(0);
    opacity: 0;
    transition: var(--transition);
    border: 2px solid var(--border-gold);
}

.sidebar-toggle i {
    color: var(--primary-gold);
    font-size: 22px;
}

.sidebar-toggle:hover {
    transform: scale(1.1);
    background: rgba(212, 175, 55, 0.1);
    box-shadow: var(--shadow-lg), var(--shadow-gold-subtle);
}

.sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 90;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition);
    backdrop-filter: blur(4px);
}

.sidebar-overlay.visible {
    opacity: 1;
    visibility: visible;
}

/* ===========================
   MAIN CONTENT AREA - FIXED SCROLLING
   =========================== */
.main-container {
    display: flex;
    min-height: 100vh;
    position: relative;
}

.content-area {
    flex: 1;
    margin-left: var(--sidebar-width);
    width: calc(100vw - var(--sidebar-width));
    transition: var(--transition);
    height: 100vh;
    padding: 32px;
    position: relative;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 1;
}

.content-wrapper {
    width: 100%;
    max-width: 100%;
    min-height: 100%;
}

/* Custom Scrollbar for Content Area */
.content-area::-webkit-scrollbar {
    width: 8px;
}

.content-area::-webkit-scrollbar-track {
    background: transparent;
}

.content-area::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
}

.content-area::-webkit-scrollbar-thumb:hover {
    background: var(--primary-gold);
}

/* COLLAPSED SIDEBAR ADJUSTMENT - FIXED */
.sidebar.collapsed ~ .content-area {
    margin-left: var(--sidebar-collapsed-width) !important;
    width: calc(100vw - var(--sidebar-collapsed-width)) !important;
}

/* Notification Bell - Small gold accent */
.notification-bell {
    position: fixed;
    top: 32px;
    right: 32px;
    z-index: 95;
    width: 44px;
    height: 44px;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--shadow-md);
}

.notification-bell:hover {
    background: rgba(212, 175, 55, 0.1);
    transform: translateY(-2px);
    border-color: var(--border-gold);
    box-shadow: var(--shadow-md), var(--shadow-gold-subtle);
}

.notification-bell i {
    font-size: 18px;
    color: var(--text-secondary);
    transition: var(--transition);
}

.notification-bell:hover i {
    color: var(--primary-gold);
}

.notification-dot {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 8px;
    height: 8px;
    background: var(--primary-gold);
    border-radius: 50%;
    border: 2px solid rgba(26, 31, 53, 0.8);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.8; }
}

/* ===========================
   RESPONSIVE - TABLET
   =========================== */
@media (max-width: 1024px) {
    .sidebar {
        width: var(--sidebar-collapsed-width);
    }

    .content-area {
        margin-left: var(--sidebar-collapsed-width);
        width: calc(100vw - var(--sidebar-collapsed-width));
    }

    .logo-section {
        justify-content: center;
        padding: 24px 0;
    }

    .logo-grid {
        margin-right: 0;
    }

    .logo-section h1,
    .logo-version {
        display: none;
    }

    .nav-link {
        justify-content: center;
        padding: 12px 0;
    }

    .nav-link.active {
        padding: 12px 0;
    }

    .nav-text,
    .nav-section-title,
    .notification-badge {
        display: none;
    }

    .user-profile {
        justify-content: center;
        padding: 20px 0;
        gap: 0;
    }

    .user-info,
    .logout-btn {
        display: none;
    }

    /* Hover expand on tablet */
    .sidebar:hover {
        width: var(--sidebar-width);
    }

    .sidebar:hover .logo-section {
        justify-content: flex-start;
        padding: 24px 20px;
    }

    .sidebar:hover .logo-grid {
        margin-right: 14px;
    }

    .sidebar:hover .logo-section h1,
    .sidebar:hover .logo-version {
        display: block;
    }

    .sidebar:hover .nav-link {
        justify-content: flex-start;
        padding: 12px 12px;
    }

    .sidebar:hover .nav-link.active {
        padding: 12px 12px;
    }

    .sidebar:hover .nav-text,
    .sidebar:hover .nav-section-title,
    .sidebar:hover .notification-badge {
        display: block;
    }

    .sidebar:hover .user-profile {
        justify-content: flex-start;
        padding: 20px 16px;
        gap: 14px;
    }

    .sidebar:hover .user-info,
    .sidebar:hover .logout-btn {
        display: flex;
    }

    /* Fix for collapsed state on tablet */
    .sidebar.collapsed ~ .content-area {
        margin-left: var(--sidebar-collapsed-width) !important;
        width: calc(100vw - var(--sidebar-collapsed-width)) !important;
    }
}

/* ===========================
   RESPONSIVE - MOBILE
   =========================== */
@media (max-width: 768px) {
    .sidebar {
        transform: translateX(-100%);
        width: var(--sidebar-width);
    }

    .content-area {
        margin-left: 0;
        width: 100vw;
        padding: 20px;
    }

    .sidebar.show {
        transform: translateX(0);
    }

    .logo-section {
        justify-content: flex-start;
        padding: 24px 20px;
    }

    .logo-grid {
        margin-right: 14px;
    }

    .logo-section h1,
    .logo-version {
        display: block;
    }

    .nav-link {
        justify-content: flex-start;
        padding: 12px 12px;
    }

    .nav-link.active {
        padding: 12px 12px;
    }

    .nav-text,
    .nav-section-title,
    .notification-badge {
        display: block;
    }

    .user-profile {
        justify-content: flex-start;
        padding: 20px 16px;
        gap: 14px;
    }

    .user-info,
    .logout-btn {
        display: flex;
    }

    .sidebar-toggle {
        transform: scale(1);
        opacity: 1;
    }

    #toastContainer {
        top: 20px;
        right: 20px;
        left: 20px;
    }

    .toast {
        min-width: 100%;
    }

    .notification-bell {
        top: 24px;
        right: 24px;
    }

    /* Reset collapsed state for mobile */
    .sidebar.collapsed ~ .content-area {
        margin-left: 0 !important;
        width: 100vw !important;
    }
}
</style>
</head>
<body>
    <div class="main-container">
        {% include 'macros/sidebar.jinja2' %}

        <div class="content-area">
            <div class="notification-bell">
                <i class="fas fa-bell"></i>
                <span class="notification-dot"></span>
            </div>

            <div class="content-wrapper">
                {% block content %}{% endblock %}
            </div>
        </div>
    </div>

    <div id="toastContainer"></div>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>

    <script>
        class ToastManager {
            constructor() {
                this.container = this.createContainer();
                this.toasts = new Map();
                this.counter = 0;
            }

            createContainer() {
                let container = document.getElementById('toastContainer');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'toastContainer';
                    document.body.appendChild(container);
                }
                return container;
            }

            show(type, title, message, duration = 5000) {
                const toastId = `toast_${++this.counter}`;
                const toast = document.createElement('div');
                toast.className = 'toast show';
                toast.setAttribute('role', 'alert');
                toast.id = toastId;

                const iconMap = {
                    success: 'fas fa-check-circle',
                    error: 'fas fa-times-circle',
                    danger: 'fas fa-times-circle',
                    warning: 'fas fa-exclamation-triangle',
                    info: 'fas fa-info-circle'
                };

                const normalizedType = type === 'danger' ? 'error' : type;

                toast.innerHTML = `
                    <div class="toast-header">
                        <div class="toast-icon ${normalizedType}">
                            <i class="${iconMap[type] || iconMap.info}"></i>
                        </div>
                        <strong>${this.escapeHtml(title)}</strong>
                        <button type="button" class="btn-close" data-toast-id="${toastId}">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="toast-body">${this.escapeHtml(message)}</div>
                    ${duration > 0 ? `<div class="toast-progress ${normalizedType}"></div>` : ''}
                `;

                this.container.appendChild(toast);

                const closeBtn = toast.querySelector('.btn-close');
                closeBtn.addEventListener('click', () => this.hide(toastId));

                const state = {
                    duration: duration,
                    remaining: duration,
                    startTime: null,
                    timeoutId: null,
                    isHovered: false,
                    progressBar: toast.querySelector('.toast-progress')
                };

                this.startTimer(toastId, state);

                toast.addEventListener('mouseenter', () => {
                    state.isHovered = true;
                    this.pauseTimer(state);
                });

                toast.addEventListener('mouseleave', () => {
                    state.isHovered = false;
                    this.resumeTimer(toastId, state);
                });

                this.toasts.set(toastId, { element: toast, state: state });
                return toastId;
            }

            startTimer(toastId, state) {
                state.startTime = performance.now();

                if (state.progressBar) {
                    state.progressBar.style.transition = 'none';
                    state.progressBar.style.transform = 'scaleX(1)';
                    state.progressBar.offsetHeight;

                    requestAnimationFrame(() => {
                        state.progressBar.style.transition = `transform ${state.remaining}ms linear`;
                        state.progressBar.style.transform = 'scaleX(0)';
                    });
                }

                state.timeoutId = setTimeout(() => {
                    if (!state.isHovered) {
                        this.hide(toastId);
                    }
                }, state.remaining);
            }

            pauseTimer(state) {
                if (state.timeoutId) {
                    clearTimeout(state.timeoutId);
                    state.timeoutId = null;
                }

                const elapsed = performance.now() - state.startTime;
                state.remaining = Math.max(0, state.remaining - elapsed);

                if (state.progressBar) {
                    const currentScale = 1 - (elapsed / state.duration);
                    state.progressBar.style.transition = 'none';
                    state.progressBar.style.transform = `scaleX(${Math.max(0, currentScale)})`;
                }
            }

            resumeTimer(toastId, state) {
                if (state.remaining > 0) {
                    this.startTimer(toastId, state);
                }
            }

            hide(toastId) {
                const data = this.toasts.get(toastId);
                if (!data) return;

                const { element, state } = data;

                if (state.timeoutId) {
                    clearTimeout(state.timeoutId);
                }

                element.classList.remove('show');
                element.classList.add('hide');

                setTimeout(() => {
                    if (element.parentNode) {
                        element.parentNode.removeChild(element);
                    }
                    this.toasts.delete(toastId);
                }, 300);
            }

            success(title, message, duration = 5000) {
                return this.show('success', title, message, duration);
            }

            error(title, message, duration = 7000) {
                return this.show('error', title, message, duration);
            }

            warning(title, message, duration = 6000) {
                return this.show('warning', title, message, duration);
            }

            info(title, message, duration = 5000) {
                return this.show('info', title, message, duration);
            }

            escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        }

        const toast = new ToastManager();
        window.toast = toast;

        document.addEventListener('DOMContentLoaded', function() {
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                    const messages = [
                        {% for category, message in messages %}
                        {
                            type: '{{ category|lower }}',
                            title: '{{ category|title }}',
                            message: {{ message|tojson }}
                        }{% if not loop.last %},{% endif %}
                        {% endfor %}
                    ];

                    messages.forEach((msg, index) => {
                        setTimeout(() => {
                            const type = ['success', 'error', 'danger', 'warning', 'info'].includes(msg.type) ? msg.type : 'info';
                            toast.show(type, msg.title, msg.message);
                        }, index * 150);
                    });
                {% endif %}
            {% endwith %}

            const sidebarToggle = document.querySelector('.sidebar-toggle');
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.sidebar-overlay');

            if (sidebarToggle && sidebar && overlay) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                    overlay.classList.toggle('visible');
                });

                overlay.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('visible');
                });
            }

            window.addEventListener('resize', function() {
                if (window.innerWidth > 768) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('visible');
                }
            });
        });
    </script>

    <script src="{{ url_for('static', filename='js/script.js') }}"></script>
    {% block extra_js %}{% endblock %}
</body>
</html>
                }